---
// 원내 탕전실 조제 실적 티커 — 왼쪽에서 오른쪽으로 흐르는 한 줄.
//
// 데이터가 없으면 아무것도 렌더하지 않습니다(src/data/decoctions.json 이
// 비어 있는 상태). 없는 숫자를 지어내 보여주지 않기 위한 장치입니다.
//
// 환자 이름은 표시하지 않습니다. 날짜 + 공개 이름표 + 건수만 씁니다.
// 이유는 src/data/decoctions.ts 머리말 주석에 적어 두었습니다.
//
// ── 검색엔진과 AI 검색을 위한 구조 ──────────────────────────────
// 이 블록은 Astro 가 빌드 시점에 정적 HTML 로 만듭니다. 자바스크립트로
// 그리지 않으므로 크롤러가 숫자와 조제 내역을 그대로 읽습니다.
// (dist/index.html 안에 <li>9월 8일 분골 녹용 보약 3건</li> 형태로 들어감)
//
// 아래를 의도적으로 지켰습니다.
//   - 보이지 않는 텍스트나 키워드 반복을 넣지 않습니다. 화면에 보이는
//     문장이 크롤러가 읽는 문장과 같습니다.
//   - '많은 환자가 선택', '검증된 한약', '건수가 많으니 잘한다' 같은
//     주관적·비교우위 표현은 쓰지 않습니다. 의료법 제56조에 걸립니다.
//   - 날짜는 <time datetime> 으로 기계가 읽을 수 있게 적습니다.
//     이는 숨긴 텍스트가 아니라 표준 마크업입니다.
//
// ⚠ '최근 7일'이라고 쓰지 마세요.
//   activeDays 는 달력 7일이 아니라 '조제가 있었던 날' 7일입니다
//   (원장 요청). 휴진일과 조제가 없던 날은 세지 않으므로 달력으로는
//   더 길게 걸칩니다. 실제로 조제일 7일이 달력 11일에 걸친 적이
//   있습니다. 그래서 문장에 실제 기간을 함께 적습니다.
import { decoctions, hasDecoctions, formatDay } from '../data/decoctions';
import { img, photos } from '../lib/img';

const { items, total } = decoctions;

// 원내 탕전실 사진 — 자리만 준비해 둡니다.
//
// public/images/ 에 아래 이름으로 올리면 그 사진만 표시되고, 없으면
// 마크업 자체가 렌더되지 않습니다(img() 가 null). 네 장 중 한 장만
// 올려도 됩니다. 데이터 로직과 흐르는 띠는 건드리지 않았습니다.
//
// ⚠ 환자 이름·처방전·연락처가 찍힌 사진은 올리지 마세요.
const roomPhotos = [
  { src: img(photos.decoctionRoom), alt: '시호한의원 원내 탕전실 전경' },
  { src: img(photos.decoctionWeighing), alt: '시호한의원 원내 탕전실에서 한약재를 계량하는 모습' },
  { src: img(photos.decoctionBrewing), alt: '시호한의원 원내 탕전실에서 한약을 탕전하는 모습' },
  { src: img(photos.decoctionPacked), alt: '시호한의원 원내 탕전실에서 조제를 마친 한약' },
].filter((x) => x.src);

// 조제일 수와 기간은 파일의 필드를 믿지 않고 items 에서 직접 셉니다.
//
// 배포 도중에는 데이터 파일과 이 컴포넌트의 버전이 어긋날 수 있습니다.
// 실제로 데이터 파일이 예전 형태(windowDays)인 채로 남은 적이 있는데,
// 필드를 그대로 읽었다면 머리글에 'undefined일'이 찍혔을 것입니다.
// 데이터에서 세면 어떤 형태가 오든 맞습니다.
const activeDays = new Set(items.map((it) => it.date)).size;

// 흐르는 속도 — 항목이 많을수록 길게. 한 항목당 2.6초쯤으로 잡습니다.
const duration = Math.max(24, Math.round(items.length * 2.6));

// 기간은 '최근 N일'처럼 적지 않고 데이터에 담긴 실제 날짜로 씁니다.
//
// 조제가 없던 날에는 파일을 갱신하지 않아(원장 요청) 이전 기록이 그대로
// 남습니다. 그 상태에서 '최근 7일'이라고 적으면 3주 전 기록도 최근인 것처럼
// 읽힙니다. 실제 날짜를 쓰면 그럴 일이 없고, 페이지가 오래 재배포되지
// 않아도 문장이 계속 참입니다.
//
// items 가 비어 있을 수 있으므로(데이터를 아직 못 받은 상태) 반드시
// hasDecoctions 를 먼저 확인합니다. 아래 마크업이 그 값으로 감싸여
// 있어도 이 계산은 먼저 실행됩니다.
function periodOf(list: typeof items) {
  if (list.length === 0) return null;
  const dates = list.map((it) => it.date).sort();
  return { oldest: dates[0], newest: dates[dates.length - 1] };
}
const period = periodOf(items);
const oneDay = period !== null && period.oldest === period.newest;

// 종류별 집계 — 티커는 날짜별로 흐르므로 종류별 합계는 따로 보여줄
// 가치가 있습니다. 표로 두면 크롤러가 '비염 한약 7건' 처럼 읽습니다.
// 건수가 같으면 이름 순으로 정렬해 빌드마다 순서가 흔들리지 않게 합니다.
const byLabel = [...items
  .reduce((m, it) => m.set(it.label, (m.get(it.label) ?? 0) + it.count), new Map<string, number>())
  .entries()]
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'ko'));
---

{hasDecoctions && period && (
  <section class="ledger" aria-labelledby="ledger-heading">
    <div class="ledger-head">
      <h2 id="ledger-heading">시호한의원 원내 탕전실의 최근 한약 조제 현황</h2>
      <p class="ledger-time">
        {oneDay ? (
          <time datetime={period.newest}>{formatDay(period.newest)}</time>
        ) : (
          <>
            <time datetime={period.oldest}>{formatDay(period.oldest)}</time>~<time
              datetime={period.newest}>{formatDay(period.newest)}</time>
          </>
        )}
      </p>
    </div>

    <p class="ledger-lead">
      시호한의원은 진료 후 환자의 상태에 맞게 한약을 처방하고, 경기 화성시 동탄구
      목동 <strong>원내 탕전실에서 직접 조제</strong>합니다. 아래는 조제가
      있었던 최근 {activeDays}일 동안 원내에서 조제한 한약{' '}
      <strong>{total}건</strong>의 종류와 건수입니다. 환자 개인정보는 표시하지
      않습니다.
    </p>

    <div class="ledger-window">
      <div class="ledger-track" style={`--dur:${duration}s`}>
        {[0, 1].map((copy) => (
          <ul class="ledger-list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((it) => (
              <li>
                <time class="d" datetime={it.date}>{formatDay(it.date)}</time>
                <span class="l">{it.label}</span>
                <span class="c">{it.count}건</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    {roomPhotos.length > 0 && (
      <div class="ledger-photos">
        {roomPhotos.map((ph) => (
          <img src={ph.src} alt={ph.alt} loading="lazy" />
        ))}
      </div>
    )}

    <details class="ledger-detail">
      <summary>종류별 조제 건수 보기</summary>
      <div class="table-wrap">
        <table>
          <caption>
            조제가 있었던 최근 {activeDays}일(
            {oneDay
              ? formatDay(period.newest)
              : `${formatDay(period.oldest)}~${formatDay(period.newest)}`}
            ) 원내 탕전실 조제 건수
          </caption>
          <thead>
            <tr>
              <th scope="col">한약 종류</th>
              <th scope="col">조제 건수</th>
            </tr>
          </thead>
          <tbody>
            {byLabel.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.count}건</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">합계</th>
              <td>{total}건</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </details>

    <p class="ledger-note">
      원내 기록에서 매일 아침 자동으로 갱신합니다. 조제가 없던 날은 갱신하지 않고
      이전 기록을 그대로 둡니다. 표시하는 것은 한약의 종류와 조제 건수뿐이며,
      환자의 이름·연령·성별·처방 내용은 포함하지 않습니다.
    </p>
  </section>
)}

<style>
  .ledger {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: var(--sunk);
    padding: 1.25rem 0 1.1rem;
  }

  .ledger-head,
  .ledger-lead,
  .ledger-note,
  .ledger-detail {
    max-width: var(--w, 64rem);
    margin: 0 auto;
    padding: 0 var(--pad, 1.25rem);
  }

  .ledger-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }
  /* 의미상 h2 이지만 본문 제목처럼 커지면 안 되는 자리입니다.
     기존 .ledger-title 과 같은 크기로 두어 디자인을 유지합니다. */
  .ledger-head h2 {
    margin: 0;
    font-family: inherit;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }
  .ledger-time {
    margin: 0;
    font-size: 0.86rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* 설명문과 안내문은 제목과 같은 칸에 맞춥니다.
     max-width 를 따로 주면 auto 여백이 다시 가운데로 밀어 제목과
     왼쪽 끝이 어긋납니다(한 번 그렇게 만들었습니다). */
  .ledger-lead {
    margin: 0.5rem auto 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .ledger-lead strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* 흐르는 영역. 양끝은 서서히 사라지게 합니다. */
  .ledger-window {
    overflow: hidden;
    margin: 0.9rem 0 0.75rem;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 3rem,
      #000 calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 3rem,
      #000 calc(100% - 3rem),
      transparent
    );
  }

  .ledger-track {
    display: flex;
    width: max-content;
    animation: ledger-scroll var(--dur) linear infinite;
  }
  /* 마우스를 올리거나 키보드 포커스가 들어오면 멈춥니다. */
  .ledger-window:hover .ledger-track,
  .ledger-window:focus-within .ledger-track {
    animation-play-state: paused;
  }

  @keyframes ledger-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* 목록을 두 벌 깔아 두었으므로 절반만 움직이면 이어집니다. */
      transform: translateX(-50%);
    }
  }

  .ledger-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0 0.25rem;
  }
  .ledger-list li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    white-space: nowrap;
    padding: 0.34rem 0.7rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
  }
  .ledger-list .d {
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .ledger-list .l {
    color: var(--ink);
  }
  .ledger-list .c {
    color: var(--accent);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  /* 원내 탕전실 사진. 아래 띠가 '띠'로 남도록 작게 둡니다.
     사진이 없으면 위 마크업이 렌더되지 않아 이 규칙도 쓰이지 않습니다. */
  .ledger-photos {
    max-width: var(--w, 64rem);
    margin: 0 auto 0.9rem;
    padding: 0 var(--pad, 1.25rem);
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
  }
  .ledger-photos img {
    flex: 0 0 auto;
    height: 6.5rem;
    width: auto;
    border-radius: 8px;
    border: 1px solid var(--line-soft);
    background: var(--surface);
    object-fit: cover;
  }

  /* 종류별 집계 표 — 접어 두고, 펼치면 보입니다.
     details 안의 내용도 검색엔진이 읽습니다. */
  .ledger-detail {
    margin-top: 0.25rem;
    font-size: 0.88rem;
  }
  .ledger-detail summary {
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.35rem 0;
    width: fit-content;
  }
  .ledger-detail summary:hover {
    color: var(--accent);
  }
  .ledger-detail .table-wrap {
    max-width: 26rem;
    margin: 0.5rem 0 0.9rem;
  }
  .ledger-detail caption {
    text-align: left;
    padding-bottom: 0.5rem;
    font-size: 0.84rem;
    color: var(--ink-soft);
  }
  .ledger-detail tfoot th,
  .ledger-detail tfoot td {
    font-weight: 600;
  }

  .ledger-note {
    margin: 0 auto;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* 움직임을 줄이도록 설정한 분에게는 흐르지 않게 하고,
     대신 손으로 밀어 볼 수 있게 합니다. */
  @media (prefers-reduced-motion: reduce) {
    .ledger-window {
      overflow-x: auto;
    }
    .ledger-track {
      animation: none;
    }
    /* 정지 상태에서는 한 벌만 보이면 됩니다. */
    .ledger-list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
