---
// 화면 아래에 붙는 띠 배너. 누르면 포스터 전체가 열립니다.
// 내용은 src/data/promo.ts 에서 관리합니다.
//
// 페이지를 가리지 않도록 모달로 먼저 띄우지 않습니다. 모바일에서 본문을
// 덮는 팝업은 검색 순위에 불리하게 작용할 수 있어, 포스터는 방문자가
// 배너를 눌렀을 때만 엽니다.
import { promo } from '../data/promo';
import { img } from '../lib/img';

// 빌드 시점 기준(한국 시간)으로 기간이 끝났으면 마크업 자체를 넣지 않습니다.
const todayKst = new Date(Date.now() + 9 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);

const src = promo ? img(promo.image) : null;
const show = promo && src && todayKst <= promo.end;
---
{show && promo && src && (
  <div id="promo" data-id={promo.id} data-start={promo.start} data-end={promo.end} hidden>
    <aside class="promo-bar" aria-label={promo.title}>
      <button type="button" class="promo-open" aria-haspopup="dialog">
        <img class="promo-thumb" src={src} alt="" width="1060" height="1502" />
        <span class="promo-text">
          <strong>{promo.title}</strong>
          <small>{promo.note}</small>
        </span>
        <span class="promo-cta" aria-hidden="true">포스터 보기</span>
      </button>
      <button type="button" class="promo-close" data-hide aria-label="배너 닫기 (오늘 하루 보지 않기)">
        <span aria-hidden="true">✕</span>
      </button>
    </aside>

    <div class="promo-sheet" role="dialog" aria-modal="true" aria-label={promo.title} hidden>
      <div class="promo-backdrop" data-sheet-close></div>
      <div class="promo-panel">
        <div class="promo-figure">
          <img src={src} alt={promo.imageAlt} width="1060" height="1502" />
          {promo.more && (
            <p class="promo-more"><a href={promo.more.href}>{promo.more.label}</a></p>
          )}
        </div>
        <div class="promo-panel-actions">
          <button type="button" data-hide>오늘 하루 보지 않기</button>
          <button type="button" data-sheet-close class="promo-x">닫기</button>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  /* ── 아래 띠 배너 ─────────────────────────────────────── */
  .promo-bar {
    position: fixed;
    z-index: 90;
    inset: auto 0 0 0;
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 0.5rem calc(max(0px, 50% - var(--w) / 2) + var(--pad) - 0.25rem);
    background: var(--surface);
    border-top: 1px solid var(--line);
    box-shadow: 0 -6px 24px rgb(20 26 22 / 0.1);
  }
  .promo-bar[hidden] { display: none; }

  .promo-open {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.35rem 0.25rem;
    font: inherit;
    text-align: left;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .promo-thumb {
    flex-shrink: 0;
    width: 2.1rem;
    height: 3rem;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--line-soft);
  }
  .promo-text { min-width: 0; }
  .promo-text strong {
    display: block;
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.3;
  }
  .promo-text small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    /* 좁은 화면에서 두 줄로 늘어나지 않도록 자릅니다. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .promo-cta {
    flex-shrink: 0;
    margin-left: auto;
    padding: 0.4rem 0.8rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent-ink);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .promo-open:hover .promo-cta { background: var(--sunk); }

  .promo-close {
    flex-shrink: 0;
    width: 2.6rem;
    margin-left: 0.25rem;
    font-size: 1rem;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-left: 1px solid var(--line-soft);
    cursor: pointer;
  }
  .promo-close:hover { color: var(--ink); }

  .promo-open:focus-visible,
  .promo-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* 좁은 화면에서는 부가 설명을 접고 제목과 '포스터 보기'만 남깁니다.
     (기간은 포스터 안에 있고, 누를 수 있다는 표시가 더 중요합니다) */
  @media (max-width: 30rem) {
    .promo-text small { display: none; }
    .promo-text strong { font-size: 0.95rem; white-space: nowrap; }
    .promo-thumb { width: 1.9rem; height: 2.7rem; }
    .promo-cta { padding: 0.35rem 0.7rem; font-size: 0.85rem; }
    .promo-close { width: 2.2rem; }
  }

  /* ── 배너를 누르면 열리는 포스터 ──────────────────────── */
  .promo-sheet {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  /* display를 지정하면 hidden 속성의 기본 display:none 이 무효가 됩니다. */
  .promo-sheet[hidden] { display: none; }

  .promo-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(20 26 22 / 0.55);
  }
  .promo-panel {
    position: relative;
    width: 100%;
    max-width: 26rem;
    max-height: calc(100dvh - 2rem);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 50px rgb(20 26 22 / 0.28);
  }
  .promo-figure {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .promo-figure img { display: block; width: 100%; height: auto; }
  .promo-more {
    margin: 0;
    padding: 0.9rem 1.1rem;
    font-size: 0.94rem;
    border-top: 1px solid var(--line-soft);
  }
  .promo-panel-actions {
    display: flex;
    flex-shrink: 0;
    border-top: 1px solid var(--line);
  }
  .promo-panel-actions button {
    flex: 1;
    padding: 0.85rem 0.5rem;
    font: inherit;
    font-size: 0.92rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 0;
    cursor: pointer;
  }
  .promo-panel-actions button:hover { background: var(--sunk); }
  .promo-panel-actions button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .promo-x {
    border-left: 1px solid var(--line) !important;
    font-weight: 700;
    color: var(--ink) !important;
  }

  /* 띠 배너가 본문 마지막 줄을 가리지 않도록 아래 여백을 둡니다. */
  :global(body.has-promo) { padding-bottom: 4.6rem; }
</style>

<script>
  (() => {
    const root = document.getElementById('promo');
    if (!root) return;

    const bar = root.querySelector<HTMLElement>('.promo-bar');
    const sheet = root.querySelector<HTMLElement>('.promo-sheet');
    if (!bar || !sheet) return;

    const key = `promo:${root.dataset.id ?? ''}`;
    // 로컬 시간 기준 YYYY-MM-DD. 방문 시점에 기간을 다시 확인합니다.
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    if (today < (root.dataset.start ?? '') || today > (root.dataset.end ?? '')) return;

    // 저장소를 못 쓰는 환경(사생활 보호 모드 등)에서도 배너는 정상 동작해야 합니다.
    const read = () => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (v: string) => {
      try {
        localStorage.setItem(key, v);
      } catch {
        /* 저장하지 못해도 이번 방문에서는 닫힙니다 */
      }
    };

    if (read() === today) return;

    let opener: HTMLElement | null = null;

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeSheet();
    };

    function openSheet() {
      opener = document.activeElement as HTMLElement | null;
      sheet!.hidden = false;
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      sheet!.querySelector<HTMLButtonElement>('.promo-x')?.focus();
    }

    function closeSheet() {
      sheet!.hidden = true;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      opener?.focus?.();
    }

    // 배너와 포스터를 함께 내리고, 오늘은 다시 띄우지 않습니다.
    function hideAll() {
      write(today);
      closeSheet();
      root!.hidden = true;
      document.body.classList.remove('has-promo');
    }

    root.querySelector('.promo-open')?.addEventListener('click', openSheet);
    sheet
      .querySelectorAll('[data-sheet-close]')
      .forEach((b) => b.addEventListener('click', () => closeSheet()));
    root
      .querySelectorAll('[data-hide]')
      .forEach((b) => b.addEventListener('click', hideAll));
    // 포스터의 안내 링크로 이동할 때는 오늘 다시 띄우지 않습니다.
    sheet
      .querySelector('.promo-more a')
      ?.addEventListener('click', () => write(today));

    root.hidden = false;
    document.body.classList.add('has-promo');
  })();
</script>
