---
// 홈에서 한 번 열리는 안내 팝업. 내용은 src/data/promo.ts 에서 관리합니다.
import { promo } from '../data/promo';
import { img } from '../lib/img';

// 빌드 시점 기준(한국 시간)으로 기간이 끝났으면 마크업 자체를 넣지 않습니다.
const todayKst = new Date(Date.now() + 9 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);

const src = promo ? img(promo.image) : null;
const show = promo && src && todayKst <= promo.end;
---
{show && promo && src && (
  <div
    class="promo"
    id="promo"
    data-id={promo.id}
    data-start={promo.start}
    data-end={promo.end}
    role="dialog"
    aria-modal="true"
    aria-label={promo.title}
    hidden
  >
    <div class="promo-backdrop" data-close></div>
    <div class="promo-panel">
      {promo.href ? (
        <a href={promo.href} class="promo-figure">
          <img src={src} alt={promo.title} width="1060" height="1502" />
        </a>
      ) : (
        <span class="promo-figure">
          <img src={src} alt={promo.title} width="1060" height="1502" />
        </span>
      )}
      <div class="promo-actions">
        <button type="button" data-close-today>오늘 하루 보지 않기</button>
        <button type="button" data-close class="promo-x" aria-label="팝업 닫기">
          닫기
        </button>
      </div>
    </div>
  </div>
)}

<style>
  .promo {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  /* display를 지정하면 hidden 속성의 기본 display:none 이 무효가 됩니다. */
  .promo[hidden] { display: none; }
  .promo-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(20 26 22 / 0.55);
    border: 0;
  }
  .promo-panel {
    position: relative;
    width: 100%;
    max-width: 26rem;
    max-height: calc(100dvh - 2rem);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 50px rgb(20 26 22 / 0.28);
  }
  .promo-figure {
    display: block;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .promo-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .promo-actions {
    display: flex;
    flex-shrink: 0;
    border-top: 1px solid var(--line-soft);
  }
  .promo-actions button {
    flex: 1;
    padding: 0.85rem 0.5rem;
    font: inherit;
    font-size: 0.92rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 0;
    cursor: pointer;
  }
  .promo-actions button:hover { background: var(--sunk); }
  .promo-actions button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .promo-x {
    border-left: 1px solid var(--line-soft) !important;
    font-weight: 700;
    color: var(--ink) !important;
  }

  /* 화면이 낮으면(가로 모드 등) 이미지 영역이 스크롤되도록 둡니다. */
  @media (max-height: 34rem) {
    .promo-panel { max-width: 20rem; }
  }
</style>

<script>
  (() => {
    const el = document.getElementById('promo');
    if (!el) return;

    const id = el.dataset.id ?? '';
    const key = `promo:${id}`;
    // 로컬 시간 기준 YYYY-MM-DD. 방문 시점에 기간을 다시 확인합니다.
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    if (today < (el.dataset.start ?? '') || today > (el.dataset.end ?? '')) return;

    // 저장소를 못 쓰는 환경(사생활 보호 모드 등)에서도 팝업은 정상 동작해야 합니다.
    const read = () => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (v: string) => {
      try {
        localStorage.setItem(key, v);
      } catch {
        /* 저장하지 못해도 이번 방문에서는 닫힙니다 */
      }
    };

    if (read() === today) return;

    const opener = document.activeElement as HTMLElement | null;
    const scrollLocked = document.body.style.overflow;

    const close = (rememberToday = false) => {
      if (rememberToday) write(today);
      el.hidden = true;
      document.body.style.overflow = scrollLocked;
      document.removeEventListener('keydown', onKey);
      opener?.focus?.();
    };

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
    }

    el.querySelectorAll('[data-close]').forEach((b) =>
      b.addEventListener('click', () => close())
    );
    el.querySelector('[data-close-today]')?.addEventListener('click', () =>
      close(true)
    );
    // 팝업을 눌러 이동할 때는 다시 뜨지 않도록 오늘 날짜를 기억합니다.
    el.querySelector('.promo-figure[href]')?.addEventListener('click', () =>
      write(today)
    );

    el.hidden = false;
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', onKey);
    el.querySelector<HTMLButtonElement>('.promo-x')?.focus();
  })();
</script>
