---
// 원내 사진 — 파일이 있는 것만 보여줍니다.
//
// public/images/ 에 파일이 없으면 아무것도 렌더하지 않습니다. 사진을
// 나중에 올려도 되도록 만든 기존 img() 방식을 그대로 씁니다.
//
// 왜 컴포넌트로 뺐나
//   사진 한 장을 감싸는 figure 와 그 CSS 를 페이지마다 복사해 넣고
//   있었습니다(월경통·보폐고). 여기에 넣어 한 곳에서 관리합니다.
//
// ⚠ 환자가 찍힌 사진, 이름·처방전·연락처가 보이는 사진은 올리지
//    마세요. 의료법 제19조(비밀 누설 금지), 개인정보보호법 제23조.
import { img } from '../lib/img';

interface Item {
  /** photos 의 값(확장자 없는 파일 이름) */
  name: string;
  /** 사진에 무엇이 있는지. 검색엔진과 화면 낭독기가 읽습니다 */
  alt: string;
}
interface Props {
  items: Item[];
  /** 사진 아래 설명. 넣지 않아도 됩니다 */
  caption?: string;
}
const { items, caption } = Astro.props;

const shown = items
  .map((it) => ({ ...it, src: img(it.name) }))
  .filter((it) => it.src);
const many = shown.length > 1;
// 열 수는 사진 수에 맞춥니다. 두 장인데 3열이면 오른쪽 한 칸이 비어
// 어색합니다. 넓은 화면에서 최대 3열까지만 씁니다.
const cols = Math.min(shown.length, 3);
---

{shown.length > 0 && (
  <figure class={many ? 'shots grid' : 'shots'} style={many ? `--cols:${cols}` : undefined}>
    {shown.map((s) => <img src={s.src} alt={s.alt} loading="lazy" />)}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
  .shots {
    margin: 1.75rem 0 0;
  }
  .shots img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: var(--sunk);
  }
  /* 한 장이면 본문 폭에 맞춰 원래 비율로 보여줍니다. */
  .shots:not(.grid) {
    max-width: 34rem;
  }
  /* 여러 장이면 격자로. 사진의 세로·가로 비율이 섞여 있어
     4:3 으로 잘라 줄을 맞춥니다. */
  .shots.grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .shots.grid img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (min-width: 34rem) {
    .shots.grid {
      grid-template-columns: repeat(min(var(--cols), 2), 1fr);
    }
  }
  @media (min-width: 56rem) {
    .shots.grid {
      grid-template-columns: repeat(var(--cols), 1fr);
    }
  }
  .shots figcaption {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .shots.grid figcaption {
    grid-column: 1 / -1;
  }
</style>
