---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
import { chuppyak } from '../data/chuppyak';
import { insuranceHerbs } from '../data/insurance-herbs';

// 이 페이지는 원래 h1 + 처방 목록(dl) 만 있는 28줄짜리였습니다.
// 다른 페이지와 달리 히어로·요약·질문형 H2·자주 묻는 질문이 없어
// 검색과 AI 검색에서 '보험한약이 무엇인지'를 설명하는 페이지로
// 읽히지 못했습니다. 사이트의 기존 구조(hero / sec / band / cases /
// faq / cta)만 써서 구조를 맞췄습니다. 처방 목록은 그대로입니다.
//
// ⚠ 본문에 쓴 사실의 출처 — 모두 사이트 안에 이미 있는(원장 검수된)
//    내용입니다. 새로 만든 사실은 없습니다.
//   - 보험한약의 성격, 가벼운 증상에 활용, 침·뜸과 함께 처방 가능,
//     본인부담금은 진료 내용과 보험 자격에 따라 달라 내원 시 확인
//     → src/content/faq/insurance-herb-coverage.md
//   - 연조엑스(짜서 먹는 시럽)·과립제 형태, 아이가 복용하기 쉬움
//     → src/pages/pediatrics.astro, src/pages/digestion.astro
//   - 비염에 소청룡탕·형개연교탕·행소탕 → src/pages/rhinitis.astro
//   - 감기 이후 기침·가래에 삼소음 → src/pages/bopyego.astro
//   - 갱년기·여성질환에 가미소요산 → src/pages/menopause.astro
//   - 첩약 급여 6개 질환과 본인부담 → src/data/chuppyak.ts
//
// ⚠ 보험한약의 금액은 적지 않습니다. 진료 내용과 보험 자격에 따라
//    달라져 단정할 수 없습니다(위 자주 묻는 질문의 원장 문구).
//    처방 일수 제한도 확인 전이라 적지 않았습니다.

const title = '동탄 보험한약 | 건강보험 적용 한약 목록';
const description =
  '동탄 시호한의원에서 처방하는 보험한약(한약제제) 목록과 각 처방의 쓰임. 건강보험이 적용되며 침·뜸 치료와 함께 받으실 수 있습니다.';

// 첫 화면 요약. AI가 페이지 주제를 한눈에 잡을 수 있도록 사실만 짧게 적습니다.
const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '건강보험이 적용되는 한약제제(보험한약)를 처방합니다',
  `아래 ${insuranceHerbs.length}종은 처방하는 보험한약의 일부 예시입니다`,
  '짜서 먹는 시럽(연조엑스)과 과립제 형태가 있습니다',
  '침 · 뜸 등 다른 건강보험 진료와 함께 처방받으실 수 있습니다',
];

// 어떤 증상으로 상담하시는지. 처방 이름은 사이트의 다른 페이지에서
// 이미 밝힌 것만 적고, 새로 분류를 만들지 않았습니다.
const uses = [
  {
    t: '비염 · 코막힘',
    d: '맑은 콧물과 재채기, 누런 콧물, 코막힘의 양상에 따라 소청룡탕·형개연교탕·행소탕 등을 고려합니다.',
    href: '/rhinitis/',
    label: '비염 진료 안내',
  },
  {
    t: '감기 이후 남은 기침 · 가래',
    d: '감기가 지난 뒤에도 기침이나 가래가 남는 경우에 삼소음 등을 고려합니다.',
    href: '/bopyego/',
    label: '보폐고 · 호흡기 한약 안내',
  },
  {
    t: '소화불량 · 속쓰림 · 장염',
    d: '식체, 속쓰림, 복통처럼 소화기 증상에 맞추어 처방합니다. 짜서 먹는 시럽 형태도 있습니다.',
    href: '/digestion/',
    label: '속편안 클리닉 · 소화 진료 안내',
  },
  {
    t: '갱년기 · 여성질환',
    d: '갱년기 증후군을 포함한 여성질환에 사용하는 보험한약이 있습니다. 가미소요산이 그중 하나입니다.',
    href: '/menopause/',
    label: '갱년기 클리닉 안내',
  },
  {
    t: '목 · 어깨 통증과 감기 초기',
    d: '뒷목이 뻐근한 통증과 오한·몸살이 함께 있는 감기 초기 증상에 사용하는 처방이 있습니다.',
    href: '/pain/',
    label: '관절 · 근육 통증 진료 안내',
  },
  {
    t: '아이의 감기 · 비염 · 소화',
    d: '짜서 먹는 시럽 형태의 연조엑스가 있어 아이가 복용하기 쉽습니다.',
    href: '/pediatrics/',
    label: '소아 한방 진료 안내',
  },
];

const faqs = [
  {
    q: '한의원에서 한약도 건강보험이 되나요?',
    a: [
      '네. 두 가지가 있습니다. 하나는 이미 만들어진 한약제제인 보험한약이고, 다른 하나는 약재를 개별로 구성해 달인 맞춤 한약(첩약)입니다.',
      '보험한약은 감기, 비염, 소화불량, 장염, 월경 전후의 불편감처럼 비교적 가벼운 증상에 진찰 후 활용합니다. 맞춤 한약은 여섯 개 질환에 한해 건강보험이 적용됩니다.',
    ],
  },
  {
    q: '보험한약은 어떤 형태로 나오나요?',
    a: [
      '짜서 먹는 시럽 형태의 연조엑스와, 물에 타 먹는 과립제가 있습니다.',
      '탕약처럼 데우거나 따로 챙길 필요가 없어 학교나 직장에서도 복용하기 수월합니다. 어느 형태로 드릴지는 처방과 복용 상황에 맞추어 안내합니다.',
    ],
  },
  {
    q: '비용은 얼마인가요?',
    a: [
      '건강보험이 적용되어 부담이 크지 않습니다.',
      '다만 정확한 본인부담금은 진료 내용과 보험 자격 등에 따라 달라질 수 있어 미리 단정해 말씀드리기 어렵습니다. 내원하시면 확인해 드립니다.',
    ],
  },
  {
    q: '침 치료와 함께 받을 수 있나요?',
    a: [
      '네. 침과 뜸 등 다른 건강보험 진료와 함께 처방받으실 수 있습니다.',
      '무엇을 함께 진행할지는 진찰 후 정합니다.',
    ],
  },
  {
    q: '아이도 복용할 수 있나요?',
    a: [
      '네. 짜서 먹는 시럽 형태의 연조엑스가 있어 아이가 복용하기 쉽습니다.',
      '아이의 경우 코 상태와 함께 수면, 소화, 잦은 감기 여부를 같이 확인한 뒤 처방합니다. 복용 방식도 아이가 먹기 쉽도록 조정합니다.',
    ],
  },
  {
    q: '아래 목록에 없는 한약을 처방받았는데요?',
    a: [
      '아래는 처방하는 보험한약의 일부 예시입니다. 건강보험이 적용되는 한약제제는 이보다 많습니다.',
      '증상명에 맞춰 같은 약을 드리기보다, 현재 나타나는 증상과 평소 몸 상태를 함께 살펴 적합한 처방을 선택합니다. 그래서 목록과 다른 처방이 나갈 수 있습니다.',
    ],
  },
  {
    q: '맞춤 한약(첩약)과는 무엇이 다른가요?',
    a: [
      '보험한약은 이미 만들어진 한약제제를 증상에 맞추어 처방하는 방식이고, 맞춤 한약은 약재의 종류와 용량을 개별로 구성해 달이는 방식입니다.',
      '맞춤 한약은 원내 탕전실에서 직접 조제합니다. 여섯 개 질환에 한해 건강보험이 적용되며, 적용 질환과 본인부담은 첩약 건강보험 안내에 정리해 두었습니다.',
      '어느 쪽이 지금 맞는지는 증상의 정도와 경과에 따라 다릅니다. 진찰 후 말씀드립니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">한약 · 보험한약</p>
    <h1>동탄 보험한약, 건강보험으로 처방받는 한약입니다</h1>
    <p class="lead">
      한의원에서 처방하는 한약 중에는 건강보험이 적용되는 한약도 있습니다.
    </p>
    <p>
      시호한의원은 경기 화성시 동탄구 목동에서 건강보험이 적용되는
      한약제제(보험한약)를 처방합니다. 증상명에 맞춰 같은 약을 드리기보다,
      지금 나타나는 증상과 평소 몸 상태를 함께 살펴 처방을 정합니다.
    </p>
    <ul class="hero-summary">{summary.map((x) => <li>{x}</li>)}</ul>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>한약 상담하기</a>
      <a class="cta ghost" href="/chuppyak/">첩약 건강보험 안내</a>
    </p>
  </section>

  <section class="sec band">
    <h2>보험한약이란 무엇인가요?</h2>
    <p>
      보험한약은 <strong>이미 만들어진 한약제제</strong>를 증상에 맞추어
      처방하는 것입니다. 건강보험이 적용되어 부담이 크지 않고, 침과 뜸 등 다른
      건강보험 진료와 함께 처방받으실 수 있습니다.
    </p>
    <p>
      감기, 비염, 소화불량, 장염, 월경 전후의 불편감처럼 비교적 가벼운 증상에
      진찰 후 활용합니다. 증상이 오래되었거나 여러 문제가 겹쳐 있는 경우에는
      약재를 개별로 구성해 달이는 맞춤 한약이 더 맞는 경우도 있습니다.
    </p>
    <p class="statement">
      같은 증상이라도 몸 상태가 다르면 처방이 달라집니다. 그래서 이름보다 진찰이
      먼저입니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 형태로 복용하나요?</h2>
    <ul class="cases">
      <li>
        <strong>연조엑스</strong> — 짜서 먹는 시럽 형태입니다. 아이가 복용하기
        쉬워 소아 진료에서 자주 사용합니다
      </li>
      <li>
        <strong>과립제</strong> — 물에 타 먹는 형태입니다
      </li>
    </ul>
    <p>
      탕약처럼 데우거나 따로 챙길 필요가 없어 학교나 직장에서도 복용을
      이어가기 어렵지 않습니다. 어느 형태로 드릴지는 처방과 복용 상황에 맞추어
      안내합니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 증상으로 상담하시나요?</h2>
    <p>
      아래는 보험한약으로 상담하시는 경우입니다. 각 진료에 관한 내용은 해당
      안내에 정리해 두었습니다.
    </p>
    <div class="cards">
      {uses.map((u) => (
        <div class="card">
          <strong>{u.t}</strong>
          <span>{u.d}</span>
          <a href={u.href}>{u.label}</a>
        </div>
      ))}
    </div>
    <p class="note">
      특정 증상에 특정 처방이 정해져 있다는 뜻은 아닙니다. 실제 처방은 진찰 후
      결정됩니다.
    </p>
  </section>

  <section class="sec band">
    <h2>맞춤 한약(첩약)과는 어떻게 다른가요?</h2>
    <p>
      보험한약은 이미 만들어진 한약제제를 쓰고, 맞춤 한약은 약재의 종류와 용량을
      개별로 구성해 달입니다. 시호한의원은 맞춤 한약을 원내 탕전실에서 직접
      조제합니다.
    </p>
    <p>
      맞춤 한약은 <strong>여섯 개 질환</strong>에 한해 건강보험이 적용됩니다.
      알레르기비염, 기능성 소화불량, 월경통, 요추추간판탈출증, 안면신경마비,
      뇌혈관질환 후유증입니다. {chuppyak.amount} 기준 본인부담은 약{' '}
      {chuppyak.patientPay}입니다.
    </p>
    <p class="note">
      적용 질환과 급여 기준, 본인부담은{' '}
      <a href="/chuppyak/">첩약 건강보험 안내</a>에 정리해 두었습니다. 학생의
      한약은 <a href="/student-care/herbal-medicine/">수험생 보약 안내</a>에,
      건강보험이 적용되지 않는 비급여 한약은{' '}
      <a href="/gongjindan/">공진단 · 경옥고</a>와{' '}
      <a href="/bopyego/">보폐고</a> 안내에 있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>시호한의원에서 처방하는 보험한약</h2>
    <p>
      아래 {insuranceHerbs.length}종은 보험 적용이 가능한 한약의 일부
      예시입니다. 원장의 진찰을 통해 환자분의 증상과 체질에 맞는, 아래와 다른
      한약이 처방될 수도 있습니다.
    </p>
    <dl class="herbs">
      {insuranceHerbs.map((h) => (
        <>
          <dt>{h.name}</dt>
          <dd>{h.uses}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="sec">
    <h2>보험한약 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 경기 화성시 동탄구 목동, 동탄신리천로 407 동탄리더스타워 2층에
      있습니다. 지금 증상에 보험한약이 맞는지, 맞춤 한약이 필요한지는 진찰 후
      말씀드립니다. {clinic.firstVisitNote} 수요일은 21:00까지 야간진료를
      운영합니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>한약 상담하기</a>
    </p>
    <p class="cta-sub">
      전화 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a> · <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
    </p>
  </section>
</Base>
