---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';

const title = '동탄 교통사고 한방치료 | 자동차보험 진료 안내';
const description =
  '동탄 시호한의원 교통사고 진료 안내. 자동차보험 접수 방법과 진료 항목, 평일 야간까지 이어지는 통원 진료를 안내합니다.';

// 원장 검수 완료. 운영 정보(입원실 미운영·통원 진료, 사고접수번호 확인 후 보험사
// 연락은 원내 진행, 원내탕전 한약 처방, 진단서·통원확인서 발급)는 원장 확인 사항입니다.
// 김은미 대표원장은 보건복지부 발급 한방내과 전문의입니다(원장 확인).
const faqs = [
  {
    q: '자동차보험 접수는 제가 직접 해야 하나요?',
    a: [
      '사고 접수는 보험사에 직접 하셔야 하고, 한의원에서 대신 접수해 드리지는 않습니다.',
      '다만 사고접수번호만 알려주시면 그 이후 보험사와의 연락은 원내에서 진행합니다. 진료받으시는 동안 번거로운 일이 생기지 않도록 도와드립니다.',
      '아직 번호를 받지 못하셨다면 전화로 문의해 주세요. 어떤 순서로 진행하시면 되는지 안내해 드립니다.',
    ],
  },
  {
    q: '치료비는 얼마나 부담해야 하나요?',
    a: [
      '자동차보험 대인 접수가 되어 있으면 진료비는 보험사로 청구되며, 내원하실 때 따로 진료비를 결제하지 않으셔도 됩니다.',
      '다만 접수 형태나 과실 관계에 따라 달라질 수 있어, 접수 시 어떤 방식으로 처리되는지 확인해 드립니다.',
    ],
  },
  {
    q: '병원 검사에서 이상이 없다고 하는데 계속 아픕니다.',
    a: [
      '영상 검사에서 골절이나 파열 같은 구조적 손상이 확인되지 않아도 통증이 남는 경우가 있습니다.',
      '이런 경우에는 근육과 인대의 긴장, 관절의 움직임 상태 등을 함께 살펴봅니다. 필요하면 초음파로 통증 부위를 확인한 뒤 치료 방향을 정합니다.',
    ],
  },
  {
    q: '다른 병원에 다니면서 한의원 치료를 병행해도 되나요?',
    a: [
      '정형외과 등에서 진료를 받으면서 한의원 진료를 함께 받으시는 경우가 있습니다.',
      '같은 날 두 곳에서 진료받는 것이 가능한지, 보험 처리는 어떻게 되는지는 접수하신 보험사와 확인이 필요할 수 있습니다. 접수 시 함께 안내해 드립니다.',
    ],
  },
  {
    q: '합의한 뒤에도 치료를 받을 수 있나요?',
    a: [
      '합의가 끝나면 해당 사고 건으로는 자동차보험 진료를 이어가기 어렵습니다.',
      '증상이 남아 있다면 합의 전에 상태를 확인해 보시고, 이후에도 관리가 필요하다면 건강보험으로 진료를 이어갈 수 있습니다.',
    ],
  },
  {
    q: '진단서나 통원확인서를 발급받을 수 있나요?',
    a: [
      '네, 발급해 드립니다. 필요한 서류가 있으시면 접수 시 말씀해 주세요.',
      '보험사에서 요청한 서류가 어떤 것인지 알려주시면 그에 맞추어 준비해 드립니다.',
    ],
  },
  {
    q: '입원해야 하나요?',
    a: [
      '시호한의원은 입원실을 운영하지 않고 통원 진료로 진행합니다.',
      '평일은 20:00까지, 수요일은 21:00까지 진료하여 직장에 다니시는 분도 매일 통원하실 수 있습니다. 토요일은 14:00까지 진료하며, 접수 마감은 진료 종료 30분 전입니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];

const steps = [
  {
    t: '보험사에 사고 접수',
    d: '상대 보험사 또는 본인 보험사에 사고를 접수하고 접수번호(사고번호)를 받습니다.',
  },
  {
    t: '한의원 방문 · 접수',
    d: '신분증과 사고접수번호를 알려주시면 접수해 드립니다. 이후 보험사와의 연락은 원내에서 진행합니다.',
  },
  {
    t: '진찰과 검사',
    d: '사고 경위와 통증 부위를 확인하고, 필요하면 초음파로 해당 부위를 살펴봅니다.',
  },
  {
    t: '치료와 경과 확인',
    d: '상태에 맞는 진료 항목을 정해 진행하고, 경과에 따라 치료 방향을 조정합니다.',
  },
];

const care = [
  {
    t: '침 · 뜸 · 부항',
    d: '사고 후 나타나는 근육 긴장과 통증 부위를 중심으로 진행합니다.',
    href: null,
  },
  {
    t: '추나요법',
    d: '목·허리의 움직임과 정렬 상태를 확인하고 손으로 교정하는 치료입니다.',
    href: '/treatments/chuna/',
  },
  {
    t: '약침',
    d: '한약재에서 추출한 약액을 통증 부위에 주입하는 치료입니다.',
    href: '/treatments/yakchim/',
  },
  {
    t: '도침',
    d: '오래 굳은 조직이나 유착이 의심되는 부위에 사용합니다.',
    href: '/treatments/dochim/',
  },
  {
    t: '한약 (원내탕전)',
    d: '진찰 후 개인에 맞게 처방하여 원내 탕전실에서 준비해 드립니다.',
    href: null,
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">교통사고 · 자동차보험</p>
    <h1>동탄 교통사고 한방치료, 자동차보험으로 진료받으실 수 있습니다</h1>
    <p class="lead">
      사고 직후에는 괜찮다가 며칠 뒤부터 목이나 허리가 불편해지는 경우가 있습니다.
      영상 검사에서 특별한 소견이 없더라도 통증이 남을 수 있습니다.
    </p>
    <p>
      시호한의원은 경기 화성시 동탄신리천로 407 동탄리더스타워 2층에 있습니다.
      사고접수번호를 알려주시면 이후 보험사와의 연락은 원내에서 진행하며, 예약 없이
      내원하셔도 진료받으실 수 있습니다. 평일은 20:00까지, 수요일은 21:00까지
      진료하여 퇴근 후에도 통원하실 수 있습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={`tel:${clinic.phone}`}>전화로 문의하기 {clinic.phone}</a>
    </p>
  </section>

  <section class="sec band">
    <h2>교통사고 후 언제 내원해야 하나요?</h2>
    <p>
      불편한 증상이 느껴진다면 되도록 이른 시기에 확인해 보시는 편이 좋습니다.
      사고 당일에는 별다른 증상이 없다가 하루이틀 지나 목·어깨·허리가 뻐근해지는
      경우가 흔합니다.
    </p>
    <p>아래와 같은 증상이 있다면 상태를 한 번 살펴보시길 권해 드립니다.</p>
    <ul class="cases">
      <li>목을 돌리거나 뒤로 젖힐 때 걸리는 느낌이 든다</li>
      <li>허리가 뻐근해 오래 앉아 있거나 서 있기 힘들다</li>
      <li>사고 이후 두통이나 어지럼이 생겼다</li>
      <li>팔이나 다리가 저리다</li>
      <li>잠을 자고 일어나도 개운하지 않고 쉽게 피로해진다</li>
      <li>검사에서는 이상이 없다고 들었는데 통증이 계속된다</li>
    </ul>
  </section>

  <section class="sec">
    <h2>자동차보험 접수는 어떻게 하나요?</h2>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </li>
      ))}
    </ol>
    <p class="note">
      준비물은 <strong>신분증</strong>과 <strong>자동차보험 접수번호</strong>입니다.
      다른 병원에서 받은 검사결과가 있으면 휴대폰으로 찍어 오셔도 좋습니다.
      처음 방문하실 때 준비하실 것은
      <a href="/faq/">자주 묻는 질문</a>에도 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 진료를 받게 되나요?</h2>
    <p>
      사고 후 나타나는 불편은 부위와 양상이 저마다 달라, 진찰을 통해 필요한 진료
      항목을 정합니다. 한약은 목·허리의 통증만이 아니라 사고 이후의 전반적인 컨디션을
      함께 고려하여 처방합니다.
    </p>
    <div class="cards">
      {care.map((c) => (
        <div class="card">
          <strong>{c.t}</strong>
          <span>{c.d}</span>
          {c.href && <a href={c.href}>자세히 보기</a>}
        </div>
      ))}
    </div>
    <p>
      진료 항목 전반은 <a href="/treatments/">진료 안내</a>에, 추나요법은
      <a href="/treatments/chuna/">추나 안내</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec band">
    <h2>시호한의원 교통사고 진료는 무엇을 함께 살펴보나요?</h2>
    <p>
      김은미 대표원장은 <strong>한방내과 전문의</strong>로, 한방병원에서 4년 이상
      근무했습니다. 한방병원에서 교통사고로 입원한 환자를 진료한 경험이 있어, 사고
      이후 나타나는 증상과 경과를 폭넓게 살펴 왔습니다.
    </p>
    <p>
      교통사고로 인한 편타성 손상(whiplash)과 관련해서는 평가도구인 Whiplash
      Disability Questionnaire의 한국어 번역·문화적 개작 연구에 참여했습니다. 그
      밖에 경추성 현훈, 일시적 혈압 상승, 사고 후 두통에 관한 증례 보고도
      발표했습니다.
    </p>
    <p>
      그래서 목·허리의 통증뿐 아니라 사고 이후 함께 나타나는 두통, 불면, 소화불량,
      어지럼, 혈압 변화 같은 내과적인 증상도 함께 살펴봅니다. 필요한 검사가 있으면
      안내해 드리고, 상태에 따라 한약 처방도 함께 고려합니다.
    </p>
    <p class="note">
      원장의 수련 과정과 논문 목록은 <a href="/doctors/">의료진 소개</a>에 정리해
      두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>검사에서 이상이 없다는데 왜 계속 아플까요?</h2>
    <p>
      X-ray나 CT, MRI는 뼈와 디스크 등 구조적인 손상을 확인하는 데 쓰입니다. 이런
      검사에서 뚜렷한 소견이 보이지 않아도 통증이 남는 경우가 있습니다.
    </p>
    <p>
      사고 충격으로 근육과 인대가 긴장한 상태이거나, 관절의 움직임이 제한된 경우가
      여기에 해당합니다. 시호한의원에서는 통증이 있는 부위의 움직임을 직접 확인하고,
      필요하면 초음파로 해당 부위를 살펴본 뒤 치료 방향을 정합니다.
    </p>
    <p class="statement">
      검사 결과와 함께 지금 어떤 동작에서 어떻게 불편한지를 같이 확인합니다.
    </p>
  </section>

  <section class="sec band">
    <h2>퇴근이 늦어도 매일 통원할 수 있나요?</h2>
    <p>
      시호한의원은 입원실을 운영하지 않고 통원 진료로 진행합니다. 대신 평일에는
      20:00까지, 수요일은 21:00까지 진료하여 직장에 다니시는 분도 매일 통원하실 수
      있도록 하고 있습니다.
    </p>
    <ul class="hours">
      {clinic.hours.map((h) => (
        <li>
          <strong>{h.days}</strong>
          <span>
            {h.open}–{h.close}
            {h.lunch && ` · 점심 ${h.lunch}`}
            {h.note && ` · ${h.note}`}
          </span>
        </li>
      ))}
      <li><strong>일요일</strong><span>휴진</span></li>
    </ul>
    <p class="note">{clinic.closedDays}. {clinic.lastReception}</p>
    <p>
      수요일은 21:00까지 야간진료를 운영하여 퇴근 후에도 내원하실 수 있습니다.
      휴진 일정은 <a href={clinic.links.naverBooking}>네이버 예약</a>창에서 확인해
      주세요. 오시는 길과 주차 안내는
      <a href="/contact/">오시는 길</a>에 있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>교통사고 진료 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>접수와 문의</h2>
    <p>
      자동차보험 접수나 진료 가능 시간이 궁금하시면 전화로 문의해 주세요. 사고
      상황과 증상을 확인한 뒤 어떻게 진행하면 되는지 안내해 드립니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
    </p>
    <p class="cta-sub">
      <a href={clinic.links.naverBooking}>네이버 예약</a> ·
      <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
    </p>
  </section>

  <style>
    /* 공진단·수험생 보약 페이지와 같은 토큰·리듬을 씁니다. */
    .hero,
    .sec {
      --surface: #fbfcfa;
      --sunk: #edf0e9;
    }
    .sec { margin-top: 3.5rem; }
    .sec > p { max-width: 34rem; margin: 0 0 1rem; }
    .sec > p:last-child { margin-bottom: 0; }
    .sec h2 + p { margin-top: 0; }

    .band {
      margin-inline: -1.25rem;
      padding: 2.25rem 1.25rem 2.5rem;
      background: var(--sunk);
    }
    .band > h2:first-child { margin-top: 0; }

    .hero { margin-bottom: 1rem; }
    .hero p { max-width: 34rem; margin: 0 0 1rem; }
    .eyebrow {
      margin: 0 0 0.75rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--accent);
    }
    .hero h1 { line-height: 1.35; }
    .hero .lead { font-size: 1.08rem; }

    .cta-row { margin: 1.75rem 0 0.75rem; }
    .cta {
      display: inline-block;
      padding: 0.75rem 1.6rem;
      background: var(--accent);
      color: var(--paper);
      font-weight: 600;
      text-decoration: none;
      border-radius: 2px;
      transition: background-color 0.15s ease;
    }
    .cta:hover { background: #7d561a; color: var(--paper); }
    .cta-sub { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
    .cta-sub a { color: var(--ink-soft); }
    .cta-sub a:hover { color: var(--accent); }

    .statement {
      max-width: 34rem;
      margin: 1.75rem 0 0;
      padding-left: 1.1rem;
      border-left: 3px solid var(--accent);
      font-family: var(--serif);
      font-size: 1.12rem;
      line-height: 1.65;
    }

