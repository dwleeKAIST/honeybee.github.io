---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
import { img, photos } from '../lib/img';

const title = '동탄 보폐고 | 환절기 비염·기침·가래 한약';
const description =
  '환절기마다 반복되는 비염, 후비루, 기침과 가래가 불편하다면 증상의 양상을 함께 살펴봅니다. 시호한의원의 보폐고 및 호흡기 한약 진료 안내.';

// 원장 확인 사항 (2026-09)
//   - 비급여 한약입니다.
//   - 호흡기 진료에 약침도 사용할 수 있습니다.
//   - 소아도 복용할 수 있습니다.
//   - 특히 비염 증상이 심한 경우, 축농증(부비동염)이 있는 경우,
//     인후통이나 목소리 변화가 있는 경우에 우선 고려합니다.
//     → 이 내용은 '어떤 경우에 먼저 고려하나요?' 절에 있습니다.
//       원장의 표현('잘 듣는다')을 그대로 옮기지 않고 진료에서 무엇을
//       먼저 고려하는지의 사실 서술로 적었습니다. 효과가 좋다는 서술은
//       의료법 제56조의 과장광고에 해당할 수 있습니다.
//
// ⚠ 아직 확인되지 않아 본문에 적지 않은 항목
//   ① 보폐고의 약재 구성 · 함량
//   ② 제형과 포장 단위 (스틱 / 파우치 / 병 등)
//   ③ 원내 탕전실 직접 조제인지, 원외에서 받아오는 제품인지
//   ④ 1일 복용 횟수와 1회 용량, 표준 복용 기간
//   ⑤ 소아 복용 가능 연령의 하한과 소아 용량 (복용 가능하다는 것은
//      확인되었으나 몇 세부터인지, 용량을 어떻게 줄이는지는 미확인)
//   ⑥ 제품 사진 (public/images/product-bopyego.* — 올리면 자동 표시됩니다)
//   위 항목은 확인되는 대로 채우면 되고, 지금 페이지는 이 값 없이도
//   문장이 성립하도록 썼습니다. 임의의 수치를 적지 않았습니다.
//
// 의료광고법 — 아래 표현은 쓰지 않았습니다.
//   - '면역력을 강화합니다', '감기를 예방합니다', '재발하지 않습니다',
//     '재발을 방지합니다', '만성 비염을 치료합니다' → 효과 보장·예방 주장
//   - '먹자마자', '바로 좋아집니다', '빠르게' → 즉효성 주장
//   - '효과가 뛰어납니다', '환자가 먼저 찾는 약' → 과장·비교
//   - '항생제 없이 치료합니다' → 다른 진료과와의 비교 (의료법 제56조)
//   - '호흡기 보약이므로 매일 먹으면 좋습니다' → 진찰 없는 상시 복용 권유
//   - 환자 후기와 치료 경험담 (의료법 제56조 제2항 제2호)
// 보폐고의 역할은 '진찰 후 상태에 따라 활용할 수 있는 한약 처방'
// 수준으로만 적었습니다.
//
// 치료 방법은 비염 페이지(/rhinitis/)에 이미 적혀 있는 것만 씁니다.
// 비내시경 · 비강 추나 · 비염침 · 외용제(비염고 · 브레이니) · 한약.
// 호흡기 진료에 약침을 쓴다는 서술은 확인 전이므로 넣지 않았습니다.

const productPhoto = img(photos.bopyego);

// 첫 화면 요약. AI가 페이지 주제를 한눈에 잡을 수 있도록 사실만 짧게 적습니다.
const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '비내시경으로 코 안을 확인한 뒤 무엇이 필요한지 정합니다',
  '보폐고 · 보험한약 · 맞춤 한약 가운데 상태에 맞는 것을 선택',
  '비염이 심한 경우, 축농증(부비동염), 인후통·목소리 변화에 우선 고려',
  '한의사 진찰 후 처방 — 완성품을 그대로 판매하지 않습니다',
  '보폐고는 건강보험이 적용되지 않는 비급여 한약입니다',
];

const asks = [
  { t: '환절기만 되면 반복됩니다', d: '계절이 바뀔 때마다 콧물, 재채기, 코막힘이 다시 시작되는 경우.' },
  { t: '감기는 지났는데 기침이 남았습니다', d: '열과 몸살은 가라앉았는데 기침이나 가래가 오래 이어지는 경우.' },
  { t: '콧물이 목 뒤로 넘어갑니다', d: '콧물이나 가래가 목 뒤로 흘러 칼칼하고 불편한 후비루.' },
  { t: '자꾸 헛기침을 합니다', d: '목에 무언가 걸린 것 같아 ‘흠흠’ 소리를 내거나 잔기침이 이어지는 경우.' },
  { t: '말을 많이 하면 목이 불편합니다', d: '목을 오래 쓰고 나면 쉽게 잠기거나 건조해지는 경우.' },
  { t: '탕약은 부담스럽습니다', d: '매번 탕약을 챙겨 복용하기 어려워 간편한 형태의 한약을 찾는 경우.' },
];

// 같은 호흡기 증상이라도 진료에서 살펴보는 부분이 다릅니다.
// '증상 = 처방'으로 읽히지 않도록 오른쪽 칸에는 처방명을 쓰지 않고
// '무엇을 확인하는지'만 적습니다.
const patterns = [
  {
    t: '맑은 콧물 · 재채기 · 코 가려움',
    d: '알레르기비염 양상인지, 지금 점막이 어떤 상태인지 함께 살펴봅니다.',
  },
  {
    t: '누런 콧물 · 끈적한 가래',
    d: '코와 부비동, 목에 고인 분비물의 양상을 함께 살펴봅니다.',
  },
  {
    t: '감기 후 남은 가래기침',
    d: '기침이 나는 때와 양상, 가래의 성상, 감기 이후의 경과를 확인합니다.',
  },
  {
    t: '후비루 · 목의 이물감',
    d: '코 안의 상태와 목 뒤로 넘어가는 분비물, 인후부의 불편감을 함께 살펴봅니다.',
  },
];

// 보폐고를 먼저 고려하는 상황 (원장 확인, 2026-09).
// 원장의 표현은 '잘 듣는다'였습니다. 효과가 좋다고 적으면 의료법
// 제56조의 과장광고가 되므로, 진료에서 무엇을 먼저 고려하는지의
// 사실 서술로 옮겼습니다.
const priority = [
  {
    t: '비염 증상이 심한 경우',
    d: '코막힘이나 콧물이 일상에 지장을 줄 정도로 뚜렷하고, 계절마다 같은 정도로 반복되는 경우.',
  },
  {
    t: '축농증(부비동염)이 있는 경우',
    d: '누런 콧물이 오래 남거나 얼굴이 무겁고, 부비동에 분비물이 고여 있는 것이 확인되는 경우.',
  },
  {
    t: '인후통이 함께 있는 경우',
    d: '코 증상과 함께 목이 아프거나, 목 뒤로 넘어가는 분비물 때문에 인후부가 계속 불편한 경우.',
  },
  {
    t: '목소리에 변화가 있는 경우',
    d: '목소리가 쉬거나 잠기고, 말을 오래 하면 쉽게 불편해지는 경우.',
  },
];

// 환절기 호흡기 진료의 순서. 비염 페이지에 적힌 진료 방법만 씁니다.
const steps = [
  {
    t: '증상 확인',
    d: '언제부터, 어떤 상황에서 심해지는지 여쭙습니다. 감기를 앓은 뒤인지, 계절마다 반복되는지에 따라 보는 곳이 달라집니다.',
  },
  {
    t: '코 안과 목의 상태 확인',
    d: '비내시경으로 비강 점막을 직접 보고, 콧물과 가래의 양상, 목 뒤로 넘어가는 분비물, 인후부의 불편감을 함께 확인합니다.',
  },
  {
    t: '무엇이 필요한지 판단',
    d: '지금 증상을 다루는 것이 먼저인지, 반복되는 양상을 함께 보는 것이 먼저인지 정합니다. 한약이 필요하지 않다고 보이면 그렇게 말씀드립니다.',
  },
  {
    t: '치료와 처방',
    d: '보폐고, 보험한약, 맞춤 한약 가운데 필요한 것을 정하고, 코 증상에는 비강 추나·비염침·외용제를 함께 진행하기도 합니다. 필요한 경우 약침을 함께 사용합니다.',
  },
  {
    t: '경과 확인과 조정',
    d: '복용 중 증상이 어떻게 달라졌는지 확인하고, 필요하면 처방과 복용 방법을 조정합니다.',
  },
];

const faqs = [
  {
    q: '보폐고는 어떤 한약인가요?',
    a: [
      '코와 목의 호흡기 불편감으로 오시는 분의 진료에서, 상태에 따라 활용하는 고(膏) 형태의 한약입니다.',
      '탕약처럼 매번 데워 챙기지 않아도 되어 일상에서 복용하기 수월한 편입니다. 다만 어떤 분에게나 같은 방식으로 처방되는 것은 아니고, 진찰에서 지금 필요한 처방인지부터 확인합니다.',
    ],
  },
  {
    q: '비염이 있으면 누구나 보폐고를 복용할 수 있나요?',
