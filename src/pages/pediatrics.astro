---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';

const title = '동탄 목동 소아 한방 진료';
const description =
  '화성시 동탄구 목동 시호한의원. 비염, 잦은 감기, 소화, 수면, 키 성장, 야뇨증, 틱, 아토피를 아이의 상태에 맞추어 진료합니다.';

// 이 페이지도 새로운 의료 내용을 만들지 않았습니다. 이미 사이트에 있고
// 원장 확인을 거친 서술만 모아 소아 기준으로 다시 구성했습니다.
//   - 소아한약(성장기 아이의 소화·수면·잦은 감기) — /treatments/clinics/
//   - 비염 미취학 아동부터, 비내시경 — /rhinitis/
//   - 시럽 한약(연조엑스 보험한약), 아이도 복용하기 쉬움 — /digestion/
//   - 학년 제한 없음, 소아·청소년 한약 진료 — /student-care/
//   - 첩약 건강보험은 연령과 무관, 알레르기비염 어린이 많음 — /chuppyak/
//   - 성장기 아이의 자세 상담(앉는 자세·가방 습관) — /posture/
//   - 공진단 만 7세 이상, 만 4세 이상은 상태에 따라 반 알 — /gongjindan/
//
// 아래는 원장 확인 사항입니다 (2026-09 확인).
//   - 성장판을 초음파로 확인, 인바디 580으로 체성분 검사
//   - 야뇨증·틱·아토피 모두 진료 항목
//   - 아토피와 발진은 엑시머 레이저(아토빛)로 함께 치료. 빛을 쬐는 방식
//   - 아이용 침이 따로 있고, 거부감이 큰 경우 추나(비강추나·교정추나)나
//     물리치료만 진행하기도 함
//
// 장비와 진료 범위는 사실만 적고 효과를 단정하지 않습니다.

const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '비염은 미취학 아동부터 진료합니다',
  '잦은 감기, 소화·식욕부진, 수면, 야뇨증, 틱을 함께 살핍니다',
  '성장판은 초음파로, 체성분은 인바디로 확인합니다',
  '아토피와 발진은 엑시머 레이저(아토빛)를 함께 사용합니다',
  '아이가 먹기 쉬운 시럽 한약(연조엑스)은 건강보험이 적용됩니다',
];

const areas = [
  {
    t: '비염 · 코막힘',
    d: '재채기, 맑은 콧물, 코막힘이 반복되는 경우. 비내시경으로 코 안을 직접 확인합니다.',
    href: '/rhinitis/',
  },
  {
    t: '잦은 감기 · 호흡기',
    d: '감기를 자주 앓거나 기침, 가래가 오래 남는 경우.',
    href: null,
  },
  {
    t: '소화 · 식욕부진',
    d: '잘 체하거나 배가 자주 아픈 경우, 먹는 양이 적어 걱정되는 경우.',
    href: '/digestion/',
  },
  {
    t: '수면',
    d: '잠들기 어려워하거나 자다 자주 깨는 경우.',
    href: null,
  },
  {
    t: '키 성장',
    d: '또래보다 작아 걱정되는 경우. 초음파로 성장판을, 인바디로 체성분을 확인합니다.',
    href: null,
  },
  {
    t: '체력 · 컨디션',
    d: '쉽게 지치거나 활동량에 비해 힘들어하는 경우.',
    href: null,
  },
  {
    t: '야뇨증',
    d: '밤에 이불에 실수하는 일이 이어지는 경우.',
    href: null,
  },
  {
    t: '틱',
    d: '눈을 깜빡이거나 소리를 내는 등 반복되는 동작으로 상담을 오시는 경우.',
    href: null,
  },
  {
    t: '아토피 · 발진',
    d: '엑시머 레이저(아토빛)로 해당 부위에 빛을 쬐는 치료를 함께 진행합니다.',
    href: null,
  },
  {
    t: '자세 · 체형',
    d: '앉는 자세, 가방을 메는 습관, 통증이 있는지를 함께 확인합니다.',
    href: '/posture/',
  },
];

const forms = [
  {
    t: '시럽 한약 (연조엑스)',
    d: '짜서 먹는 형태의 보험한약입니다. 건강보험이 적용되어 부담이 크지 않고, 아이가 복용하기 쉽습니다.',
    href: '/insurance-herbs/',
  },
  {
    t: '맞춤 한약',
    d: '한방내과 전문의가 진찰한 뒤 아이의 체질과 상태에 맞추어 약재 구성과 용량을 조절해 처방합니다. 원내 탕전실에서 직접 조제합니다.',
    href: null,
  },
  {
    t: '첩약 건강보험',
    d: '알레르기비염으로 진단되는 경우 연령과 관계없이 건강보험이 적용된 맞춤 한약을 처방받으실 수 있습니다.',
    href: '/chuppyak/',
  },
];

const steps = [
  {
    t: '지금 가장 불편한 것부터',
    d: '아이가 어떤 증상으로 힘들어하는지, 언제부터인지 여쭙습니다. 보호자가 보시기에 달라진 점도 함께 말씀해 주세요.',
  },
  {
    t: '몸 상태를 함께 확인',
    d: '증상 하나만 보지 않고 수면, 소화, 잦은 감기 여부, 체력을 같이 확인합니다. 비염이면 비내시경으로 코 안을, 키가 걱정되시면 초음파로 성장판과 인바디로 체성분을 봅니다.',
  },
  {
    t: '아이가 받아들일 수 있는 방법으로',
    d: '한약은 아이가 먹기 쉬운 형태로, 침은 아이용 침으로 진행합니다. 거부감이 큰 경우에는 추나나 물리치료만 하기도 합니다.',
  },
  {
    t: '경과 확인',
    d: '복용 중 불편한 점이나 달라진 점을 알려주시면 확인 후 조정합니다.',
  },
];

const faqs = [
  {
    q: '몇 살부터 진료받을 수 있나요?',
    a: [
      '비염은 미취학 아동부터 진료하고 있습니다. 코막힘이나 콧물로 아이와 함께 오시는 경우가 많습니다.',
      '한약 처방은 학년이나 연령으로 제한을 두지 않습니다. 다만 아주 어린 경우에는 연령보다 지금 몸 상태를 먼저 확인한 뒤 필요한 처방과 용량을 말씀드립니다.',
    ],
  },
  {
    q: '아이가 한약을 잘 못 먹는데 방법이 있나요?',
    a: [
      '짜서 먹는 시럽 형태의 연조엑스 보험한약이 있습니다. 건강보험이 적용되어 부담이 크지 않고, 아이가 복용하기 쉽습니다.',
      '맞춤 한약을 처방하는 경우에도 아이가 먹기 쉽도록 복용 방식과 시간을 조정합니다. 잘 못 먹는다는 점을 상담할 때 미리 말씀해 주세요.',
    ],
  },
  {
    q: '아이 한약에도 건강보험이 적용되나요?',
    a: [
      '보험한약(연조엑스·과립제)은 건강보험이 적용됩니다. 처방 목록은 보험한약 안내에 정리해 두었습니다.',
      '알레르기비염으로 진단되는 경우에는 약재를 개별로 구성해 달인 맞춤 한약도 첩약 건강보험으로 처방받으실 수 있습니다. 연령 제한은 없습니다.',
      '침 치료와 추나요법에도 건강보험이 적용됩니다.',
    ],
  },
  {
    q: '아이도 침을 맞을 수 있나요?',
    a: [
      '네. 아이들도 침 치료를 많이 받습니다. 아이용으로 아프지 않은 침을 따로 갖추고 있습니다.',
      '침에 대한 거부감이 큰 경우에는 무리해서 진행하지 않습니다. 비강 추나나 교정 추나 같은 추나 치료만 진행하거나, 물리치료만 하기도 합니다.',
      '지금 아이에게 무엇이 필요한지는 진찰 후 말씀드립니다.',
    ],
  },
  {
    q: '성장판 검사는 어떻게 하나요? 엑스레이를 찍나요?',
    a: [
      '시호한의원에서는 초음파로 성장판을 확인합니다. 방사선을 쬐지 않고, 화면을 보면서 진행합니다.',
      '함께 인바디(InBody 580)로 근육량과 체지방 등 체성분도 확인합니다. 지금 몸이 어떤 상태인지 보고 상담해 드립니다.',
    ],
  },
  {
    q: '아이 키가 또래보다 작은데 상담할 수 있나요?',
    a: [
      '네. 키로 상담을 오시는 경우가 많습니다.',
      '초음파로 성장판을, 인바디로 체성분을 확인하고 수면, 소화, 식사량, 활동량 같은 생활 전반을 함께 여쭙니다.',
      '검사 결과와 지금 몸 상태를 보고 필요한 진료가 있는지 말씀드립니다.',
    ],
  },
  {
    q: '야뇨증도 진료하나요?',
    a: [
      '네. 진료하는 항목입니다.',
      '밤에 실수하는 빈도와 시기, 낮 동안의 소변 습관, 잠드는 상태와 수면의 깊이를 함께 확인한 뒤 진료 방향을 정합니다.',
    ],
  },
  {
    q: '틱 증상도 볼 수 있나요?',
    a: [
      '네. 틱으로 상담을 오시는 경우가 있습니다.',
      '언제부터 어떤 상황에서 늘어나는지, 수면과 소화, 긴장 정도가 어떤지를 함께 확인합니다. 증상만 따로 보지 않고 전반적인 몸 상태를 같이 살핍니다.',
    ],
  },
  {
    q: '아토피나 발진은 어떻게 치료하나요? 아이가 아파하지 않을까요?',
    a: [
      '시호한의원은 엑시머 레이저(아토빛)를 갖추고 있습니다. 해당 부위에 빛을 쬐는 방식이라 통증이 거의 없어 아이도 어려워하지 않습니다.',
      '레이저만 하지 않고 아이의 몸 상태에 맞춘 한약 진료를 함께 진행합니다.',
      '진행 횟수와 간격은 부위와 상태에 따라 다르므로 진찰 후 말씀드립니다.',
    ],
  },
  {
    q: '아이가 감기를 너무 자주 앓습니다.',
    a: [
      '잦은 감기로 상담을 오시는 경우가 많습니다. 감기 자체뿐 아니라 평소 수면, 소화, 체력이 어떤 상태인지를 함께 확인합니다.',
      '코 증상이 함께 있는 경우에는 비내시경으로 코 안을 직접 보고, 비염과 겹쳐 있는지 확인합니다.',
    ],
  },
  {
    q: '아이가 잘 안 먹어서 걱정입니다.',
    a: [
      '먹는 양이 적은 경우, 소화가 잘 되지 않아 식욕이 떨어진 것인지 다른 이유가 있는지부터 확인합니다.',
      '배가 자주 아프거나 잘 체하는 증상이 함께 있으면 소화 진료와 연결해 함께 봅니다.',
    ],
  },
  {
    q: '아이도 공진단을 복용할 수 있나요?',
    a: [
      '만 7세 이상부터 진료 후 권해 드립니다.',
      '만 4세를 넘은 아이라면 몸 상태에 따라 반 알씩 복용하도록 안내하기도 합니다. 연령만으로 정하지 않고 상담을 통해 결정합니다.',
    ],
  },
  {
    q: '중·고등학생도 같은 곳에서 보나요?',
    a: [
      '네. 학년 제한 없이 소아·청소년 한약 진료를 함께 하고 있습니다.',
      '시험을 앞둔 시기의 체력, 집중력, 수면 관리는 수험생 클리닉에 따로 정리해 두었습니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">소아 · 청소년 진료</p>
    <h1>동탄 목동 소아 한방 진료 — 증상 하나만 보지 않습니다</h1>
    <p class="lead">
      시호한의원은 경기 화성시 동탄구 목동에서 아이의 비염, 잦은 감기, 소화와
      식욕, 수면, 키 성장, 야뇨증, 틱, 아토피를 진료합니다. 비염은 미취학
      아동부터 진료합니다.
    </p>
    <ul class="hero-summary">{summary.map((x) => <li>{x}</li>)}</ul>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>아이 진료 상담하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>어떤 증상으로 오나요?</h2>
    <div class="cards">
      {areas.map((a) => (
        <div class="card">
          <strong>{a.t}</strong>
          <span>{a.d}</span>
          {a.href && <a href={a.href}>자세히 보기</a>}
        </div>
      ))}
    </div>
    <p class="note">
      아이는 여러 가지가 함께 얽혀 있는 경우가 많습니다. 코가 막혀 잠을 설치고,
      잘 자지 못해 아침에 입맛이 없는 식입니다. 그래서 증상 하나만 따로 보지
      않고 지금 몸 전체가 어떤 상태인지부터 확인합니다.
    </p>
  </section>

  <section class="sec">
    <h2>아이도 한약을 먹을 수 있나요?</h2>
    <p>
      먹을 수 있습니다. 문제는 대개 &lsquo;먹일 수 있느냐&rsquo;입니다. 그래서
      처방 방향만큼이나 아이가 먹기 쉬운 형태를 함께 정합니다.
    </p>
    <ul class="cases">
      {forms.map((f) => (
        <li>
          <strong>{f.t}</strong> — {f.d}
          {f.href && <> (<a href={f.href}>자세히 보기</a>)</>}
        </li>
      ))}
    </ul>
    <p class="statement">
      아이가 약을 잘 못 먹는다면 상담할 때 미리 말씀해 주세요. 형태와 복용
      시간을 조정해 안내해 드립니다.
    </p>
  </section>

  <section class="sec band">
    <h2>아이도 침을 맞나요?</h2>
    <p>
      아이들도 침 치료를 많이 받습니다. 시호한의원은 <strong>아이용으로 아프지
      않은 침</strong>을 따로 갖추고 있어, 어른과 같은 침을 쓰지 않습니다.
    </p>
    <p>
      그래도 침에 거부감이 큰 아이가 있습니다. 무리해서 진행하지 않습니다. 이런
      경우에는 비강 추나나 교정 추나 같은 추나 치료만 진행하거나, 물리치료만
      하기도 합니다. 지금 아이가 받아들일 수 있는 방법부터 시작합니다.
    </p>
    <p class="note">
      추나요법은 건강보험이 적용됩니다.{' '}
      <a href="/treatments/chuna/">추나요법 안내</a>와{' '}
      <a href="/rhinitis/">비염 · 코편안 클리닉</a>에 자세히 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>키가 걱정될 때는 무엇을 확인하나요?</h2>
    <p>
      또래보다 작아 걱정되어 오시는 경우가 많습니다. 시호한의원은
      <strong>초음파로 성장판</strong>을 확인합니다. 방사선을 쬐지 않고 화면을
      보면서 진행합니다.
    </p>
    <p>
      함께 <strong>인바디(InBody 580)</strong>로 근육량과 체지방 등 체성분을
      확인합니다. 키와 몸무게만으로는 보이지 않는 부분을 같이 보기 위해서입니다.
    </p>
    <p>
      검사만으로 끝내지 않습니다. 수면, 소화와 식사량, 활동량처럼 아이가
      자라는 데 관계있는 생활 전반을 함께 여쭙고, 지금 몸 상태를 놓고 상담해
      드립니다.
    </p>
    <p class="statement">
      검사 결과는 화면과 결과지를 함께 보면서 설명해 드립니다. 지금 상태가
      어떤지부터 확인하시고 필요한 진료를 정하시면 됩니다.
    </p>
  </section>

  <section class="sec band">
    <h2>아토피와 발진은 어떻게 보나요?</h2>
    <p>
      시호한의원은 <strong>엑시머 레이저(아토빛)</strong>를 갖추고 있습니다.
      아토피와 발진이 있는 부위에 빛을 쬐는 방식이라 통증이 거의 없어, 아이도
      어려워하지 않고 받습니다.
    </p>
    <p>
      레이저만 진행하지 않습니다. 피부 상태와 함께 수면, 소화, 잦은 감기 여부를
      확인하고 아이의 몸 상태에 맞춘 한약 진료를 함께 진행합니다. 진행 횟수와
      간격은 부위와 상태에 따라 다르므로 진찰 후 말씀드립니다.
    </p>
    <p class="note">
      엑시머 레이저는 건강보험이 적용되지 않는 경우가 있습니다. 진행 전에 비용을
      안내해 드립니다.
    </p>
  </section>

  <section class="sec">
    <h2>아이 진료에도 건강보험이 적용되나요?</h2>
    <p>
      침 치료와 추나요법에는 건강보험이 적용됩니다. 한약도 보험한약
      (연조엑스·과립제)은 건강보험이 적용되며, 처방 목록은{' '}
      <a href="/insurance-herbs/">보험한약 안내</a>에 정리해 두었습니다.
    </p>
    <p>
      약재를 개별로 구성해 달인 맞춤 한약은 <strong>알레르기비염</strong>으로
      진단되는 경우 첩약 건강보험 적용 대상입니다. 연령 제한이 없어 어린이
      환자도 처방받으실 수 있습니다.{' '}
      <a href="/chuppyak/">첩약 건강보험 안내</a>에 본인부담과 절차를 정리해
      두었습니다.
    </p>
    <p class="note">
      건강보험이 적용되지 않는 진료는 진행 전에 비용을 안내해 드립니다.
    </p>
  </section>

  <section class="sec band">
    <h2>진료는 어떤 순서로 진행되나요?</h2>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </li>
      ))}
    </ol>
    <p class="note">
      아이가 스스로 설명하기 어려운 부분이 많습니다. 보호자께서 보신 것 —
      언제부터, 어떤 상황에서, 어떻게 달라졌는지 — 을 함께 말씀해 주시면 큰
      도움이 됩니다.
    </p>
  </section>

  <section class="sec">
    <h2>학년이 올라가면 어디에서 보나요?</h2>
    <p>
      학년 제한 없이 같은 곳에서 봅니다. 다만 시험을 앞둔 시기에는 체력과
      집중력, 수면 관리가 중심이 되는 경우가 많아, 그 내용은 따로 정리해
      두었습니다.
    </p>
    <p class="note">
      <a href="/student-care/">수험생 클리닉</a>과{' '}
      <a href="/student-care/herbal-medicine/">수험생 보약 안내</a>를 함께
      참고해 주세요.
    </p>
  </section>

  <section class="sec band">
    <h2>소아 진료 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 <strong>경기도 화성시 동탄구 목동, 동탄신리천로 407
      동탄리더스타워 2층</strong>에 있습니다. 아이와 함께 오시는 경우 대기가
      길어지지 않도록 예약을 권해 드립니다.
    </p>
    <p>
      처음 상담은 검사 및 상담 시간이 1시간 이상 소요될 수 있어 예약 후
      내원하시기를 권장드립니다. 수요일은 21:00까지 야간진료를 운영하여 하교
      후에도 내원하실 수 있습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>네이버 예약</a>
      <a class="cta ghost" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
    </p>
    <p class="cta-sub">
      <a href={clinic.links.kakaoChannel}>카카오톡 문의</a> · <a href="/contact/">오시는 길</a>
    </p>
  </section>
</Base>
