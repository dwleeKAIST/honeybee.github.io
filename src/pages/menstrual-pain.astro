---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
import { chuppyak } from '../data/chuppyak';
import { img, photos } from '../lib/img';

const title = '동탄 목동 월경통 한의원';
const description =
  '화성시 동탄구 목동 시호한의원. 복부 초음파로 자궁과 난소를 확인하고 한약·침·뜸·약침·온열치료로 진료합니다. 첩약 건강보험 적용 대상입니다.';

// 원장 확인 사항 (2026-09)
//   - 복부 초음파로 자궁·난소 형태, 근종·낭종 유무, 자궁내막 두께를 확인
//   - 자궁내막증·근종이 의심되면 참고하여 본원 진료를 이어가기도 하고,
//     상태가 심한 경우 산부인과로 진료 의뢰해 질초음파·CT 등 추가 검사 안내
//   - 치료: 한약, 침, 뜸, 약침, 윈백 고주파 온열치료, 온열돔
//   - 보통 최소 3개월 이상 한약을 복용하며 3번 이상의 월경 주기를 확인
//   - 피임약 복용 중에도 진료 진행
//
// 이미 사이트에 있고 확인을 거친 서술
//   - 월경통은 첩약 건강보험 6개 질환 중 하나 — /chuppyak/, src/data/chuppyak.ts
//   - 원내 탕전실에서 한방내과 전문의가 직접 조제 — /chuppyak/
//   - 월경 양상과 동반 증상 확인, 필요 시 초음파 — /student-care/
//   - 윈백 고주파 2대 — /pain/
//
// ⚠ 확인 필요 (확인 전이라 쓰지 않았습니다)
//   - 월경 중에 내원해도 되는지, 첫 상담은 주기 중 언제가 좋은지
//   - 임신을 계획 중인 분의 월경통 진료를 어떻게 안내하는지
//
// 치료 효과를 단정하지 않습니다. '~에 사용합니다', '~을 목표로 합니다'
// 수준까지만 씁니다. 진통제나 피임약을 끊으라는 안내는 쓰지 않습니다.

const mechanismFigure = img(photos.menstrualMechanism);
const insuranceFigure = img(photos.menstrualInsurance);

const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '복부 초음파로 자궁·난소 형태, 근종·낭종, 자궁내막 두께를 확인합니다',
  '한약 · 침 · 뜸 · 약침 · 고주파 온열치료 · 온열돔',
  `월경통은 첩약 건강보험 적용 대상입니다 (한의원 본인부담 ${chuppyak.patientRate})`,
  '보통 3개월 이상 복용하며 3번 이상의 월경 주기를 확인합니다',
  '피임약을 복용 중이셔도 진료받으실 수 있습니다',
];

const signs = [
  {
    t: '진통제를 먹어도 힘들 때',
    d: '약을 먹어도 일상생활이 어렵거나, 먹는 양이 점점 늘어나는 경우.',
  },
  {
    t: '통증이 점점 심해질 때',
    d: '예전보다 아픈 정도나 기간이 달라졌다고 느껴지는 경우.',
  },
  {
    t: '일상이 매달 흔들릴 때',
    d: '통증으로 결근·결석하거나 누워 있어야 하는 날이 반복되는 경우.',
  },
  {
    t: '다른 증상이 함께 올 때',
    d: '월경 전후로 두통, 부종, 소화불량, 피로, 감정 기복이 같이 나타나는 경우.',
  },
  {
    t: '검사에서 이상이 없다고 들었을 때',
    d: '검사 결과는 괜찮은데 매달 통증이 반복되는 경우.',
  },
  {
    t: '근종이나 낭종이 있다고 들었을 때',
    d: '이전에 진단받은 것이 있다면 결과지를 가져와 주세요.',
  },
];

const care = [
  {
    t: '맞춤 한약',
    d: '한방내과 전문의가 진찰한 뒤 약재 구성과 용량을 조절해 처방합니다. 원내 탕전실에서 직접 조제합니다.',
    href: '/chuppyak/',
  },
  {
    t: '침 · 뜸',
    d: '복부와 허리, 손발의 경혈에 사용합니다. 침 치료는 건강보험이 적용됩니다.',
    href: '/treatments/',
  },
  {
    t: '약침',
    d: '정제한 한약 성분을 목표 부위에 주입합니다.',
    href: '/treatments/yakchim/',
  },
  {
    t: '고주파 온열치료',
    d: '윈백(Winback) 고주파로 복부에 열을 전달합니다. 2대를 갖추고 있습니다.',
    href: '/pain/',
  },
  {
    t: '온열돔',
    d: '복부를 따뜻하게 유지하는 것을 목적으로 진행합니다.',
    href: null,
  },
];

const steps = [
  {
    t: '월경 양상 확인',
    d: '주기와 기간, 통증이 언제 시작해 언제까지 이어지는지, 양과 색은 어떤지, 함께 오는 증상이 무엇인지 여쭙습니다.',
  },
  {
    t: '복부 초음파',
    d: '자궁과 난소의 형태, 근종이나 낭종이 있는지, 자궁내막 두께가 어떤지를 화면을 보며 확인합니다.',
  },
  {
    t: '원인이 따로 있는지 판단',
    d: '자궁내막증이나 근종이 의심되면 그 결과를 참고해 진료를 이어가고, 상태가 심한 경우에는 산부인과 진료를 권해 드립니다.',
  },
  {
    t: '치료 방향 결정',
    d: '한약, 침, 뜸, 약침, 고주파 온열치료, 온열돔 가운데 지금 필요한 것을 정합니다.',
  },
  {
    t: '주기마다 경과 확인',
    d: '한 달에 한 번 오는 증상이라 한 번의 진료로 판단하기 어렵습니다. 주기마다 어떻게 달라지는지 함께 확인합니다.',
  },
];

const faqs = [
  {
    q: '동탄 목동에서 월경통을 진료하는 한의원인가요?',
    a: [
      '네. 시호한의원은 경기 화성시 동탄구 목동, 동탄신리천로 407 동탄리더스타워 2층에서 월경통을 진료합니다.',
      '복부 초음파로 자궁과 난소 상태를 확인한 뒤 한약, 침, 뜸, 약침, 고주파 온열치료 가운데 필요한 것을 정합니다. 한방내과 전문의가 진료합니다.',
    ],
  },
  {
    q: '월경통도 건강보험이 적용된 한약을 받을 수 있나요?',
    a: [
      `네. 월경통은 첩약 건강보험 적용 대상 6개 질환 가운데 하나입니다. 한의원 기준 본인부담률은 ${chuppyak.patientRate}이며, ${chuppyak.amount} 기준 약 ${chuppyak.patientPay} 정도입니다.`,
      `급여 기준은 ${chuppyak.limit}입니다. 처방 구성에 따라 금액이 달라지므로 진찰 후 정확히 안내해 드립니다.`,
      chuppyak.privateInsuranceNote,
    ],
  },
  {
    q: '초음파는 왜 하나요? 아프지 않나요?',
    a: [
      '배 위에 젤을 바르고 기구를 대는 복부 초음파입니다. 통증은 없습니다.',
      '자궁과 난소의 형태, 근종이나 낭종이 있는지, 자궁내막 두께가 어떤지를 확인합니다. 매달 반복되는 통증의 배경에 다른 이유가 있는지 보기 위해서입니다.',
      '화면을 함께 보면서 지금 어떤 상태인지 설명해 드립니다.',
    ],
  },
  {
    q: '산부인과에서는 이상이 없다고 하는데 계속 아픕니다.',
    a: [
      '검사에서 뚜렷한 원인이 나오지 않는 경우가 있습니다. 이상이 없다는 것도 중요한 정보이니 결과지가 있으시면 가져와 주세요.',
      '이런 경우 월경 양상과 함께 소화, 수면, 스트레스, 손발의 냉감처럼 전반적인 몸 상태를 같이 확인하고 진료 방향을 정합니다.',
    ],
  },
  {
    q: '자궁내막증이나 근종이 있다고 들었습니다. 진료받을 수 있나요?',
    a: [
      '진단받으신 내용을 참고해 진료를 이어가는 경우가 있습니다. 결과지나 검사 소견을 가져와 주세요.',
      '다만 상태가 심한 경우에는 산부인과 진료를 권해 드립니다. 질초음파나 CT 같은 추가 검사가 필요한 상황이 있기 때문입니다.',
      '어느 쪽이 지금 필요한지는 진찰과 초음파 확인 후 말씀드립니다.',
    ],
  },
  {
    q: '얼마나 오래 복용해야 하나요?',
    a: [
      '보통 최소 3개월 이상 한약을 복용하면서 3번 이상의 월경 주기를 확인합니다.',
      '한 달에 한 번 오는 증상이라 한두 번으로는 어떻게 달라지는지 판단하기 어렵습니다. 주기마다 통증의 정도와 동반 증상이 어떻게 변하는지 함께 봅니다.',
      '복용 기간은 상태에 따라 다르므로 진찰 후 말씀드립니다.',
    ],
  },
  {
    q: '피임약을 복용 중인데 진료받을 수 있나요?',
    a: [
      '네. 피임약을 복용 중이셔도 진료를 진행합니다.',
      '복용 중인 약과 복용 기간, 복용하시게 된 이유를 알려주세요. 그 내용을 함께 고려해 처방 방향을 정합니다.',
    ],
  },
  {
    q: '진통제는 계속 먹어도 되나요?',
    a: [
      '지금 드시는 약을 임의로 조절하지 마시고, 무엇을 얼마나 드시고 있는지 먼저 알려주세요.',
      '복용하시는 약을 확인한 뒤 진료 방향을 함께 말씀드립니다.',
    ],
  },
  {
    q: '월경 전 증후군(PMS)도 함께 보나요?',
    a: [
      '네. 월경 전후로 나타나는 두통, 부종, 소화불량, 피로, 감정 기복도 함께 확인합니다.',
      '통증 하나만 따로 보지 않고 지금 몸 전체가 어떤 상태인지부터 확인합니다.',
    ],
  },
  {
    q: '학생도 진료받을 수 있나요?',
    a: [
      '네. 첩약 건강보험은 연령 제한이 없습니다.',
      '매달 반복되는 통증이 수험생활에서 큰 변수가 되기도 합니다. 수험생 진료는 수험생 클리닉에 따로 정리해 두었습니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">월경통 · PMS</p>
    <h1>동탄 목동 월경통 진료 — 매달 반복된다면 한 번은 확인해 보세요</h1>
    <p class="lead">
      시호한의원은 경기 화성시 동탄구 목동에서 월경통을 진료합니다. 복부
      초음파로 자궁과 난소 상태를 확인한 뒤 한약, 침, 뜸, 약침, 온열치료 가운데
      지금 필요한 것을 정합니다.
    </p>
    <ul class="hero-summary">{summary.map((x) => <li>{x}</li>)}</ul>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>월경통 상담하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>어느 정도면 진료를 받아보아야 하나요?</h2>
    <div class="cards">
      {signs.map((s) => (
        <div class="card">
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </div>
      ))}
    </div>
    <p class="note">
      월경통은 흔한 일이라 참고 넘기는 경우가 많습니다. 다만 매달 같은 일이
      반복된다면, 그 배경에 다른 이유가 있는지 한 번은 확인해 보시는 편이
      좋습니다.
    </p>
  </section>

  <section class="sec">
    <h2>복부 초음파로 무엇을 확인하나요?</h2>
    <p>
      시호한의원은 월경통 진료에 <strong>복부 초음파</strong>를 사용합니다. 배
      위에 젤을 바르고 기구를 대는 방식이라 통증은 없습니다.
    </p>
    <ul class="cases">
      <li><strong>자궁과 난소의 형태</strong> — 크기와 모양을 확인합니다</li>
      <li><strong>근종 · 낭종 유무</strong> — 통증의 배경에 다른 이유가 있는지 봅니다</li>
      <li><strong>자궁내막 두께</strong> — 지금 주기의 상태를 함께 확인합니다</li>
    </ul>
    <p>
      화면을 함께 보면서 설명해 드립니다. 매달 반복되는 통증을 증상만으로
      판단하지 않고, 지금 어떤 상태인지 확인한 뒤 진료 방향을 정하기
      위해서입니다.
    </p>
    {mechanismFigure && (
      <figure class="fig">
        <img
          src={mechanismFigure}
          alt="월경통 발생 과정과 한의학 치료를 정리한 그림. 프로스타글란딘 과분비, 자궁 근육 과수축, 혈류 감소, 산소 부족으로 통증이 생기며, 한의학 치료는 어혈 제거와 혈액순환 개선으로 수축을 완화하고 첩약 건강보험이 적용된다는 내용"
          width="896"
          height="896"
          loading="lazy"
        />
      </figure>
    )}
  </section>

  <section class="sec band">
    <h2>원인이 따로 있는 월경통인가요?</h2>
    <p>
      뚜렷한 원인 없이 나타나는 월경통이 있고, 자궁내막증이나 근종처럼 배경이
      되는 상태가 있는 경우가 있습니다. 어느 쪽인지에 따라 진료 방향이
      달라집니다.
    </p>
    <p>
      초음파와 진찰에서 <strong>자궁내막증이나 근종이 의심되는 경우</strong>,
      그 내용을 참고해 본원에서 진료를 이어가기도 합니다. 이전에 산부인과에서
      받으신 결과지가 있다면 가져와 주세요.
    </p>
    <p>
      다만 <strong>상태가 심한 경우에는 산부인과 진료를 권해 드립니다.</strong>
      질초음파나 CT처럼 추가 검사가 필요한 상황이 있기 때문입니다. 필요한
      경우라고 판단되면 그렇게 말씀드립니다.
    </p>
    <p class="statement">
      지금 필요한 것이 한방 진료인지 다른 검사인지부터 확인하고 시작합니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 치료를 받게 되나요?</h2>
    <ul class="cases">
      {care.map((c) => (
        <li>
          <strong>{c.t}</strong> — {c.d}
          {c.href && <> (<a href={c.href}>자세히 보기</a>)</>}
        </li>
      ))}
    </ul>
    <p class="statement">
      모든 치료를 다 받아야 하는 것은 아닙니다. 어떤 조합이 필요한지는 진찰과
      초음파 확인 후 정합니다.
    </p>
    <p class="note">
      월경통 진료와 한약 처방은 한방내과 전문의가 진행합니다. 두 원장의 이력은{' '}
      <a href="/doctors/">의료진 소개</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec band">
    <h2>월경통도 건강보험 한약이 되나요?</h2>
    <p>
      됩니다. 월경통은 <strong>첩약 건강보험 적용 대상 6개 질환</strong> 가운데
      하나입니다. 약재를 개별로 구성해 달인 맞춤 한약에 건강보험이 적용됩니다.
    </p>
    <ul class="cases">
      <li><strong>본인부담률</strong> — 한의원 기준 {chuppyak.patientRate}</li>
      <li><strong>본인부담금</strong> — {chuppyak.amount} 기준 약 {chuppyak.patientPay}</li>
      <li><strong>급여 기준</strong> — {chuppyak.limit}</li>
      <li><strong>시행 기간</strong> — 시범사업이 {chuppyak.through}까지 진행됩니다</li>
    </ul>
    <p class="note">
      {chuppyak.privateInsuranceNote} 절차와 조건은{' '}
      <a href="/chuppyak/">첩약 건강보험 안내</a>에 정리해 두었습니다.
    </p>
    {insuranceFigure && (
      <figure class="fig">
        <img
          src={insuranceFigure}
          alt="월경통 첩약 건강보험 안내. 한약 처방에 건강보험 급여가 적용되며, 생리 전부터 복용하고, 혈액 순환 개선과 자궁 수축 완화를 목표로 개인맞춤으로 처방한다는 내용"
          width="896"
          height="896"
          loading="lazy"
        />
      </figure>
    )}
  </section>

  <section class="sec">
    <h2>얼마나 오래 복용하나요?</h2>
    <p>
      보통 <strong>최소 3개월 이상</strong> 한약을 복용하면서{' '}
      <strong>3번 이상의 월경 주기</strong>를 확인합니다.
    </p>
    <p>
      한 달에 한 번 오는 증상이라 한두 번으로는 어떻게 달라지는지 판단하기
      어렵습니다. 주기마다 통증의 정도와 기간, 함께 오는 증상이 어떻게 변하는지
      확인하면서 처방을 조정합니다.
    </p>
    <p class="note">
      복용 기간은 상태에 따라 다릅니다. 진찰 후 어느 정도를 보아야 하는지
      말씀드립니다.
    </p>
  </section>

  <section class="sec band">
    <h2>진료는 어떤 순서로 진행되나요?</h2>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </li>
      ))}
    </ol>
    <p class="note">
      월경 전후로 나타나는 두통, 부종, 소화불량, 피로, 감정 기복도 함께
      확인합니다. 갱년기의 월경 변화는{' '}
      <a href="/menopause/">갱년기 클리닉</a>에, 수험생의 월경통은{' '}
      <a href="/student-care/">수험생 클리닉</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>월경통 진료 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 <strong>경기도 화성시 동탄구 목동, 동탄신리천로 407
      동탄리더스타워 2층</strong>에 있습니다. 산부인과 검사 결과지나 복용 중인
      약이 있으시면 함께 가져와 주세요.
    </p>
    <p>
      처음 상담을 오시는 분은 검사 및 상담 시간이 1시간 이상 소요될 수 있어 예약
      후 내원하시기를 권장드립니다. 수요일은 21:00까지 야간진료를 운영합니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>네이버 예약</a>
      <a class="cta ghost" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
    </p>
    <p class="cta-sub">
      <a href={clinic.links.kakaoChannel}>카카오톡 문의</a> · <a href="/contact/">오시는 길</a>
    </p>
  </section>

  <style>
    /* 인포그래픽 — 본문 폭에 맞춰 표시 */
    .fig {
      margin: 1.75rem 0 0;
      max-width: 26rem;
    }
    .fig img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--line-soft);
      border-radius: 8px;
    }
  </style>
</Base>
