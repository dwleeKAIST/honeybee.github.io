---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';

const title = '동탄 자율신경실조증 한의원 | 번아웃·이명·불면 진료';
const description =
  '자율신경실조·번아웃·이명·불면·공황. 검사에서 이상이 없는데 불편이 이어지는 경우를 한방내과 전문의가 진료합니다.';

// 원장 검수 완료. 원내 검사(스트레스 검사·혈압·코르트 혈압계·혈액검사),
// 정신과 약 병행 방침, 공황·불안 진료 범위, 처방(가미소요산·귀비탕·보중익기탕)은
// 모두 원장 확인 사항입니다.
//
// ⚠ 확인 필요: '코르트 혈압계'의 정확한 제품명 표기
// ⚠ 원장 초안에서 아래는 반영하지 않았습니다.
//   - '되게 잘 봐드릴 수 있다', '내가 잘하는 분야' → 자기 우월성·최상급 표현
//   - '다른 곳에서 다 받아도 해결 안 되던 문제가 좋아지신다' → 치료 효과 서술이자
//     사실상의 치료경험담. 내원 경위 서술까지만 남겼습니다.
//   - '공황장애를 진료합니다' → 진단명을 단정하지 않고 '공황·불안 증상',
//     '공황장애로 진단받고 치료 중인 경우'로 서술
//
// 아래는 지키고 있습니다.
//   - '자율신경실조증을 치료합니다' 대신 '자율신경과 관련해 나타나는 증상을
//     진료합니다'로 서술
//   - 정신과·신경과 치료를 중단하도록 권하는 서술은 절대 넣지 않음
//   - 논문은 '증례 보고를 발표했습니다'라는 사실 서술까지만. 효과가 입증되었다는
//     식의 서술은 하지 않음
//   - 환자 후기, 치료 효과 보장, 다른 진료과와의 비교 없음

const symptoms = [
  { t: '잠', d: '잠들기 어렵거나 자다가 자주 깬다. 자고 일어나도 개운하지 않다' },
  { t: '어지럼', d: '자리에서 일어날 때 아찔하거나, 머리가 흔들리는 느낌이 든다' },
  { t: '가슴', d: '두근거리거나 답답하다. 숨이 얕아지는 느낌이 든다' },
  { t: '소화', d: '명치가 답답하고 잘 체한다. 긴장하면 속이 불편해진다' },
  { t: '두통', d: '머리가 무겁고 뻐근하다. 목·어깨의 긴장과 함께 나타난다' },
  { t: '체온 · 땀', d: '손발이 차거나 얼굴로 열이 오른다. 땀이 유난히 많거나 적다' },
  { t: '피로 · 번아웃', d: '쉬어도 회복되지 않고 오후가 되면 무기력해진다' },
  { t: '혈압', d: '긴장하면 혈압이 오르거나 잴 때마다 편차가 크다' },
  { t: '귀', d: '이명이 들리거나 귀가 먹먹하다. 소리가 잘 안 들린다' },
  { t: '불안', d: '이유 없이 불안하고 긴장이 잘 풀리지 않는다' },
];

const faqs = [
  {
    q: '병원에서 검사를 다 받았는데 이상이 없다고 합니다. 그래도 봐야 할까요?',
    a: [
      '검사에서 구조적인 문제가 확인되지 않았다는 것은 중요한 정보입니다. 그 결과를 가져오시면 진료에 도움이 됩니다.',
      '검사로 확인되지 않는 불편이 이어지는 경우, 지금 몸의 상태를 다른 방식으로 살펴봅니다. 수면, 소화, 체온, 긴장 정도를 함께 보고 어디에서부터 다룰지 정합니다.',
    ],
  },
  {
    q: '정신건강의학과 치료를 받고 있어도 진료받을 수 있나요?',
    a: [
      '가능합니다. 정신과 약을 복용하면서 내원하시는 분이 많고, 대개 한약과 함께 복용하실 수 있습니다.',
      '다만 약을 새로 시작하셨거나 변경하는 중이라면 상황에 따라 다르게 안내해 드립니다. 복용 중인 약과 진료받고 계신 내용을 알려주세요.',
      '기존 치료를 임의로 중단하지 마시고, 담당 선생님과 상의하시는 것이 좋습니다.',
    ],
  },
  {
    q: '공황·불안 증상도 진료하시나요?',
    a: [
      '네. 공황이나 불안과 함께 나타나는 두근거림, 숨이 얕아지는 느낌, 불면, 소화 문제를 함께 살펴봅니다.',
      '공황장애로 진단받고 치료 중이신 경우에도 상담하실 수 있습니다. 진료받고 계신 내용을 알려주세요.',
    ],
  },
  {
    q: '이명이나 귀가 먹먹한 것도 보시나요?',
    a: [
      '네. 이명이나 귀가 먹먹한 느낌으로 내원하시는 경우가 있습니다.',
      '이비인후과 검사를 먼저 받아보신 경우에는 그 결과를 가져오시면 진료에 도움이 됩니다. 수면, 긴장 정도, 목·어깨 상태를 함께 확인합니다.',
    ],
  },
  {
    q: '검사 비용이 따로 드나요?',
    a: [
      '검사 항목에 따라 다릅니다. 진행하기 전에 어떤 검사를 왜 하는지, 비용은 어떻게 되는지 안내해 드립니다.',
      '원하지 않으시면 하지 않아도 괜찮습니다.',
    ],
  },
  {
    q: '한약을 얼마나 복용해야 하나요?',
    a: [
      '증상이 나타난 기간과 상태에 따라 다릅니다. 최근에 생긴 문제와 여러 해 이어진 문제의 경과가 같지 않습니다.',
      '복용 기간은 진찰 후 정하며, 복용 중 경과를 확인해 조정합니다.',
    ],
  },
  {
    q: '건강보험이 적용되는 한약도 있나요?',
    a: [
      '불면, 신경과민, 어지러움, 두근거림 등에 사용하는 보험한약이 있습니다.',
      '어떤 처방이 맞는지는 진찰 후 정합니다. 목록은 보험한약 안내에 정리해 두었습니다.',
    ],
  },
  {
    q: '침 치료도 함께 받나요?',
    a: [
      '한약만으로 진행하는 경우도 있고, 침 치료를 함께 하는 경우도 있습니다.',
      '목·어깨의 긴장이 두통이나 어지럼과 함께 나타나는 경우에는 그 부위를 함께 다루는 편이 낫습니다.',
    ],
  },
  {
    q: '스트레스가 원인이라고 하는데 한약이 도움이 될까요?',
    a: [
      '스트레스 자체를 대신 해결해 드릴 수는 없습니다. 다만 같은 상황에서도 몸이 반응하는 정도는 사람마다, 그리고 그 사람의 상태에 따라 다릅니다.',
      '지금 잠을 못 자고 소화가 안 되는 상태라면 그 부분부터 다룹니다. 몸의 부담이 줄면 같은 일을 겪을 때 덜 힘든 경우가 있습니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];

const papers = [
  '경추성 현훈 환자의 복합 한의진료 경과 및 삶의 질 변화: CARE 가이드라인에 따른 증례보고',
  '일시적 혈압상승에 대한 황련해독탕 과립제의 효과: 증례 보고',
  '관상동맥질환으로 진단된 만성 비정형 흉통의 한의진료 경과: 증례보고',
  '뇌동맥류 파열로 인한 지주막하 출혈 환자에서 중재적 치료 후 조절되지 않은 두통 치험 1례',
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">자율신경 · 한방내과</p>
    <h1>검사에서는 이상이 없다는데, 계속 불편하신가요?</h1>
    <p class="lead">
      잠이 얕고, 어지럽고, 가슴이 두근거리고, 속이 편하지 않습니다. 여러 곳에서
      검사를 받았지만 특별한 소견은 없다고 들으셨을 수 있습니다.
    </p>
    <p>
      시호한의원은 자율신경실조와 번아웃, 이명, 불면, 공황·불안, 기능성 소화불량
      등을 한방내과 전문의 진료로 살펴봅니다. 다른 곳에서 검사와 치료를 받았지만
      불편이 이어져 오시는 경우가 많습니다.
    </p>
    <p>
      증상 하나하나를 따로 보지 않고, 지금 몸이 어떤 상태인지부터 확인합니다.
      연령과 성별에 관계없이 진료합니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>상담 예약하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>자율신경 증상이란 무엇을 말하나요?</h2>
    <p>
      자율신경은 심장이 뛰는 속도, 소화기의 움직임, 체온과 땀처럼 우리가 의식하지
      않아도 알아서 조절되는 기능을 담당합니다.
    </p>
    <p>
      이 조절이 흐트러지면 여러 곳에서 동시에 불편이 나타납니다. 잠이 얕아지고,
      속이 불편해지고, 가슴이 두근거리고, 손발이 차가워지는 일이 함께 생기는
      것입니다.
    </p>
    <p class="statement">
      한 곳이 크게 잘못된 것이 아니라, 여러 곳이 조금씩 어긋난 상태에 가깝습니다.
      그래서 검사로는 잘 잡히지 않습니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 증상으로 오시나요?</h2>
    <div class="cards">
      {symptoms.map((s) => (
        <div class="card">
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </div>
      ))}
    </div>
    <p class="note">
      한 가지만 있는 경우보다 여러 가지가 함께 나타나는 경우가 많습니다. 그중 어느
      것이 가장 불편한지부터 말씀해 주세요.
    </p>
  </section>

  <section class="sec band">
    <h2>번아웃도 자율신경과 관련이 있나요?</h2>
    <p>
      번아웃은 오랫동안 부담이 이어진 뒤에 나타납니다. 이때 자율신경의 조절이 함께
      흐트러지는 경우가 있습니다.
    </p>
    <p>
      쉬어도 회복되지 않고, 잠은 얕아지고, 소화가 안 되고, 아무것도 하고 싶지
      않아지는 상태가 함께 오는 것입니다. 의욕의 문제로만 보기 어려운 이유입니다.
    </p>
    <p class="statement">
      쉬어야 한다는 것은 알지만 쉬어도 회복되지 않는 상태라면, 지금 몸이 어떤
      상태인지 확인해 보시는 편이 좋습니다.
    </p>
  </section>

  <section class="sec">
    <h2>검사에서 이상이 없다는데 왜 불편할까요?</h2>
    <p>
      영상 검사와 혈액 검사는 구조적인 손상이나 수치의 이상을 확인하는 데 쓰입니다.
      이런 검사에서 뚜렷한 소견이 없다는 것은 중요한 정보이고, 큰 병이 아니라는
      확인이기도 합니다.
    </p>
    <p>
      다만 검사로 확인되지 않는 불편이 이어지는 경우가 있습니다. 조절 기능이
      흐트러진 상태는 수치로 잡히지 않기 때문입니다.
    </p>
    <p>
      시호한의원에서는 검사 결과를 함께 확인하면서, 지금 어떤 상황에서 어떤 증상이
      나타나는지를 같이 살펴봅니다. 검사 결과를 가져오시면 진료에 도움이 됩니다.
    </p>
  </section>

  <section class="sec band">
    <h2>한방내과 전문의 진료는 무엇을 함께 보나요?</h2>
    <p>
      김은미 대표원장은 한방내과 전문의로, 한방병원에서 4년 이상 근무했습니다.
      어지럼, 두통, 혈압, 흉통처럼 여러 과에 걸치는 증상을 함께 살펴 온 진료
      경험이 있습니다.
    </p>
    <p>아래는 이와 관련해 발표한 증례 보고입니다.</p>
    <ul class="papers">{papers.map((p) => <li>{p}</li>)}</ul>
    <p class="note">
      논문 전체 목록과 두 원장의 이력은 <a href="/doctors/">의료진 소개</a>에 정리해
      두었습니다. 갱년기 시기에 나타나는 증상은
      <a href="/menopause/">갱년기 클리닉 안내</a>에 따로 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>원내에서 어떤 검사를 하나요?</h2>
    <p>
      말로 여쭤보는 것만으로는 지금 상태를 가늠하기 어려운 부분이 있습니다. 그래서
      시호한의원은 아래 검사를 진료 과정에서 함께 진행합니다.
    </p>
    <div class="cards">
      <div class="card">
        <strong>스트레스 검사</strong>
        <span
          >초진 진찰 과정에서 진행합니다. 원하지 않으시면 하지 않아도
          괜찮습니다.</span
        >
      </div>
      <div class="card">
        <strong>혈압 측정</strong>
        <span>진료 때마다 확인합니다. 방문할 때마다의 변화를 함께 봅니다.</span>
      </div>
      <div class="card">
        <strong>코르트 혈압계</strong>
        <span>심혈관계와 맥박 상태를 좀 더 자세히 확인할 때 사용합니다.</span>
      </div>
      <div class="card">
        <strong>혈액검사</strong>
        <span
          >간기능, 신기능, 당화혈색소, 혈색소, 염증 수치 등 기본 항목을 원내에서
          진행할 수 있습니다.</span
        >
      </div>
    </div>
    <p class="note">
      검사 결과를 함께 보면서 지금 상태를 설명해 드립니다. 다른 병원에서 받은 검사
      결과가 있으면 가져오셔도 좋습니다.
    </p>
  </section>

  <section class="sec">
    <h2>진료는 어떤 순서로 진행되나요?</h2>
    <ol class="steps">
      <li>
        <strong>지금 상태 확인</strong>
        <span
          >수면, 소화, 체온, 땀, 대소변, 월경 상태를 함께 확인합니다. 어떤 상황에서
          증상이 심해지는지도 여쭤봅니다. 초진에는 스트레스 검사와 혈압 측정을 함께
          진행합니다.</span
        >
      </li>
      <li>
        <strong>검사 결과와 복용 약 확인</strong>
        <span
          >다른 병원에서 받은 검사 결과가 있으면 함께 봅니다. 복용 중인 약과 치료
          중인 질환도 확인합니다.</span
        >
      </li>
      <li>
        <strong>우선순위 판단</strong>
        <span
          >여러 증상이 함께 있는 경우, 지금 생활을 가장 많이 방해하는 것부터
          다룹니다. 어떤 순서로 진행할지 말씀드립니다.</span
        >
      </li>
      <li>
        <strong>처방과 경과 확인</strong>
        <span
          >상태에 맞는 한약을 처방하고, 필요하면 침 치료를 함께 진행합니다. 복용
          중 경과를 확인하면서 조정합니다.</span
        >
      </li>
    </ol>
  </section>

  <section class="sec">
    <h2>어떤 치료를 받게 되나요?</h2>
    <div class="cards">
      <div class="card">
        <strong>맞춤 한약</strong>
        <span
          >개별 상태에 따라 약재 구성과 용량을 조절해 처방합니다. 가미소요산,
          귀비탕, 보중익기탕 등 여러 처방을 상태에 따라 사용합니다.</span
        >
      </div>
      <div class="card">
        <strong>보험한약</strong>
        <span
          >불면, 신경과민, 어지러움, 두근거림 등에 사용하는 보험한약이 있습니다.</span
        >
        <a href="/insurance-herbs/">목록 보기</a>
      </div>
      <div class="card">
        <strong>침 치료</strong>
        <span>목·어깨의 긴장이 두통이나 어지럼과 함께 나타날 때 함께 다룹니다.</span>
      </div>
      <div class="card">
        <strong>약침</strong>
        <span>통증이 뚜렷한 부위가 있으면 그 부위에 직접 사용합니다.</span>
        <a href="/treatments/yakchim/">자세히 보기</a>
      </div>
    </div>
  </section>

  <section class="sec band">
    <h2>다른 병원 치료를 받고 있어도 되나요?</h2>
    <p>
      네. 정신건강의학과나 신경과, 내과에서 진료받고 계신 경우에도 상담하실 수
      있습니다. 정신과 약을 복용하면서 내원하시는 분이 많고, 대개 한약과 함께
      복용하실 수 있습니다.
    </p>
    <p>
      다만 약을 새로 시작하셨거나 변경하는 중이라면 상황에 따라 다르게 안내해
      드립니다. 복용 중인 약과 진료받고 계신 내용을 알려주시면 확인 후 말씀드립니다.
    </p>
    <p class="statement">
      기존 치료를 임의로 중단하지 마시고, 담당 선생님과 상의하시는 것이 좋습니다.
    </p>
  </section>

  <section class="sec">
    <h2>자율신경 진료 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 경기 화성시 동탄신리천로 407 동탄리더스타워 2층에 있습니다.
      지금 어떤 상태인지 먼저 확인한 뒤 무엇부터 다룰지 말씀드립니다. 초진 상담은
      시간이 조금 더 필요하니 예약하고 오시는 편이 좋습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>상담 예약하기</a>
    </p>
    <p class="cta-sub">
      전화 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a> ·
      <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
    </p>
  </section>

  <style>
    .hero,
    .sec {
      --surface: #fbfcfa;
      --sunk: #edf0e9;
    }
    .sec { margin-top: 3.5rem; }
    .sec > p { max-width: 34rem; margin: 0 0 1rem; }
    .sec > p:last-child { margin-bottom: 0; }
    .sec h2 + p { margin-top: 0; }

    .band {
      margin-inline: -1.25rem;
      padding: 2.25rem 1.25rem 2.5rem;
      background: var(--sunk);
    }
    .band > h2:first-child { margin-top: 0; }

    .hero { margin-bottom: 1rem; }
    .hero p { max-width: 34rem; margin: 0 0 1rem; }
    .eyebrow {
      margin: 0 0 0.75rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--accent);
    }
    .hero h1 { line-height: 1.35; }
    .hero .lead { font-size: 1.08rem; }

    .cta-row { margin: 1.75rem 0 0.75rem; }
    .cta {
      display: inline-block;
      padding: 0.75rem 1.6rem;
      background: var(--accent);
      color: var(--paper);
      font-weight: 600;
      text-decoration: none;
      border-radius: 2px;
      transition: background-color 0.15s ease;
    }
    .cta:hover { background: #7d561a; color: var(--paper); }
    .cta-sub { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
    .cta-sub a { color: var(--ink-soft); }
    .cta-sub a:hover { color: var(--accent); }

    .statement {
      max-width: 34rem;
      margin: 1.75rem 0 0;
      padding-left: 1.1rem;
      border-left: 3px solid var(--accent);
      font-family: var(--serif);
      font-size: 1.12rem;
      line-height: 1.65;
    }

    .note { font-size: 0.94rem; color: var(--ink-soft); }

    .cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin: 1.5rem 0;
      max-width: 34rem;
    }
    .card {
      padding: 1.1rem 1.15rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 2px;
    }
    .card strong {
      display: block;
      font-family: var(--serif);
      font-size: 1.05rem;
      color: var(--accent);
      margin-bottom: 0.25rem;
    }
    .card span {
      display: block;
      color: var(--ink-soft);
      font-size: 0.96rem;
    }
    .card a { display: inline-block; margin-top: 0.5rem; font-size: 0.9rem; }
    @media (min-width: 34rem) {
      .cards { grid-template-columns: 1fr 1fr; }
    }

    .papers {
      list-style: none;
      padding: 0;
      margin: 1rem 0 1.5rem;
      max-width: 34rem;
    }
    .papers li {
      position: relative;
      padding: 0.65rem 0 0.65rem 1.2rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.94rem;
      line-height: 1.6;
      color: var(--ink-soft);
    }
    .papers li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.35rem;
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
    }

    .steps {
      list-style: none;
      counter-reset: step;
      margin: 1.5rem 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-width: 34rem;
    }
    .steps li {
      counter-increment: step;
      position: relative;
      padding: 1.1rem 1.15rem 1.1rem 3rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 2px;
    }
    .steps li::before {
      content: counter(step);
      position: absolute;
      left: 1.15rem;
      top: 1.05rem;
      font-family: var(--serif);
      font-weight: 700;
      color: var(--accent);
    }
    .steps strong {
      display: block;
      font-family: var(--serif);
      font-size: 1.05rem;
      margin-bottom: 0.2rem;
    }
    .steps span { color: var(--ink-soft); font-size: 0.96rem; }

    /* FAQ 아코디언 — JS 없이 details/summary */
    .faq { margin-top: 1.5rem; border-top: 1px solid var(--line); }
    .faq details { border-bottom: 1px solid var(--line); }
    .faq summary {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 1rem 0;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after {
      content: '+';
      flex: none;
      color: var(--accent);
      font-weight: 400;
      font-size: 1.2rem;
      line-height: 1;
    }
    .faq details[open] summary::after { content: '−'; }
    .faq summary:hover { color: var(--accent); }
    .faq .answer { padding: 0 0 1.1rem; max-width: 34rem; }
    .faq .answer p {
      margin: 0 0 0.7rem;
      font-size: 0.96rem;
      color: var(--ink-soft);
    }
    .faq .answer p:last-child { margin-bottom: 0; }

    .closing { margin-top: 4rem; }

    @media (max-width: 34rem) {
      .hero h1 { font-size: 1.5rem; }
      .statement { font-size: 1.05rem; }
      .steps li { padding: 1rem 1rem 1rem 2.7rem; }
    }
  </style>
</Base>
