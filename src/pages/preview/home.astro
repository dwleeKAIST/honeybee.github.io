---
// ⚠ 승인 전 전면 리뉴얼 시안입니다. 운영 중인 홈(/)은 건드리지 않았습니다.
//    noindex 이고 sitemap 에서도 빠집니다.
//
// 지시서의 SECTION 01~09 를 구현했습니다. 지켜야 할 것:
//   - 기존 홈의 내부 링크 25개를 하나도 줄이지 않습니다(아래 LINKS 주석)
//   - 「도침」은 월 1,031회 노출되는 검색어입니다. /treatments/dochim/ 로
//     가는 홈 링크를 반드시 남깁니다
//   - 조제 현황은 실제 데이터만 씁니다. 없으면 아무것도 그리지 않습니다
//   - 「최근 7일」이라고 쓰지 않습니다. activeDays 는 달력 7일이 아니라
//     조제가 있었던 날 7일입니다(원장 요청)
import Base from '../../layouts/Base.astro';
import { clinic } from '../../data/clinic';
import { img, photos } from '../../lib/img';
import { getCollection } from 'astro:content';
import PromoBanner from '../../components/PromoBanner.astro';
import DecoctionTicker from '../../components/DecoctionTicker.astro';
import { decoctions, hasDecoctions, formatDay } from '../../data/decoctions';

const treatments = (await getCollection('treatments')).sort(
  (a, b) => a.data.order - b.data.order,
);

// 실제로 있는 사진만 씁니다. 파일이 없으면 img() 가 null 을 돌려주고
// 그 자리는 렌더되지 않습니다. AI 로 만든 이미지는 쓰지 않습니다.
const heroPhoto = img(photos.consult);
const gynPhoto = img(photos.careUltrasoundGyn);
const acuPhoto = img(photos.careAcupuncture);
const kimPhoto = img(photos.kimEunmi);
const parkPhoto = img(photos.parkJonggyu);
const signPhoto = img(photos.decoctionSign);
const brewPhoto = img(photos.decoctionBrewing);
const windowPhoto = img(photos.decoctionWindow);

// SECTION 03 — 네 영역. 지시서의 분류를 따르되 각 영역이 실제 진료
// 페이지로 이어지게 묶었습니다. 이 묶음 덕분에 갱년기·소화·자율신경처럼
// 예전 홈에서 카드로만 걸려 있던 페이지가 본문 링크로 들어옵니다.
const care = [
  {
    no: '01',
    t: '통증 진료',
    body: '어깨, 목, 허리, 무릎, 손목, 발. 필요한 경우 초음파로 해당 부위를 확인한 뒤 침, 약침, 도침, 추나 가운데 무엇이 필요한지 정합니다.',
    links: [
      { href: '/pain/', t: '관절 · 근육 통증' },
      { href: '/treatments/dochim/', t: '도침치료' },
      { href: '/treatments/yakchim/', t: '약침 · 초음파약침' },
      { href: '/treatments/chuna/', t: '추나요법' },
    ],
    photo: acuPhoto,
    alt: '시호한의원에서 복부에 침을 놓는 모습',
    w: 2000,
    h: 1500,
  },
  {
    no: '02',
    t: '여성 건강',
    body: '매달 반복되는 월경 통증과 월경 전 증후군, 갱년기의 변화. 복부 초음파로 확인 가능한 범위를 살펴본 뒤 한약, 침, 뜸, 약침 가운데 지금 필요한 것을 정합니다.',
    links: [
      { href: '/menstrual-pain/', t: '월경통 · PMS' },
      { href: '/menstrual-pain/pms/', t: '월경 전 증후군' },
      { href: '/menopause/', t: '갱년기 클리닉' },
    ],
    photo: gynPhoto,
    alt: '시호한의원에서 복부 초음파로 자궁을 확인하는 모습. 화면에 초음파 영상이 보입니다',
    w: 1600,
    h: 1200,
  },
  {
    no: '03',
    t: '몸의 균형',
    body: '검사에서 이상이 없는데 불편이 이어지는 경우가 있습니다. 소화와 수면, 어지럼과 두근거림, 오래된 피로를 함께 살핍니다.',
    links: [
      { href: '/autonomic/', t: '자율신경 · 번아웃' },
      { href: '/digestion/', t: '속편안 클리닉' },
      { href: '/posture/', t: '체형교정' },
    ],
    photo: null,
    alt: null,
  },
  {
    no: '04',
    t: '아이와 학생',
    body: '비염으로 밤에 깨고, 식후에 처지고, 오래 앉아 있기 힘든 상태라면 보약이 첫 번째 답이 아닐 수 있습니다. 무엇이 가장 방해가 되는지부터 확인합니다.',
    links: [
      { href: '/pediatrics/', t: '소아 진료' },
      { href: '/student-care/', t: '수험생 클리닉' },
      { href: '/rhinitis/', t: '코편안 클리닉 · 비염' },
    ],
    photo: null,
    alt: null,
  },
];

// SECTION 07 — 공간. 한 장은 크게, 나머지는 비율을 달리합니다.
const spaceBig = img(photos.roomReceptionDesk);
const spaceSide = [
  { src: img(photos.roomConsultDesk), t: '진료실', ratio: '4 / 5' },
  { src: img(photos.roomAcupuncture), t: '침 치료실', ratio: '3 / 2' },
  { src: img(photos.roomCorridor), t: '건물 복도에서 본 입구', ratio: '3 / 2' },
  { src: img(photos.roomChuna), t: '추나 치료실', ratio: '4 / 5' },
];

// SECTION 08 — 조제 현황. 실제 데이터에서만 뽑습니다.
const byLabel = new Map<string, number>();
for (const it of decoctions.items) {
  byLabel.set(it.label, (byLabel.get(it.label) ?? 0) + it.count);
}
const topLabels = [...byLabel.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);
const days = [...new Set(decoctions.items.map((i) => i.date))].sort();
const spanText =
  days.length > 1 ? `${formatDay(days[0])}부터 ${formatDay(days[days.length - 1])}까지` : null;
---

<Base
  title="전면 리뉴얼 시안 — 시호한의원"
  description="승인 전 시안입니다. 실제 홈페이지가 아닙니다."
  noindex={true}
>
  <PromoBanner />
  <p class="draft-note">
    전면 리뉴얼 시안입니다. 운영 중인 <a href="/">홈 화면</a>은 그대로입니다.
  </p>

  {/* ══ SECTION 01 · HERO ═══════════════════════════════ */}
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">경기 화성시 동탄구 목동</p>
      <h1>같은 증상이라도, 같은 몸은 없습니다.</h1>
      <p class="hero-lead">
        충분히 듣고 세심하게 살핀 뒤, 지금 필요한 치료를 함께 정합니다.
      </p>
      <p class="hero-cta">
        <a class="cta lg" href={clinic.links.naverBooking}>진료 예약하기</a>
      </p>
      <p class="hero-sub">
        전화로도 예약하실 수 있습니다 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a>
      </p>
    </div>
    {heroPhoto && (
      <figure class="hero-media">
        <img
          src={heroPhoto}
          alt="시호한의원 진료실에서 한의사가 환자의 맥을 짚으며 상담하는 모습"
          width="2000"
          height="1500"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}
  </section>

  {/* ══ SECTION 02 · PHILOSOPHY ═════════════════════════ */}
  <section class="philo">
    <h2>증상보다 사람을 먼저 봅니다.</h2>
    <p>
      같은 증상이라도 그 원인과 회복의 과정은 다를 수 있습니다. 시호는 충분히
      듣고, 세심하게 살피며, 필요한 치료를 함께 고민합니다.
    </p>
    <p class="philo-slogan">
      <span>비로소 시<em>始</em>, 빛날 호<em>熩</em></span>
      <strong>비로소 빛을 열다</strong>
      <a href="/story/">이름에 담긴 뜻</a>
    </p>
  </section>

  {/* ══ SECTION 03 · SIGNATURE CARE ═════════════════════ */}
  <section class="care wide-out">
    <p class="sec-label">Signature Care</p>
    <h2 class="sec-h">어떤 진료를 찾으시나요?</h2>
    {care.map((c, i) => (
      <article class={`care-row${c.photo ? (i % 2 ? ' flip' : '') : ' no-photo'}`}>
        {c.photo && (
          <div class="care-media">
            <img src={c.photo} alt={c.alt} width={c.w} height={c.h} loading="lazy" />
          </div>
        )}
        <div class="care-text">
          <p class="care-no">{c.no}</p>
          <h3>{c.t}</h3>
          <p>{c.body}</p>
          <ul class="care-links">
            {c.links.map((l) => (
              <li><a href={l.href}>{l.t}</a></li>
            ))}
          </ul>
        </div>
      </article>
    ))}
    <p class="care-rest">
      교통사고 한방치료, 피부미용, 안면매선도 진료합니다.{' '}
      <a href="/car-accident/">교통사고</a> ·{' '}
      <a href="/skin-care/">피부미용</a> ·{' '}
      <a href="/treatments/maeseon/">매선치료</a> ·{' '}
      <a href="/treatments/clinics/">맞춤 클리닉</a>
      <a class="more" href="/treatments/">전체 진료 보기</a>
    </p>
  </section>

  {/* ══ SECTION 04 · PRECISION CARE ═════════════════════ */}
  <section class="precision">
    <div class="precision-inner">
      <p class="eyebrow olive">Precision Care</p>
      <h2>보이지 않는 곳까지 살핍니다.</h2>
      <p class="precision-lead">
        초음파로 통증 부위와 주변 조직을 확인하고, 진찰 소견을 종합해 치료
        방향을 결정합니다. 화면을 환자분과 함께 보면서 설명드립니다.
      </p>
      <p class="precision-cta">
        <a class="cta ghost" href="/treatments/dochim/">도침치료 알아보기</a>
        <a class="cta ghost" href="/treatments/yakchim/">초음파약침 알아보기</a>
      </p>
      <p class="precision-sub">
        비염은 <a href="/rhinitis/endoscopy/">비내시경</a>으로, 아이의 키는
        초음파 성장판과 인바디로 확인합니다. 간기능, 신기능, 당화혈색소 같은
        기본 항목은 <a href="/autonomic/">원내 혈액검사</a>로 확인할 수 있습니다.
      </p>
    </div>
  </section>

  {/* ══ SECTION 05 · OUR DOCTORS ════════════════════════ */}
  <section class="docs wide-out">
    <p class="sec-label">Our Doctors</p>
    <h2 class="sec-h">어떤 한의사가 진료하나요?</h2>
    <p class="docs-lead">
      한 분의 환자를 두 의료진이 함께 살펴보는 협진 방식으로 진료의 연속성을
      유지합니다.
    </p>
    <div class="docs-grid">
      <article class="doc">
        {kimPhoto && (
          <img src={kimPhoto} alt="시호한의원 김은미 대표원장" loading="lazy" />
        )}
        <h3>김은미 <span>대표원장</span></h3>
        <p class="doc-cred">한방내과 전문의 (보건복지부)</p>
        <p>
          한의원 및 한방병원에서 {clinic.leadDoctorYears} 근무했습니다.
          입원환자를 대상으로 한 한약의 안전성 평가 다기관 임상연구에
          시험담당자로 참여했고, 증례보고와 임상연구 11편에 이름을 올렸습니다.
        </p>
      </article>
      <article class="doc">
        {parkPhoto && (
          <img src={parkPhoto} alt="시호한의원 박종규 진료원장" loading="lazy" />
        )}
        <h3>박종규 <span>진료원장</span></h3>
        <p class="doc-cred">근골격계 초음파 · 추나</p>
        <p>
          미국근골격계초음파사(RMSK)와 척추신경추나의학회 정회원입니다. 아픈
          자리가 분명한 경우 초음파로 해당 부위를 확인한 뒤 치료를 정합니다.
        </p>
      </article>
    </div>
    <p class="more center"><a href="/doctors/">두 원장의 이력과 진료 요일</a></p>
  </section>

  {/* ══ SECTION 06 · HERBAL MEDICINE ════════════════════ */}
  <section class="herbal">
    <div class="herbal-text">
      <p class="eyebrow">원내 조제</p>
      <h2>좋은 약재를 고르는 일부터, <br />한 포의 한약을 완성하는 순간까지.</h2>
      <p>
        맞춤 한약은 원내 조제탕전실에서 한의사가 직접 조제합니다. 완성품을
        그대로 내어 드리지 않고, 진찰을 통해 지금 필요한 처방인지부터
        확인합니다.
      </p>
      <ul class="herbal-links">
        <li><a href="/gongjindan/">공진단</a> — 쉬어도 피로가 풀리지 않을 때</li>
        <li><a href="/bopyego/">보폐고</a> — 환절기 비염과 기침이 반복될 때</li>
        <li><a href="/insurance-herbs/">보험한약</a> — 건강보험이 적용되는 한약</li>
        <li><a href="/chuppyak/">첩약 건강보험</a> — 맞춤 한약의 보험 적용</li>
        <li><a href="/student-care/herbal-medicine/">수험생 보약</a></li>
      </ul>
    </div>
    {brewPhoto && (
      <figure class="herbal-media">
        <img
          src={brewPhoto}
          alt="시호한의원 원내 조제탕전실의 탕전기"
          width="1333"
          height="2000"
          loading="lazy"
        />
      </figure>
    )}
  </section>

  {/* ══ SECTION 07 · SIHO SPACE ═════════════════════════ */}
  <section class="space wide-out">
    <p class="sec-label">Siho Space</p>
    <h2 class="sec-h">한의원은 어떻게 생겼나요?</h2>
    <div class="space-grid">
      {spaceBig && (
        <figure class="space-big">
          <img
            src={spaceBig}
            alt="시호한의원 접수 데스크와 대기 공간"
            width="2000"
            height="1333"
            loading="lazy"
          />
          <figcaption>접수 데스크와 대기 공간</figcaption>
        </figure>
      )}
      <div class="space-side">
        {spaceSide.filter((s) => s.src).map((s) => (
          <figure style={`--r:${s.ratio}`}>
            <img src={s.src} alt={`시호한의원 ${s.t}`} loading="lazy" />
            <figcaption>{s.t}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ══ SECTION 08 · SIHO DISPENSARY ════════════════════
      실제 데이터가 없으면 아무것도 그리지 않습니다. 숫자를 지어내지
      않기 위한 장치라 조건을 풀지 마세요. */}
  {hasDecoctions && (
    <section class="dispensary">
      <div class="dispensary-inner">
        <p class="eyebrow olive">Siho Dispensary</p>
        <h2>오늘도 시호 안에서 한약을 짓습니다.</h2>
        <p class="disp-lead">
          원내 조제탕전실에서 지은 한약의 실제 기록입니다. 환자 정보는 담지
          않고 분류와 건수만 올립니다.
        </p>
        <dl class="disp-stats">
          <div>
            <dt>조제일 {decoctions.activeDays}일 동안</dt>
            <dd>{decoctions.total}<em>건</em></dd>
          </div>
          {spanText && (
            <div>
              <dt>기간</dt>
              <dd class="sm">{spanText}</dd>
            </div>
          )}
        </dl>
        {topLabels.length > 0 && (
          <ul class="disp-labels">
            {topLabels.map(([label, n]) => (
              <li><span>{label}</span><em>{n}건</em></li>
            ))}
          </ul>
        )}
        <p class="disp-note">
          갱신 {formatDay(decoctions.updatedAt.slice(0, 10))} ·{' '}
          <a href="/chuppyak/">원내 조제탕전실 안내</a>
        </p>
      </div>
      {windowPhoto && (
        <figure class="disp-media">
          <img
            src={windowPhoto}
            alt="시호한의원 조제탕전실 명패와 안을 볼 수 있는 창"
            width="2000"
            height="1333"
            loading="lazy"
          />
        </figure>
      )}
    </section>
  )}

  {/* ══ SECTION 09 · VISIT SIHO ═════════════════════════ */}
  <section class="visit wide-out">
    <p class="sec-label">Visit Siho</p>
    <h2 class="sec-h">진료시간과 오시는 길</h2>
    <div class="visit-grid">
      <div>
        <h3>진료시간</h3>
        <ul class="hours-plain">
          {clinic.hours.map((h) => (
            <li>
              <span class="d">{h.days}</span>
              <span class="t">
                {h.open}–{h.close}
                {h.lunch && <em>점심 {h.lunch}</em>}
                {h.note && <em>{h.note}</em>}
              </span>
            </li>
          ))}
          <li><span class="d">일요일</span><span class="t">휴진</span></li>
        </ul>
        <p class="fine">{clinic.closedDays}. {clinic.lastReception}</p>
      </div>
      <div>
        <h3>오시는 길</h3>
        <p class="addr">{clinic.address.body}</p>
        <p class="fine">
          리더스타워 지하 주차장과 맞은편 공영주차장을 이용하실 수 있습니다.
          2층에 올라오시면 한의원이 바로 보입니다.
        </p>
        <p class="fine">{clinic.firstVisitNote}</p>
        <p class="visit-links">
          <a href="/contact/">주차 · 길 안내</a> ·{' '}
          <a href={clinic.links.kakaoMap}>지도 보기</a> ·{' '}
          <a href="/faq/">자주 묻는 질문</a>
        </p>
        <p class="visit-cta">
          <a class="cta lg" href={clinic.links.naverBooking}>진료 예약하기</a>
        </p>
        <p class="fine">
          전화 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a> ·{' '}
          <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
        </p>
      </div>
    </div>
    <ul class="plain treat-list">
      {treatments.map((t) => (
        <li>
          <a href={`/treatments/${t.id}/`}>{t.data.title}</a>
          <span class="summary">{t.data.summary}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* 기존 조제 현황 띠는 그대로 둡니다. 데이터 연동이 여기에 걸려 있습니다. */}
  <DecoctionTicker />

  {/* 모바일 하단 고정 예약 — 꼬리말을 가리지 않도록 body 아래 여백을 줍니다 */}
  <div class="book-bar">
    <a class="cta lg" href={clinic.links.naverBooking}>진료 예약하기</a>
    <a class="book-tel" href={`tel:${clinic.phone}`}>전화</a>
  </div>

  <style>
    .draft-note {
      margin: 0 0 2rem; padding: 0.7rem 1rem;
      background: #fdf6e3; border: 1px solid #e8dcc0; border-radius: 4px;
      font-size: 0.9rem; color: var(--ink-soft);
    }

    /* 글은 읽기 좋은 폭을 유지하고, 사진이 주인공인 칸만 넓힙니다.
       main 밖으로 나갔다가 안쪽 여백으로 다시 가둬 1920px 에서도
       1292px 에서 멈춥니다. */
    .wide-out {
      margin-inline: calc(50% - 50vw);
      padding-inline: max(var(--pad), calc(50vw - 38rem));
    }
    .sec-label {
      margin: 0 0 0.85rem;
      font-family: var(--sans);
      font-size: 0.76rem; font-weight: 700; letter-spacing: 0.2em;
      color: var(--olive); text-transform: uppercase;
      padding-bottom: 0.7rem; border-bottom: 1px solid var(--line);
    }
    .sec-h {
      font-size: clamp(1.4rem, 2.8vw, 1.8rem); font-weight: 600;
      letter-spacing: -0.02em; margin: 0 0 1.5rem;
    }
    .eyebrow {
      margin: 0 0 0.9rem; font-family: var(--sans);
      font-size: 0.74rem; font-weight: 700; letter-spacing: 0.2em;
      color: var(--accent);
    }
    .eyebrow.olive { color: var(--olive); text-transform: uppercase; }
    .more a, a.more { font-family: var(--sans); font-size: 0.95rem; }
    .more.center { text-align: center; margin: 2.5rem 0 0; }

    /* ── 01 HERO — 사진이 화면의 60~70% ─────────────────── */
    .hero { margin: 0 0 5rem; }
    .hero-text { max-width: var(--read); margin: 1.5rem 0 2rem; }
    .hero h1 {
      font-size: clamp(2rem, 6.4vw, 3.4rem);
      line-height: 1.32; letter-spacing: -0.035em; font-weight: 600;
      margin: 0 0 1.4rem; text-wrap: balance;
    }
    .hero-lead {
      font-size: 1.08rem; line-height: 1.85; color: var(--ink-soft);
      margin: 0 0 2rem;
    }
    .hero-cta { margin: 0 0 0.9rem; }
    .hero-sub { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
    .cta.lg { padding: 0.95rem 2.1rem; font-size: 1.02rem; }
    .hero-media {
      margin: 0 calc(50% - 50vw); padding: 0; overflow: hidden;
    }
    .hero-media img {
      display: block; width: 116%; margin-left: -8%; height: auto;
      aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 42%;
    }

    /* ── 02 PHILOSOPHY — 아이콘도 카드도 없습니다 ───────── */
    .philo {
      max-width: 36rem; margin: 0 auto 6rem; text-align: center;
    }
    .philo h2 {
      font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 600;
      letter-spacing: -0.03em; line-height: 1.5; margin: 0 0 1.6rem;
    }
    .philo p {
      font-size: 1.04rem; line-height: 2.05; color: var(--ink-soft);
      margin: 0 0 2.4rem;
    }
    .philo-slogan {
      display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
      margin: 0; padding-top: 2.2rem; border-top: 1px solid var(--line);
      font-size: 0.9rem;
    }
    .philo-slogan span { color: var(--ink-soft); font-size: 0.85rem; }
    .philo-slogan span em { font-style: normal; opacity: 0.6; margin-left: 0.15em; }
    .philo-slogan strong {
      font-family: var(--head); font-size: 1.25rem; font-weight: 600;
      letter-spacing: 0.02em;
    }
    .philo-slogan a { font-family: var(--sans); font-size: 0.9rem; }

    /* ── 03 SIGNATURE CARE — 편집형, 카드 없음 ──────────── */
    .care { margin-block: 0 5.5rem; }
    .care-row {
      display: grid; gap: 1.5rem; align-items: center;
      margin: 0 0 3.5rem;
    }
    .care-row.no-photo {
      max-width: var(--read);
      padding-left: 1.2rem; border-left: 2px solid var(--line);
    }
    .care-media img {
      width: 100%; height: auto; display: block;
      aspect-ratio: 3 / 2; object-fit: cover;
    }
    .care-no {
      margin: 0 0 0.5rem; font-family: var(--sans);
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em;
      color: var(--olive);
    }
    .care-text h3 {
      font-size: clamp(1.3rem, 2.8vw, 1.6rem); font-weight: 600;
      margin: 0 0 0.9rem; letter-spacing: -0.02em;
    }
    .care-text > p { color: var(--ink-soft); line-height: 1.95; margin: 0 0 1.1rem; }
    .care-links { margin: 0; padding: 0; list-style: none; font-family: var(--sans); }
    .care-links li { display: inline; font-size: 0.95rem; }
    .care-links li + li::before { content: ' · '; color: var(--line); }
    .care-rest {
      max-width: var(--read); margin: 0;
      font-size: 0.95rem; line-height: 1.95; color: var(--ink-soft);
      font-family: var(--sans);
    }
    .care-rest .more { display: block; margin-top: 0.9rem; }

    /* ── 04 PRECISION CARE — 짙은 띠 하나 ───────────────── */
    .precision {
      margin: 0 calc(50% - 50vw) 5.5rem;
      padding: 4.5rem max(var(--pad), calc(50vw - 38rem));
      background: var(--ink); color: #f1efe8;
    }
    .precision-inner { max-width: 40rem; }
    .precision h2 {
      font-size: clamp(1.6rem, 4.4vw, 2.3rem); font-weight: 600;
      letter-spacing: -0.03em; line-height: 1.45; margin: 0 0 1.3rem;
