      width: 100%; max-width: 17rem; height: auto; display: block;
      aspect-ratio: 3 / 4; object-fit: cover; margin-bottom: 1.2rem;
    }
    .doc h3 {
      font-size: 1.35rem; font-weight: 600; margin: 0 0 0.3rem; letter-spacing: -0.02em;
    }
    .doc h3 span { font-size: 0.95rem; font-weight: 400; color: var(--ink-soft); }
    .doc-cred {
      margin: 0 0 0.9rem; font-family: var(--sans);
      font-size: 0.86rem; font-weight: 600; color: var(--accent);
    }
    .doc p { color: var(--ink-soft); line-height: 1.95; margin: 0; max-width: var(--read); }

    /* ── 06 HERBAL MEDICINE ─────────────────────────────── */
    .herbal { margin: 0 0 5.5rem; }
    .herbal h2 {
      font-size: clamp(1.4rem, 3.4vw, 1.95rem); font-weight: 600;
      letter-spacing: -0.03em; line-height: 1.5; margin: 0 0 1.3rem;
    }
    .herbal-text > p { color: var(--ink-soft); line-height: 1.95; margin: 0 0 1.6rem; max-width: var(--read); }
    .herbal-links { margin: 0; padding: 0; list-style: none; font-family: var(--sans); }
    .herbal-links li {
      padding: 0.6rem 0; border-bottom: 1px solid var(--line-soft);
      font-size: 0.96rem; color: var(--ink-soft);
    }
    .herbal-media img { width: 100%; height: auto; display: block; aspect-ratio: 3 / 4; object-fit: cover; }

    /* ── 07 SIHO SPACE — 크기를 달리합니다 ──────────────── */
    .space { margin-block: 0 5.5rem; }
    .space-grid { display: grid; gap: 1rem; }
    .space-big img { width: 100%; height: auto; display: block; aspect-ratio: 3 / 2; object-fit: cover; }
    .space-big, .space-side figure { margin: 0; }
    .space-side { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .space-side img {
      width: 100%; height: auto; display: block;
      aspect-ratio: var(--r); object-fit: cover;
    }
    .space figcaption {
      margin-top: 0.45rem; font-family: var(--sans);
      font-size: 0.84rem; color: var(--ink-soft);
    }

    /* ── 08 SIHO DISPENSARY ─────────────────────────────── */
    .dispensary {
      margin: 0 calc(50% - 50vw) 5.5rem;
      padding: 4rem max(var(--pad), calc(50vw - 38rem));
      background: var(--sunk);
    }
    .dispensary h2 {
      font-size: clamp(1.45rem, 3.6vw, 2rem); font-weight: 600;
      letter-spacing: -0.03em; margin: 0 0 1.2rem;
    }
    .disp-lead { color: var(--ink-soft); line-height: 1.95; margin: 0 0 2rem; max-width: var(--read); }
    .disp-stats { display: flex; gap: 3rem; flex-wrap: wrap; margin: 0 0 2rem; }
    .disp-stats div { margin: 0; }
    .disp-stats dt {
      font-family: var(--sans); font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.08em; color: var(--olive); margin-bottom: 0.35rem;
    }
    .disp-stats dd {
      margin: 0; font-family: var(--head);
      font-size: clamp(2.2rem, 6vw, 3rem); font-weight: 600; line-height: 1;
    }
    .disp-stats dd em { font-size: 1rem; font-style: normal; margin-left: 0.2rem; font-weight: 400; }
    .disp-stats dd.sm { font-size: 1.05rem; font-weight: 400; line-height: 1.6; }
    .disp-labels {
      margin: 0 0 1.5rem; padding: 0; list-style: none;
      max-width: 26rem; font-family: var(--sans);
    }
    .disp-labels li {
      display: flex; justify-content: space-between; gap: 1rem;
      padding: 0.55rem 0; border-bottom: 1px solid var(--line);
      font-size: 0.96rem;
    }
    .disp-labels em { font-style: normal; color: var(--ink-soft); }
    .disp-note { margin: 0; font-size: 0.9rem; color: var(--ink-soft); font-family: var(--sans); }
    .disp-media img { width: 100%; height: auto; display: block; aspect-ratio: 3 / 2; object-fit: cover; margin-top: 2.5rem; }

    /* ── 09 VISIT SIHO ──────────────────────────────────── */
    .visit { margin-block: 0 3rem; }
    .visit-grid { display: grid; gap: 2.5rem; }
    .visit h3 { font-size: 1.15rem; font-weight: 600; margin: 0 0 1rem; }
    .hours-plain { list-style: none; margin: 0 0 1rem; padding: 0; font-family: var(--sans); }
    .hours-plain li {
      display: flex; gap: 1rem; align-items: baseline;
      padding: 0.55rem 0; border-bottom: 1px solid var(--line-soft);
      font-size: 0.96rem;
    }
    .hours-plain .d { min-width: 4.5rem; font-weight: 600; }
    .hours-plain .t { color: var(--ink-soft); }
    .hours-plain em { font-style: normal; margin-left: 0.5rem; font-size: 0.88rem; }
    .addr { margin: 0 0 0.8rem; }
    .fine { font-size: 0.9rem; line-height: 1.85; color: var(--ink-soft); margin: 0 0 0.8rem; font-family: var(--sans); }
    .visit-links { font-size: 0.95rem; margin: 0 0 1.5rem; font-family: var(--sans); }
    .visit-cta { margin: 0 0 0.8rem; }
    .treat-list { margin-top: 3rem; }

    /* ── 모바일 하단 고정 예약 ──────────────────────────── */
    .book-bar { display: none; }
    @media (max-width: 46rem) {
      .book-bar {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
        display: flex; gap: 0.5rem; align-items: center;
        padding: 0.7rem var(--pad) calc(0.7rem + env(safe-area-inset-bottom, 0px));
        background: rgb(247 245 239 / 0.96);
        border-top: 1px solid var(--line);
        backdrop-filter: blur(6px);
      }
      .book-bar .cta.lg { flex: 1; text-align: center; padding: 0.85rem 1rem; }
      .book-tel {
        flex: none; padding: 0.85rem 1.1rem;
        border: 1px solid var(--line); border-radius: 999px;
        font-family: var(--sans); font-size: 0.95rem; text-decoration: none;
      }
      /* 띠 높이만큼 본문 아래를 비워 꼬리말이 가리지 않게 합니다 */
      :global(body) { padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px)); }
    }

    /* ── 넓은 화면 ──────────────────────────────────────── */
    @media (min-width: 62rem) {
      .hero {
        margin-inline: calc(50% - 50vw);
        padding-left: max(var(--pad), calc(50vw - 38rem));
        display: grid; grid-template-columns: minmax(0, 27rem) 1fr;
        gap: 3.5rem; align-items: center;
      }
      .hero-text { margin: 0; max-width: none; }
      .hero-media { margin: 0; }
      .hero-media img {
        aspect-ratio: auto; height: clamp(26rem, 72vh, 38rem);
      }
      .care-row { grid-template-columns: 1fr 1fr; gap: 3rem; }
      .care-row.flip .care-media { order: 2; }
      .care-row.no-photo { grid-template-columns: 1fr; }
      .docs-grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
      .herbal {
        margin-inline: calc(50% - 50vw);
        padding-inline: max(var(--pad), calc(50vw - 38rem));
        display: grid; grid-template-columns: 1fr 18rem; gap: 3.5rem;
        align-items: center;
      }
      .space-grid { grid-template-columns: 1.25fr 1fr; align-items: start; }
      .space-big img { aspect-ratio: 4 / 5; }
      .dispensary { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
      .disp-media img { margin-top: 0; aspect-ratio: 4 / 5; }
      .visit-grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
    }
  </style>
</Base>
