    .precision .cta.ghost {
      color: #f1efe8; border-color: #6a6c66; background: transparent;
    }
    .precision .cta.ghost:hover { border-color: #f1efe8; }
    .precision-sub {
      margin: 0; font-size: 0.94rem; line-height: 1.95; color: #b9b5ab;
      font-family: var(--sans);
    }
    .precision-sub a { color: #f1efe8; text-decoration-color: #6a6c66; }

    /* ── 05 OUR DOCTORS ─────────────────────────────────── */
    .docs { margin-block: 0 5.5rem; }
    .docs-lead { max-width: var(--read); color: var(--ink-soft); line-height: 1.95; margin: 0 0 2.5rem; }
