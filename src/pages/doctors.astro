---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

// public/images/ 에 파일을 올리면 자동으로 표시됩니다. 없으면 그 자리는 비워둡니다.
// 빌드는 프로젝트 루트에서 실행되므로 cwd 기준으로 확인합니다.
const img = (file: string) =>
  existsSync(join(process.cwd(), 'public/images', file)) ? `/images/${file}` : null;

const photoTogether = img('doctors-together.jpg');
const photoSchedule = img('schedule.jpg');

// 원장별 진료 요일 — 원장 확인 완료
const days = ['월', '화', '수', '목', '금', '토'];
const shifts = [
  { label: '오전', kim: ['화', '수', '금', '토'], park: ['월', '목', '금', '토'] },
  { label: '오후', kim: ['월', '화', '수', '금', '토'], park: ['월', '수', '목', '금', '토'] },
  { label: '야간', kim: ['월', '화', '수', '금'], park: ['월', '수', '목', '금'] },
];

const desc =
  '한방내과 전문의 김은미 대표원장과 박종규 진료원장, 한의사 2인이 진료합니다. 이력과 학회 활동, 임상연구를 소개합니다.';

// 이력·학회·논문은 원장 확인 자료 기준입니다.
// ⚠ 원장별 진료시간표는 별도 확인 후 추가합니다.
// ⚠ 박종규 원장 사진 파일이 아직 없습니다. public/images/doctor-park-jonggyu.jpg 로
//    올려주시면 카드에 표시됩니다. (public/images/doctor-2.png 은 이전 사이트의
//    다른 의료진 사진이므로 사용하지 않습니다.)

const doctors = [
  {
    id: 'kim-eunmi',
    name: '김은미',
    role: '대표원장',
    credential: '한방내과 전문의 (보건복지부)',
    photo: img('doctor-kim-eunmi.jpg'),
    career: [
      '대전대학교 한의예과 · 한의학과 졸업',
      '청연한방병원 일반수련의 / 전문수련의',
      '세명대학교 부속 제천한방병원 한방내과 전문수련의',
      '한국방송통신대학교 경영대학원 석사 (테크노경영 전공)',
      '前 대구 이웃집한의원 진료원장',
      '前 부산 경희림다한의원 진료원장',
      '네이버 지식iN 상담 한의사',
      '통증치료사관학교 8기 수료',
      '맞춤형 화장품 조제관리사',
    ],
    societies: [
      { t: '대한한방내과학회 회원', href: null },
      { t: '대한약침학회 회원', href: '/treatments/yakchim/' },
      { t: '대한통합레이저의학회 회원', href: '/skin-care/' },
      { t: '대한여한의사회 기획이사', href: null },
      { t: '부산광역시 한의사회 홍보위원', href: null },
      { t: '화성시한의사회 교의위원', href: null },
    ],
    papers: [
      '상기도기침증후군으로 의심되는 만성기침 환자에 대한 인후부 근위취혈 침치료 및 한약 온열크림 도포 경과: 증례보고',
      'Whiplash Disability Questionnaire의 한국어 번역 및 문화적 개작: 예비 연구',
      'Acute Concussion Evaluation의 한국어 번역 및 문화적 개작: 예비 연구',
      '일시적 혈압상승에 대한 황련해독탕 과립제의 효과: 증례 보고',
      '경추성 현훈 환자의 복합 한의진료 경과 및 삶의 질 변화: CARE 가이드라인에 따른 증례보고',
      '관상동맥질환으로 진단된 만성 비정형 흉통의 한의진료 경과: 증례보고',
      'Integrative traditional Korean medicine management, including acupuncture and Chuna-manual therapy, for stroke-related central facial palsy: A study of three case reports',
      '뇌동맥류 파열로 인한 지주막하 출혈 환자에서 중재적 치료 후 조절되지 않은 두통 치험 1례',
      '양격산화탕 투여와 식이요법을 병행하여 호전된 공복혈당장애 증례 보고',
      '수술 후 한의진료 환자등록 연구 — 전향적 다기관 등록연구 시험담당자',
      '입원환자 대상 한약의 안정성 평가: 다기관 전향적 관찰 임상연구 시험담당자',
    ],
    greeting: null,
  },
  {
    id: 'park-jonggyu',
    name: '박종규',
    role: '진료원장',
    credential: null,
    photo: img('doctor-park-jonggyu.jpg'),
    career: [
      '대전대학교 청주한방병원 일반수련의 수료',
      '前 명작한의원 진료원장',
      '前 분당삼성한의원 진료원장',
      '前 이현한방병원 진료원장',
    ],
    societies: [
      { t: '척추신경추나의학회 정회원', href: '/treatments/chuna/' },
      { t: '대한한방비만학회 인증 한의사', href: null },
      { t: '미국근골격계초음파사 (RMSK)', href: '/treatments/yakchim/' },
      { t: '시리악스 정형의학회 KMD 과정 수료', href: null },
      { t: 'TBT 턱관절균형요법 전문과정 수료', href: null },
      { t: '대한스포츠한의학회 팀닥터 수료', href: null },
    ],
    papers: [],
    greeting: [
      '저에게 한의원이란, 사람의 몸과 마음을 동시에 치유하는 무한한 발전 가능성을 가진 공간입니다.',
      '환자분들이 시호한의원을 통해 보다 건강한 내일을 맞이하실 수 있도록 항상 고민하고 노력하겠습니다.',
      '제가 만나는 환자분들을 닮은 따뜻한 이 공간에 방문해 주셔서 감사합니다.',
    ],
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Physician',
    name: '김은미',
    jobTitle: '대표원장',
    worksFor: { '@type': 'MedicalClinic', name: '시호한의원' },
    medicalSpecialty: '한방내과',
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: '전문의',
      name: '한방내과 전문의',
      recognizedBy: { '@type': 'GovernmentOrganization', name: '보건복지부' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Physician',
    name: '박종규',
    jobTitle: '진료원장',
    worksFor: { '@type': 'MedicalClinic', name: '시호한의원' },
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: '자격',
      name: '미국근골격계초음파사 (RMSK)',
    },
  },
];
---

<Base title="의료진 소개" description={desc} jsonLd={jsonLd}>
  <h1>의료진 소개</h1>
  <p class="lead">
    시호한의원은 한의사 2인이 진료합니다. 통증, 자율신경 관련 증상, 비염을 중심으로
    진료하며, 한 분의 환자를 두 의료진이 함께 살펴보는 협진 방식으로 진료의 연속성을
    유지합니다.
  </p>
  {photoTogether && (
    <img
      class="together"
      src={photoTogether}
      alt="시호한의원 박종규 진료원장과 김은미 대표원장 — 한의사 2인 진료, 통증·자율신경·비염"
      loading="lazy"
    />
  )}

  <section class="sec" id="schedule">
    <h2>원장별로 진료하는 요일이 어떻게 되나요?</h2>
    <p>
      두 원장의 진료 요일이 다릅니다. 특정 원장의 진료를 원하시면 아래 표를 확인하고
      내원해 주세요.
    </p>
    <div class="table-wrap">
      <table class="grid">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">구분</span></th>
            {days.map((d) => <th scope="col">{d}</th>)}
          </tr>
        </thead>
        <tbody>
          {shifts.map((sh) => (
            <>
              <tr>
                <th scope="row">김은미 · {sh.label}</th>
                {days.map((d) => (
                  <td class={sh.kim.includes(d) ? 'on' : ''}>
                    {sh.kim.includes(d) ? <span aria-label="진료">●</span> : <span aria-label="휴진">–</span>}
                  </td>
                ))}
              </tr>
              <tr class="park">
                <th scope="row">박종규 · {sh.label}</th>
                {days.map((d) => (
                  <td class={sh.park.includes(d) ? 'on' : ''}>
                    {sh.park.includes(d) ? <span aria-label="진료">●</span> : <span aria-label="휴진">–</span>}
                  </td>
                ))}
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      김은미 대표원장은 목요일, 박종규 진료원장은 화요일에 진료하지 않습니다.
      토요일은 야간진료가 없습니다. 진료시간과 점심시간은{' '}
      <a href="/contact/">오시는 길 · 예약</a>에 정리해 두었습니다.
    </p>
    {photoSchedule && (
      <img
        class="schedule-img"
        src={photoSchedule}
        alt="시호한의원 진료시간표 — 평일 09:30~20:00, 수요일 09:30~21:00, 토요일 09:30~14:00, 점심시간 12:30~14:00"
        loading="lazy"
      />
    )}
  </section>

  {doctors.map((d) => (
    <section class="doc" id={d.id}>
      <div class="head">
        {d.photo && <img src={d.photo} alt={`${d.name} ${d.role}`} width="200" height="267" loading="lazy" />}
        <div class="name">
          <h2>{d.name} <span>{d.role}</span></h2>
          {d.credential && <p class="cred">{d.credential}</p>}
        </div>
      </div>

      {d.greeting && (
        <blockquote class="greeting">
          {d.greeting.map((g) => <p>{g}</p>)}
        </blockquote>
      )}

      <h3>이력</h3>
      <ul class="plain">{d.career.map((c) => <li>{c}</li>)}</ul>

      <h3>학회 활동 · 수련</h3>
      <ul class="plain">
        {d.societies.map((s) => (
          <li>{s.href ? <a href={s.href}>{s.t}</a> : s.t}</li>
        ))}
      </ul>

      {d.papers.length > 0 && (
        <>
          <h3>임상연구 및 논문</h3>
          <ul class="papers">{d.papers.map((p) => <li>{p}</li>)}</ul>
        </>
      )}
    </section>
  ))}

  <style>
    .lead { max-width: 34rem; }

    .together {
      display: block;
      width: 100%;
      max-width: 34rem;
      height: auto;
      margin: 2rem 0 0;
      border-radius: 2px;
    }

    .sec { margin-top: 3rem; }
    .sec > p { max-width: 34rem; }
    .note { font-size: 0.94rem; color: var(--ink-soft); }

    /* 원장별 진료 요일 — 좁은 화면에서는 가로 스크롤 */
    .table-wrap {
      margin: 1.5rem 0;
      max-width: 34rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    table.grid {
      width: 100%;
      min-width: 24rem;
      border-collapse: collapse;
      font-size: 0.94rem;
      background: #fbfcfa;
    }
    table.grid th,
    table.grid td {
      padding: 0.55rem 0.5rem;
      border: 1px solid var(--line);
      text-align: center;
    }
    table.grid thead th {
      background: var(--paper);
      font-family: var(--serif);
      color: var(--accent);
    }
    table.grid tbody th {
      text-align: left;
      white-space: nowrap;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--ink-soft);
    }
    table.grid td { color: var(--line); }
    table.grid td.on { color: var(--accent); }
    table.grid tr.park tbody th { color: var(--ink-soft); }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .schedule-img {
      display: block;
      width: 100%;
      max-width: 34rem;
      height: auto;
      margin: 1.5rem 0 0;
      border: 1px solid var(--line);
      border-radius: 2px;
    }

    .doc {
      margin-top: 3.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--line);
    }
    .doc:first-of-type { border-top: none; }

    .head {
      display: flex;
      align-items: flex-end;
      gap: 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .head img {
      width: 8.5rem;
      height: auto;
      border-radius: 2px;
      background: #edf0e9;
    }
    .name { flex: 1 1 12rem; }
    .doc h2 { margin: 0; }
    .doc h2 span {
      font-family: var(--sans);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--ink-soft);
      margin-left: 0.4rem;
    }
    .cred {
      margin: 0.5rem 0 0;
      display: inline-block;
      padding: 0.25rem 0.7rem;
      background: var(--accent);
      color: var(--paper);
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 2px;
    }

    .greeting {
      margin: 0 0 1.75rem;
      padding: 1.25rem 1.25rem 1.25rem 1.4rem;
      max-width: 34rem;
      background: #f0f2ec;
      border-left: 3px solid var(--accent);
    }
    .greeting p {
      margin: 0 0 0.6rem;
      font-family: var(--serif);
      line-height: 1.7;
    }
    .greeting p:last-child { margin-bottom: 0; }

    .doc h3 { margin-top: 2rem; }
    .doc ul { max-width: 34rem; }
    .papers {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
    }
    .papers li {
      position: relative;
      padding: 0.65rem 0 0.65rem 1.2rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.94rem;
      line-height: 1.6;
      color: var(--ink-soft);
    }
    .papers li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.35rem;
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
    }

    @media (max-width: 34rem) {
      .head { gap: 1rem; }
      .head img { width: 6.5rem; }
    }
  </style>
</Base>
