---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';

const title = '동탄 체형교정 | 거북목·골반 불균형 추나 진료';
const description =
  '동탄 시호한의원 체형교정 안내. 자세와 관절 정렬을 확인하고 추나요법으로 접근하는 진료 과정을 정리했습니다.';

// 원장 검수 완료. 아이밸런스 체형 측정, 턱관절 진료와 교정기 활용,
// 운동·스트레칭 안내는 모두 원장 확인 사항입니다.
// 체형교정 패키지는 없고 X-ray는 보유하지 않아 언급하지 않습니다.
//
// ⚠ 아이밸런스 관련해 아래 두 표현은 쓰지 않았습니다.
//   - '양방 정형외과에서는 10만원 넘게 받기도 한다' → 다른 의료기관과의
//     비용 비교. 의료법 제56조 비교광고 금지에 해당합니다.
//   - '검사비용을 따로 받지 않습니다' → 비급여 검사의 무료·할인 안내는
//     환자 유인 행위로 다투어질 수 있어, '초진 진찰 과정에서 함께
//     확인합니다'라는 사실 서술로 대체했습니다.
//   ⚠ 아이밸런스의 구체적 측정 항목은 확인 전이므로 적지 않았습니다.
//
// 체형교정은 의료광고 심의에서 지적이 잦은 분야입니다. 아래는 쓰지 않았습니다.
//   - 자세 전후 비교 사진, 체형 측정 수치를 효과 근거로 제시하는 서술
//   - '교정됩니다', '똑바로 펴집니다', '키가 커집니다' 등 결과 보장
//   - '○회에', '○주 만에' 등 기간 보장
//   - 환자 후기
// 미용적 변화보다 통증과 기능 제한을 중심으로 서술했습니다.
// 검수 전까지 noindex + sitemap 제외 상태입니다.

const faqs = [
  {
    q: '체형 측정은 따로 예약해야 하나요?',
    a: [
      '따로 예약하지 않으셔도 됩니다. 초진 진찰 과정에서 아이밸런스로 체형을 확인합니다.',
      '측정 결과를 함께 보면서 지금 상태를 설명해 드리고, 치료를 이어가는 경우에는 경과를 확인할 때 다시 측정합니다.',
    ],
  },
  {
    q: '몇 번 정도 받아야 하나요?',
    a: [
      '자세와 관련된 불편은 오랜 기간 쌓여 생기는 경우가 많아, 몇 회에 정리된다고 말씀드리기 어렵습니다.',
      '진찰 후 대략적인 계획을 말씀드리고, 치료마다 움직임이 어떻게 달라졌는지 확인하면서 조정합니다.',
    ],
  },
  {
    q: '자세가 나쁘긴 한데 아프지는 않습니다. 그래도 봐야 할까요?',
    a: [
      '통증이 없다면 급하게 치료를 시작할 필요는 없습니다. 다만 어느 방향으로 움직임이 제한되어 있는지 확인해 두는 것은 도움이 됩니다.',
      '확인해 보고 지금 치료가 필요하지 않다고 판단되면 그렇게 말씀드립니다. 생활에서 무엇을 조심하면 되는지만 안내드리는 경우도 있습니다.',
    ],
  },
  {
    q: '치료를 받으면 자세가 바로 달라지나요?',
    a: [
      '치료 직후에 움직임의 범위가 달라지는 것은 확인할 수 있습니다. 다만 그 상태가 유지되는지는 다른 문제입니다.',
      '오래 앉아 있는 습관이나 일하는 자세가 그대로면 같은 부담이 다시 쌓입니다. 그래서 치료와 함께 생활에서 무엇을 조정하면 좋을지 안내합니다.',
    ],
  },
  {
    q: '추나요법은 건강보험이 적용되나요?',
    a: [
      '추나요법은 조건에 따라 건강보험이 적용됩니다.',
      '적용 범위와 횟수는 진료 시 안내해 드립니다. 자세한 내용은 전화로 문의해 주세요.',
    ],
  },
  {
    q: '아이 자세도 봐주시나요?',
    a: [
      '성장기 아이의 자세를 상담하시는 경우가 있습니다. 앉는 자세, 가방을 메는 습관, 통증이 있는지를 함께 확인합니다.',
      '아이의 경우 성장 과정에서 달라지는 부분이 있어, 지금 치료가 필요한 상태인지부터 확인한 뒤 말씀드립니다.',
    ],
  },
  {
    q: '운동을 따로 해야 하나요?',
    a: [
      '치료만으로 끝내지 않고, 어떤 움직임을 늘리고 어떤 자세를 줄이면 좋을지 안내합니다. 필요한 스트레칭 자료를 따로 보내드리기도 합니다.',
      '거창한 운동을 새로 시작하시라는 뜻은 아닙니다. 지금 하고 계신 일과 자세에서 바꿀 수 있는 부분을 먼저 찾습니다.',
    ],
  },
  {
    q: '턱이 아픈데 체형과 관련이 있을까요?',
    a: [
      '턱을 쓰는 습관은 목과 어깨의 긴장과 함께 나타나는 경우가 있어, 함께 확인하는 편이 좋습니다.',
      '박종규 진료원장이 턱관절 진료를 함께 보고 있으며, 추나 치료를 진행할 때 턱관절 교정기를 활용하기도 합니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];

const cases = [
  { t: '거북목 · 라운드 숄더', d: '목이 앞으로 나오거나 어깨가 안쪽으로 말린 자세' },
  { t: '골반 불균형', d: '한쪽으로 체중이 실리거나 다리 길이가 달라 보이는 경우' },
  { t: '좌우 비대칭', d: '한쪽 어깨가 올라가 있거나 옷이 한쪽으로 돌아가는 경우' },
  { t: '앉은 자세 부담', d: '오래 앉아 일하며 등·허리가 뻐근해지는 경우' },
  { t: '움직임 제한', d: '목을 돌리거나 허리를 젖힐 때 한쪽만 걸리는 경우' },
  { t: '턱의 불편', d: '입을 벌릴 때 소리가 나거나 한쪽으로 씹는 습관이 있는 경우' },
];

const care = [
  {
    t: '추나요법',
    d: '관절의 움직임과 정렬 상태를 확인하고 손으로 조정하는 치료입니다. 체형교정 진료의 중심이 됩니다.',
    href: '/treatments/chuna/',
  },
  {
    t: '침 · 약침',
    d: '긴장된 근육과 통증이 있는 부위를 함께 다룹니다. 부위가 깊으면 초음파를 보면서 진행합니다.',
    href: '/treatments/yakchim/',
  },
  {
    t: '도침',
    d: '오래 굳어 움직임을 제한하는 조직이 있을 때 사용합니다.',
    href: '/treatments/dochim/',
  },
  {
    t: '매선',
    d: '같은 부위가 반복해서 불편한 경우, 자극이 이어지도록 활용합니다.',
    href: '/treatments/maeseon/',
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">체형교정 · 추나</p>
    <h1>체형교정, 무엇을 확인하고 시작하나요?</h1>
    <p class="lead">
      체형은 겉으로 보이는 모양만의 문제가 아닙니다. 어느 방향으로 움직임이
      제한되어 있고 어디에 부담이 쌓이고 있는지를 함께 봐야 합니다.
    </p>
    <p>
      시호한의원은 초진 진찰 과정에서 체형 측정 장비인 아이밸런스로 체형을 확인한
      뒤, 추나요법을 중심으로 진료합니다. 지금 불편한 곳이 있다면 그 부위부터
      다룹니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>체형 상담하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>체형교정은 어떤 진료인가요?</h2>
    <p>
      자세가 한쪽으로 치우치면 그 자세를 유지하기 위해 특정 근육이 계속 일하게
      됩니다. 시간이 지나면 그 부위가 뻐근해지고, 관절이 움직이는 범위도 좁아집니다.
    </p>
    <p>
      체형교정 진료는 이 과정을 거꾸로 살펴보는 일입니다. 지금 어느 방향이 막혀
      있는지 확인하고, 그 부위의 움직임을 다루면서 통증과 기능 제한에 접근합니다.
    </p>
    <p class="statement">
      모양을 바꾸는 것이 목표가 아니라, 지금 불편한 부위의 움직임을 다루는
      진료입니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 경우에 상담하시나요?</h2>
    <div class="cards">
      {cases.map((c) => (
        <div class="card">
          <strong>{c.t}</strong>
          <span>{c.d}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>아이밸런스로 체형을 어떻게 확인하나요?</h2>
    <p>
      시호한의원은 체형 측정 장비인 <strong>아이밸런스</strong>를 갖추고 있습니다.
      초진 진찰 과정에서 이 장비로 체형을 확인합니다.
    </p>
    <p>
      눈으로 보는 것만으로는 어느 쪽으로 얼마나 치우쳐 있는지 서로 다르게 느낄 수
      있습니다. 측정 결과를 함께 보면서 지금 상태가 어떤지 설명해 드립니다.
    </p>
    <p>
      추나 치료를 진행하는 경우에는 경과를 확인할 때 같은 방식으로 다시 측정합니다.
      처음 측정한 결과와 비교하면서 변화가 있는지 함께 봅니다.
    </p>
    <p class="statement">
      말로만 설명하기보다 측정 결과를 같이 보면서 이야기하는 편이 서로 이해가
      빠릅니다.
    </p>
  </section>

  <section class="sec">
    <h2>진료는 어떤 순서로 진행되나요?</h2>
    <ol class="steps">
      <li>
        <strong>체형 측정과 자세 확인</strong>
        <span
          >아이밸런스로 체형을 측정하고, 서 있는 자세와 앉은 자세를 함께 봅니다.
          목·어깨·허리·골반이 각 방향으로 얼마나 움직이는지, 좌우 차이가 있는지
          확인합니다.</span
        >
      </li>
      <li>
        <strong>불편한 부위 확인</strong>
        <span
          >아픈 부위를 직접 눌러 확인하고, 필요하면 초음파로 해당 부위의 상태를
          살펴봅니다.</span
        >
      </li>
      <li>
        <strong>우선순위 판단</strong>
        <span
          >여러 곳이 함께 불편한 경우, 지금 가장 부담이 큰 곳부터 다룹니다. 어떤
          순서로 진행할지 말씀드립니다.</span
        >
      </li>
      <li>
        <strong>치료와 생활 안내</strong>
        <span
          >치료를 진행하고, 일하는 자세나 생활에서 조정할 수 있는 부분을 함께
          안내합니다. 필요한 운동과 스트레칭 방법도 알려드립니다.</span
        >
      </li>
      <li>
        <strong>경과 확인</strong>
        <span
          >치료를 이어가는 경우에는 아이밸런스로 다시 측정해, 처음 결과와 비교하면서
          변화가 있는지 확인합니다.</span
        >
      </li>
    </ol>
  </section>

  <section class="sec band">
    <h2>어떤 치료를 받게 되나요?</h2>
    <p>
      상태에 따라 필요한 치료를 정합니다. 한 가지만 진행하기보다 함께 진행하는
      경우가 많습니다.
    </p>
    <div class="cards">
      {care.map((c) => (
        <div class="card">
          <strong>{c.t}</strong>
          <span>{c.d}</span>
          {c.href && <a href={c.href}>자세히 보기</a>}
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>턱의 상태도 함께 확인하나요?</h2>
    <p>
      턱을 쓰는 습관은 목과 어깨의 긴장과 함께 나타나는 경우가 있습니다. 한쪽으로만
      씹거나 입을 벌릴 때 소리가 나는 경우가 여기에 해당합니다.
    </p>
    <p>
      박종규 진료원장은 TBT 턱관절균형요법 전문과정을 수료했으며, 턱관절 진료를
      함께 보고 있습니다. 추나 치료를 진행할 때 턱관절 교정기를 활용하기도 합니다.
    </p>
    <p>
      입을 벌릴 때 소리가 나거나, 한쪽으로만 씹는 습관이 있거나, 턱이 아프면서
      목·어깨도 함께 불편하신 경우에는 상담 때 말씀해 주세요. 턱의 상태를 함께
      확인한 뒤 어떻게 진행할지 안내해 드립니다.
    </p>
  </section>

  <section class="sec band">
    <h2>운동과 생활 관리는 어떻게 안내하나요?</h2>
    <p>
      치료실에서 보내는 시간보다 나머지 시간이 훨씬 깁니다. 그래서 치료만으로
      끝내지 않고 생활에서 무엇을 바꿀 수 있는지 함께 봅니다.
    </p>
    <p>
      박종규 진료원장은 어떤 근육을 어떤 방식으로 쓰면 좋을지 운동 방법을 자세히
      안내합니다. 김은미 대표원장은 필요한 스트레칭 자료를 따로 보내드리기도
      합니다.
    </p>
    <p>
      거창한 운동을 새로 시작하시라는 뜻은 아닙니다. 지금 하고 계신 일과 자세에서
      바꿀 수 있는 부분을 먼저 찾고, 그다음에 필요한 움직임을 더합니다.
    </p>
  </section>

  <section class="sec">
    <h2>누가 진료하나요?</h2>
    <p>
      박종규 진료원장은 척추신경추나의학회 정회원이며, 시리악스 정형의학회 KMD
      과정과 미국근골격계초음파사(RMSK) 자격을 취득했습니다. 대한스포츠한의학회
      팀닥터 과정도 수료했습니다.
    </p>
    <p class="note">
      두 원장의 이력과 진료 요일은 <a href="/doctors/">의료진 소개</a>에 정리해
      두었습니다. 교통사고 후 목·허리 불편으로 오시는 경우는{' '}
      <a href="/car-accident/">교통사고 한방치료 안내</a>를 참고해 주세요.
    </p>
  </section>

  <section class="sec">
    <h2>체형교정 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

