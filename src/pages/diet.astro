---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
import { dietPrograms } from '../data/diet-programs';

const title = '동탄 한방 다이어트 | 시호 다이어트 환·캡슐 안내';
const description =
  '동탄 시호한의원 한방 다이어트 안내. 환과 캡슐, 다이어트 보약의 차이와 복용 방법, 처방가를 정리했습니다.';

// 원장 검수 완료. 제품명 '시선 캡슐'은 원장 확인 사항입니다.
// 처방가는 src/data/diet-programs.ts 에서 관리합니다. 변동 시 그 파일만 수정하세요.
//
// 자료에서 아래는 반영하지 않았습니다.
//   - '엔오(NO)가 지방을 태우는 스위치를 켭니다', '백색지방을 갈색지방으로',
//     '엔오가 촉진하는 지방 연소' → 치료 효과를 보장·과장하는 서술
//   - '다이어트 환의 정석' → 최상급 표현
//   - '식욕억제 효과를 위해' → '식욕 조절을 목적으로'
//   - '추천' → '이런 분께 안내합니다'
// 체중 감량 수치, 시술 전후 비교, 환자 후기는 쓰지 않습니다.

const faqs = [
  {
    q: '마황이 들어간 약과 들어가지 않은 약 중 어느 쪽을 먹게 되나요?',
    a: [
      '진찰 후 정합니다. 평소 카페인에 예민하거나 두근거림, 불면을 쉽게 느끼는 분께는 마황이 들어가지 않은 처방을 안내합니다.',
      '심장이나 혈압 관련 질환으로 치료받고 계시거나 복용 중인 약이 있으면 반드시 말씀해 주세요. 처방을 정할 때 확인이 필요합니다.',
    ],
  },
  {
    q: '복용 중에 두근거림이나 불면이 생기면 어떻게 하나요?',
    a: [
      '복용을 멈추고 알려주세요. 전화나 카카오톡 채널로 말씀해 주시면 확인 후 안내해 드립니다.',
      '용량이나 단계를 조정하거나, 마황이 들어가지 않은 처방으로 바꾸는 방법을 함께 검토합니다.',
    ],
  },
  {
    q: '환과 캡슐 중 무엇을 고르는 것이 좋을까요?',
    a: [
      '복용 방식의 차이입니다. 캡슐은 휴대와 복용이 간편하고, 환은 복용하면서 용량과 단계를 조절하기에 편합니다.',
      '어느 쪽이든 진찰 후 상태에 맞는 처방을 정합니다. 복용 방식에 대한 선호가 있으시면 상담 때 말씀해 주세요.',
    ],
  },
  {
    q: '한 번에 얼마나 처방받게 되나요?',
    a: [
      '환과 캡슐은 1개월분씩, 다이어트 보약(탕약)은 15일분씩 준비됩니다.',
      '복용 중 경과를 확인하면서 이어갈지, 조정할지 정합니다.',
    ],
  },
  {
    q: '건강보험이 적용되나요?',
    a: [
      '다이어트 목적의 한약은 건강보험이 적용되지 않습니다.',
      '처방가는 이 페이지에 안내해 두었으며, 상담 시 다시 확인해 드립니다.',
    ],
  },
  {
    q: '한약만 먹으면 되나요?',
    a: [
      '한약만으로 진행하지 않습니다. 식사와 활동, 수면 상태를 함께 확인하고 관리 방향을 안내합니다.',
      '다이어트 집중 프로그램은 다이어트 보약과 관리를 함께 진행하는 구성입니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">한방 다이어트</p>
    <h1>시호 다이어트, 환과 캡슐 중 무엇을 선택하나요?</h1>
    <p class="lead">
      시호한의원은 환, 캡슐, 다이어트 보약(탕약)으로 다이어트 진료를 운영합니다.
      복용 형태와 구성이 다르므로, 진찰 후 지금 상태에 맞는 처방을 정합니다.
    </p>
    <p>
      마황이 들어간 처방과 들어가지 않은 처방을 모두 갖추고 있어, 카페인이나 마황에
      예민한 분도 선택하실 수 있습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>다이어트 상담하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>어떤 처방이 있나요?</h2>
    <p>
      아래는 원내에서 처방하는 다이어트 한약입니다. 처방가는 비급여 항목으로,
      의료법에 따라 고지하고 있습니다.
    </p>
    <div class="cards">
      {dietPrograms.map((p) => (
        <div class="card">
          <strong>{p.name}</strong>
          <em>{p.tag}</em>
          <span>{p.note}</span>
          <dl>
            <dt>처방가</dt>
            <dd>{p.prices.map((x) => <span class="price">{x}</span>)}</dd>
            <dt>이런 분께 안내합니다</dt>
            <dd>{p.forWhom}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>마황이 들어간 약과 들어가지 않은 약은 어떻게 다른가요?</h2>
    <p>
      마황은 한의학에서 오래 사용되어 온 약재이며, 다이어트 처방에 쓰일 때는 식욕
      조절을 목적으로 활용합니다.
    </p>
    <p>
      다만 사람에 따라 두근거림, 불면, 손떨림 같은 반응이 나타날 수 있습니다. 평소
      커피 한 잔에도 잠들기 어려운 분이나, 심장·혈압 관련 질환으로 치료받고 계신
      분께는 마황이 들어가지 않은 처방을 안내합니다.
    </p>
    <p class="statement">
      마황이 맞지 않는 분도 다이어트 진료를 받으실 수 있도록 두 가지 방향을 모두
      갖추고 있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떻게 복용하나요?</h2>
    <ul class="cases">
      <li>하루 3회, 식사 30분 전에 복용하는 것을 권해 드립니다</li>
      <li>환과 캡슐은 1개월분씩, 다이어트 보약(탕약)은 15일분씩 준비됩니다</li>
      <li>환과 캡슐은 복용하면서 용량과 단계를 조절하실 수 있습니다</li>
      <li>복용 중 불편한 점이 생기면 멈추고 알려주세요</li>
    </ul>
    <p class="note">
      복용 방법은 처방받으실 때 다시 안내해 드립니다. 복용 중 궁금한 점은{' '}
      <a href={clinic.links.kakaoChannel}>카카오톡 채널</a>이나 전화로 문의하실 수
      있습니다.
    </p>
  </section>

  <section class="sec band">
    <h2>진료는 어떻게 진행되나요?</h2>
    <ol class="steps">
      <li>
        <strong>상담과 진찰</strong>
        <span
          >체중과 체성분, 식사와 활동 습관, 수면 상태를 확인합니다. 복용 중인 약과
          치료 중인 질환도 함께 확인합니다.</span
        >
      </li>
      <li>
        <strong>처방 결정</strong>
        <span
          >마황이 들어간 처방이 적합한지, 어떤 복용 형태가 맞는지 정합니다. 지금
          다이어트 한약보다 다른 진료가 먼저라고 판단되면 그렇게 말씀드립니다.</span
        >
      </li>
      <li>
        <strong>복용과 경과 확인</strong>
        <span
          >복용 중 몸에 맞지 않는 점이 있으면 용량과 단계를 조정합니다. 식사와 활동
          관리 방향도 함께 안내합니다.</span
        >
      </li>
    </ol>
    <p class="note">
      박종규 진료원장은 대한한방비만학회 인증 한의사입니다. 이력은{' '}
      <a href="/doctors/">의료진 소개</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>다이어트 진료 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 경기 화성시 동탄신리천로 407 동탄리더스타워 2층에 있습니다.
      상태를 먼저 확인한 뒤 어떤 처방이 맞는지 말씀드립니다. 수요일은 21:00까지
      야간진료를 운영합니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>다이어트 상담하기</a>
    </p>
    <p class="cta-sub">
      전화 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a> · <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
    </p>
  </section>

  <style>
    /* 카드가 좁아도 줄바꿈이 어색하지 않게 라벨을 위, 값을 아래로 둡니다. */
    .card dl {
      margin: 0.85rem 0 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line-soft);
      font-size: 0.92rem;
    }
    .card dt {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--accent);
    }
    .card dt + dd { margin-top: 0.15rem; }
    .card dd { margin: 0 0 0.7rem; color: var(--ink-soft); }
    .card dd:last-child { margin-bottom: 0; }
    .card .price { display: block; }
  </style>
</Base>
