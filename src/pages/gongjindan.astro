---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';

const title = '동탄 목동 공진단 | 원내 직접 조제';
const description =
  '화성시 동탄구 목동 시호한의원 공진단. 사향원방공진단과 녹용두배공진단을 진찰 후 원내에서 직접 조제합니다.';

// 원장 검수 완료. 내용은 원장이 직접 확인한 것입니다.
// AI 검색이 그대로 인용할 수 있도록 답변의 첫 문장에서 바로 결론을 말합니다.
const faqs = [
  {
    q: '동탄 목동에서 공진단을 처방하는 한의원인가요?',
    a: [
      '네. 시호한의원은 경기 화성시 동탄구 목동, 동탄신리천로 407 동탄리더스타워 2층에서 사향원방공진단과 녹용두배공진단을 조제합니다.',
      '진찰을 통해 체력 저하의 양상과 소화 상태, 복용 목적을 확인한 뒤 적합한 종류와 복용량을 안내합니다.',
    ],
  },
  {
    q: '시호한의원 공진단은 원내에서 직접 만드나요?',
    a: [
      '네. 두 종류 모두 원내에서 한의사가 직접 손으로 빚어 조제합니다.',
      '완성품을 들여와 그대로 판매하는 방식이 아니라, 진찰 결과에 따라 종류와 약재 용량을 정한 뒤 조제합니다.',
    ],
  },
  {
    q: '사향원방공진단과 녹용두배공진단은 무엇이 다른가요?',
    a: [
      '사향원방공진단은 사향이 들어가는 원방 구성이고, 녹용두배공진단은 사향 대신 목향을 쓰면서 녹용을 두 배로 담은 구성입니다.',
      '어느 쪽이 적합한지는 진찰 후 현재 상태와 복용 목적을 함께 고려해 정합니다.',
    ],
  },
  {
    q: '기력이 떨어졌을 때 어떤 공진단을 선택하나요?',
    a: [
      '기력 회복을 우선에 두는 경우 녹용 함량을 높인 녹용두배공진단을 함께 고려합니다.',
      '다만 같은 피로라도 수면, 소화 상태, 스트레스 중 어디에서 비롯되었는지에 따라 방향이 달라지므로, 종류를 먼저 정하기보다 진찰 후 결정하는 편이 좋습니다.',
    ],
  },
  {
    q: '공진단은 하루에 몇 환 복용하나요?',
    a: [
      '일반적으로 하루 1환입니다. 아침 공복 복용을 권해 드립니다.',
      '환을 입안에서 천천히 녹이거나 충분히 씹어 복용한 뒤 따뜻한 물을 한 잔 마셔주세요.',
    ],
  },
  {
    q: '공진단은 꼭 아침 공복에 먹어야 하나요?',
    a: [
      '아침 공복 복용을 권장하지만 반드시 그래야 하는 것은 아닙니다.',
      '위장이 예민하거나 공복 복용이 불편하다면 식후 약 30분 뒤에 복용하도록 조절할 수 있습니다.',
    ],
  },
  {
    q: '수험생도 공진단을 복용할 수 있나요?',
    a: [
      '가능합니다. 학업량이 많아 체력 저하와 피로가 누적된 경우 상담 후 복용을 고려할 수 있습니다.',
      '다만 집중력만을 목적으로 일률적으로 복용하기보다는 수면, 비염, 소화 상태 등 공부를 방해하는 다른 문제가 있는지도 함께 살펴보는 것이 좋습니다.',
    ],
  },
  {
    q: '부모님 명절 선물로 상담할 수 있나요?',
    a: [
      '네. 추석과 설 명절에는 부모님 건강 선물로 공진단과 경옥고를 문의하시는 경우가 많습니다.',
      '단순 연령보다는 피로 양상, 소화 기능, 기존 질환과 복용약을 확인한 뒤 선택하는 것을 권해 드립니다.',
    ],
  },
  {
    q: '공진단을 한 달 이상 먹어도 되나요?',
    a: [
      '건강 상태와 복용 목적에 따라 일정 기간 지속해서 복용할 수 있습니다.',
      '장기간 복용을 계획한다면 한의사와 상담해 복용 기간을 결정하는 것이 좋습니다.',
    ],
  },
  {
    q: '복용 중인 약이 있어도 공진단을 먹을 수 있나요?',
    a: [
      '복용 중인 의약품이나 치료 중인 질환에 따라 확인이 필요합니다.',
      '상담 시 현재 복용 중인 약을 알려주세요. 함께 복용해도 되는지, 시기를 조절하는 편이 좋은지 안내해 드립니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];

// 첫 화면 요약. AI가 페이지 주제를 한눈에 잡을 수 있도록 사실만 짧게 적습니다.
const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '한의사 진찰 후 처방 — 완성품을 그대로 판매하지 않습니다',
  '사향원방공진단 · 녹용두배공진단 두 종류 운영',
  '두 종류 모두 원내에서 직접 조제',
  '기력 회복, 과로 후 회복 저하, 수험생 체력 관리 등을 상담합니다',
];

// 두 종류 공진단 비교
const kinds = [
  {
    label: '구성',
    sahyang: '녹용 · 당귀 · 산수유에 사향을 더한 원방 구성',
    nokyong: '사향 대신 목향을 쓰고 녹용을 두 배로 담은 구성',
  },
  {
    label: '특징',
    sahyang: '예로부터 전해진 원방 그대로의 배합',
    nokyong: '녹용 함량을 높여 기력·체력 보강에 무게를 둠',
  },
  {
    label: '주로 상담하는 경우',
    sahyang: '원방 구성으로 복용하고 싶은 경우',
    nokyong: '기력 회복을 우선에 두는 경우',
  },
  {
    label: '선택 기준',
    sahyang: '진찰 후 상태와 복용 목적을 함께 고려해 결정',
    nokyong: '진찰 후 상태와 복용 목적을 함께 고려해 결정',
  },
];

// 공진단 · 경옥고 비교표
const compare = [
  {
    label: '주로 고려하는 경우',
    gong: '과로, 기력·체력 저하, 중요한 일정 전후',
    gyeong: '허약, 만성적인 피로와 체력 관리',
  },
  { label: '복용 형태', gong: '환(丸)', gyeong: '고(膏)' },
  {
    label: '특징',
    gong: '휴대와 1회 복용이 편리',
    gyeong: '꾸준한 일상 건강관리에 편리',
  },
  {
    label: '문의가 많은 경우',
    gong: '시험·출장·과로·회복기 등',
    gyeong: '장기간 체력관리 · 부모님 건강관리 등',
  },
];

// 진료부터 복용까지
const steps = [
  {
    t: '진찰',
    d: '피로의 양상, 체력, 소화 상태, 수면, 스트레스, 복용 중인 약을 확인합니다.',
  },
  {
    t: '종류 결정',
    d: '사향원방공진단과 녹용두배공진단 중 어느 쪽이 맞는지, 혹은 공진단보다 다른 처방이 적합한지 함께 정합니다.',
  },
  { t: '복용량 안내', d: '하루 복용량과 복용 시점, 복용 기간을 안내합니다.' },
  {
    t: '복용 중 점검',
    d: '복용을 시작한 뒤 소화 상태나 몸의 반응을 확인해 필요하면 복용 방법을 조절합니다.',
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">한약 · 공진단</p>
    <h1>동탄 목동 공진단, 원내에서 직접 조제하는 시호한의원 공진단</h1>
    <p class="lead">
      시호한의원은 경기 화성시 동탄구 목동에서 사향원방공진단과 녹용두배공진단을
      진찰 후 원내에서 직접 조제합니다.
    </p>
    <p>
      동탄 공진단을 찾고 있다면 이름보다 먼저, 어떤 약재를 얼마나 담았는지와 지금
      내 몸에 필요한 처방인지를 확인해 보세요.
    </p>
    <ul class="hero-summary">{summary.map((s) => <li>{s}</li>)}</ul>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>공진단 상담하기</a>
    </p>
  </section>

  <section class="sec band">
    <h2>공진단이란 무엇인가요?</h2>
    <p>
      공진단은 녹용, 당귀, 산수유에 사향을 더해 환으로 빚은 한약 처방입니다. 예로부터
      기력과 원기가 떨어진 상태를 살필 때 사용해 온 처방으로, 오늘날에도 과로와
      체력 저하를 상담할 때 활용합니다.
    </p>
    <p>
      흔히 ‘피로회복제’로 불리지만 성격은 다릅니다. 누구나 같은 것을 사서 먹는
      제품이 아니라, <strong>진찰을 통해 지금 이 처방이 맞는지 판단한 뒤 쓰는
      한약</strong>입니다. 같은 피로라도 수면이 문제인 경우, 소화 기능이 떨어진
      경우, 스트레스가 오래 이어진 경우에 각각 다른 방향으로 접근합니다.
    </p>
    <p class="statement">
      그래서 시호한의원에서는 공진단을 모든 분에게 똑같이 권하지 않습니다. 현재의
      건강 상태와 복용 중인 약, 소화 기능을 확인한 뒤 공진단이 적합한지, 다른
      처방이 나은지를 먼저 말씀드립니다.
    </p>
  </section>

  <section class="sec">
    <h2>시호한의원의 두 가지 공진단</h2>
    <p>
      시호한의원에서는 사향이 들어가는 원방 구성과, 사향 대신 목향을 쓰면서 녹용을
      두 배로 담은 구성을 함께 운영합니다.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">구분</span></th>
            <th scope="col">사향원방공진단</th>
            <th scope="col">녹용두배공진단</th>
          </tr>
        </thead>
        <tbody>
          {kinds.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.sahyang}</td>
              <td>{row.nokyong}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>주요 구성 약재는 다음과 같습니다.</p>
    <ul class="herbs">
      <li>
        <strong>녹용</strong>
        <span>기력과 원기 보강을 목적으로 사용합니다. 녹용두배공진단은 이 약재를 두 배로 담습니다.</span>
      </li>
      <li>
        <strong>당귀</strong>
        <span>혈을 보하고 원활한 순환을 돕는 방향으로 배합합니다.</span>
      </li>
      <li>
        <strong>산수유</strong>
        <span
          >간신(肝腎)을 보하는 대표적인 한약재로, 체력이 쉽게 소모되는 경우 함께
          활용합니다.</span
        >
      </li>
      <li>
        <strong>사향 · 목향</strong>
        <span
          >사향원방공진단에는 사향이, 녹용두배공진단에는 목향이 들어갑니다. 두 구성의
          가장 큰 차이입니다.</span
        >
      </li>
    </ul>
  </section>

  <section class="sec band">
    <h2>시호한의원 공진단은 무엇이 다른가요?</h2>
    <p>
      <strong>한의사가 원내에서 직접 조제합니다.</strong> 두 종류 모두 원내
      탕전실에서 손으로 빚어 만들며, 진찰 결과에 따라 종류와 약재 용량을 정한 뒤
      조제합니다. 완성품을 들여와 일괄로 판매하는 방식이 아닙니다.
    </p>
    <p>
      <strong>먼저 필요한지부터 확인합니다.</strong> 공진단을 찾아오셨더라도 진찰
      결과에 따라 다른 처방을 먼저 권하거나, 지금은 복용을 미루시라고 말씀드리는
      경우도 있습니다.
    </p>
    <p>
      <strong>한방내과 전문의가 진료합니다.</strong> 김은미 대표원장은 보건복지부
      한방내과 전문의로, 한의원 및 한방병원에서 9년 이상 근무했습니다. 입원환자를
      대상으로 한 한약의 안전성 평가 다기관 임상연구에 시험담당자로 참여한 경험이
      있어, 복용 중인 약이 있거나 만성질환을 함께 살펴야 하는 경우에도 상담하실 수
      있습니다.
    </p>
    <p>
      동탄 공진단을 알아보실 때 이 세 가지 — 누가 만드는지, 먹어야 할 상태인지
      확인하는지, 누가 진료하는지 — 를 함께 보시면 판단에 도움이 됩니다.
    </p>
    <p class="note">
      두 원장의 이력과 진료 요일은{' '}
      <a href="/doctors/">의료진 소개</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>이런 분들이 상담합니다</h2>
    <ul class="cases">
      <li>충분히 쉬어도 피로가 쉽게 회복되지 않는 직장인</li>
      <li>과로와 수면 부족 뒤 회복이 더딘 분</li>
      <li>중요한 시험을 앞두고 체력과 집중력 관리가 필요한 수험생</li>
      <li>질병이나 수술, 출산 후 체력 저하를 느끼는 분</li>
      <li>노화와 함께 전반적인 기력 저하를 느끼는 분</li>
      <li>명절을 맞아 부모님이나 가족의 건강 선물을 찾는 분</li>
    </ul>
    <p class="statement">
      다만 공진단 역시 한약이므로 위 경우에 해당한다고 해서 바로 복용을 권하지는
      않습니다. 상담 대상으로 이해해 주시고, 실제 복용 여부는 진찰 후 함께
      정하시면 됩니다.
    </p>
  </section>

  <section class="sec band">
    <h2>복용과 처방은 어떻게 진행되나요?</h2>
    <p>동탄 공진단 상담은 처방을 정하기 전 진찰부터 시작합니다.</p>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </li>
      ))}
    </ol>
    <p>
      복용법은 일반적으로 하루 1환이며, 아침 공복 복용을 권해 드립니다. 환을 입안에서
      천천히 녹이거나 충분히 씹어 복용한 뒤 따뜻한 물을 한 잔 마셔주세요.
    </p>
    <p>
      소화 기능이 약하거나 공복 복용 시 불편감이 있는 경우에는 식후 약 30분 뒤에
      복용하도록 안내해 드릴 수 있습니다.
    </p>
    <p class="statement">
      복용 전에 의료진 확인이 필요한 경우가 있습니다. 임신 중이거나 수유 중인
      경우, 만성질환으로 약을 복용 중인 경우, 어린이가 복용하려는 경우에는 상담
      시 반드시 말씀해 주세요.
    </p>
  </section>

  <section class="sec">
    <h2>공진단과 경옥고, 무엇이 다른가요?</h2>
    <p>
      시호한의원에서는 공진단과 함께 경옥고에 대한 문의도 많이 받습니다. 두 처방
      모두 전통적으로 허약과 피로를 관리할 때 사용되어 왔지만, 실제 선택할 때는
      조금 다르게 접근할 수 있습니다.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">구분</span></th>
            <th scope="col">공진단</th>
            <th scope="col">경옥고</th>
          </tr>
        </thead>
        <tbody>
          {compare.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.gong}</td>
              <td>{row.gyeong}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      따라서 ‘공진단과 경옥고 중 어느 것이 더 좋은가요?’라고 비교하기보다는 현재
      가장 불편한 증상과 체력 상태에 따라 선택하는 것이 좋습니다. 동탄 공진단과
      경옥고 중 어느 쪽이 맞는지도 상담을 통해 안내해 드립니다.
    </p>
    <p class="note">
      수험생의 한약 복용 시기와 처방 선택 기준은{' '}
      <a href="/student-care/herbal-medicine/">수험생 보약 안내</a>에, 건강보험이
      적용되는 한약은 <a href="/insurance-herbs/">보험한약 안내</a>에, 그 밖의 진료
      항목은 <a href="/treatments/">진료 안내</a>에 정리해 두었습니다. 공진단은
      건강보험이 적용되지 않는 비급여 한약입니다.
    </p>
  </section>

  <section class="sec">
    <h2>공진단 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>위치와 상담</h2>
    <p>
      시호한의원은 <strong>경기도 화성시 동탄구 목동, 동탄신리천로 407
      동탄리더스타워 2층</strong>에 있습니다. 화성시 동탄구 공진단 상담은 전화나
      네이버 예약으로 문의해 주세요. 동탄 목동 공진단을 찾아 인근에서 오시는 분도
      많습니다.
    </p>
    <p>
      공진단이나 경옥고가 지금 필요한지, 필요하다면 어떤 방향이 맞는지 진찰 후
      말씀드립니다. 처음 상담을 오시는 분은 검사 및 상담 시간이 1시간 이상 소요될
      수 있어 예약 후 내원하시기를 권장드립니다. 수요일은 21:00까지 야간진료를
      운영합니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>공진단 상담하기</a>
      <a class="cta ghost" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
    </p>
    <p class="cta-sub">
      <a href={clinic.links.kakaoChannel}>카카오톡 문의</a> · <a href="/contact/">오시는 길</a>
    </p>
  </section>

  <style>
    /* 첫 화면 요약 — 사실만 짧게 나열 */
    .hero-summary {
      list-style: none;
      margin: 1.25rem 0 1.5rem;
      padding: 0;
      max-width: var(--read);
    }
    .hero-summary li {
      position: relative;
      padding-left: 1.1rem;
      margin-bottom: 0.4rem;
      color: var(--ink);
    }
    .hero-summary li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: var(--accent);
    }

    /* 약재 구성 카드 */
    .herbs {
      list-style: none;
      margin: 1.25rem 0 1.5rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      max-width: var(--read);
    }
    .herbs li {
      padding: 1rem 1.15rem;
      background: var(--surface);
      border: 1px solid var(--line-soft);
      border-radius: 6px;
    }
    .herbs strong {
      display: block;
      font-family: var(--serif);
      font-size: 1.05rem;
      color: var(--accent);
      margin-bottom: 0.2rem;
    }
    .herbs span { color: var(--ink-soft); font-size: 0.96rem; }
  </style>
</Base>
