---
import Base from '../../layouts/Base.astro';
import { clinic } from '../../data/clinic';

const title = '동탄 월경전증후군(PMS) 한의원';
const description =
  '생리 전마다 반복되는 부종, 피로, 유방통, 감정 변화. 동탄 시호한의원이 월경주기와 함께 살피는 것을 정리했습니다.';

// 원장 검수 완료 (2026-10) — 원고 그대로입니다. 아래 세 가지를 빼지 마세요.
//   1. 한약·침 치료의 근거가 제한적이라는 문장. 효과를 단정하지 않는 자리입니다.
//   2. PMS 는 첩약 건강보험 시범사업의 대상 질환이 아니라는 설명.
//      월경통만 대상입니다(src/data/chuppyak.ts 에서 확인).
//   3. PMDD 안내와 '정신건강의학과 또는 산부인과의 평가와 치료가 중요하다'는
//      문장. 심한 정서 증상을 다른 진료과로 보내는 유일한 자리입니다.
//      ⚠ 자살·자해 관련 문구는 원장 지시로 뺐습니다(2026-10). 다시 넣지 마세요.
const title2 = '월경전증후군(PMS)과 월경통은 어떻게 다를까요?';

// PMS 와 월경통 비교
const compare = [
  {
    label: '주로 나타나는 시기',
    pms: '월경 시작 약 1~2주 전',
    pain: '월경 직전부터 시작 후 1~3일',
  },
  {
    label: '주요 증상',
    pms: '부종, 피로, 유방통, 복부팽만, 기분 변화, 수면 문제',
    pain: '아랫배 통증, 허리 통증, 골반 통증',
  },
  {
    label: '특징',
    pms: '월경 시작 후 며칠 이내 완화되는 경향',
    pain: '월경 시작 무렵 통증이 심해지는 경우가 많음',
  },
  {
    label: '진료 시 확인할 점',
    pms: '증상의 주기성, 정서·신체 증상, 일상생활 영향',
    pain: '통증의 강도와 양상, 기저 부인과 질환 가능성',
  },
];

const record = [
  '월경 시작일과 종료일',
  '증상이 처음 나타난 날짜',
  '가장 심했던 증상과 정도',
  '월경 시작 후 증상이 호전된 시점',
  '수면시간과 수면의 질',
  '복통, 두통, 부종, 유방통 등 신체 증상',
  '우울감, 불안, 예민함 등 감정 변화',
  '학업·업무·일상생활에 미친 영향',
  '복용 중인 약과 기존 질환',
];

const faqs = [
  {
    q: title2,
    a: [
      'PMS 는 일반적으로 배란 이후부터 월경 전까지 나타나며, 월경이 시작되면서 증상이 완화되는 양상을 보입니다.',
      '월경통은 주로 월경 시작 전후의 통증이 중심이지만, PMS 는 통증뿐 아니라 전신 증상과 감정 변화까지 폭넓게 나타날 수 있습니다.',
    ],
  },
  {
    q: 'PMS 치료에도 건강보험이 적용되나요?',
    a: [
      'PMS 진료에서 시행되는 일부 침·뜸 치료 등은 건강보험 적용 대상이 될 수 있습니다.',
      '다만 PMS 자체는 첩약 건강보험 시범사업의 독립적인 대상 질환이 아닙니다. 월경통이 함께 있다고 해서 모든 PMS 치료나 한약 처방에 자동으로 첩약 건강보험이 적용되는 것은 아닙니다.',
      '건강보험 첩약은 정해진 대상 질환과 사업 기준에 따라 적용되므로, 실제 월경통 진단 및 급여 요건을 충족하는지 진찰 후 확인해야 합니다. 일반 맞춤 탕약은 비급여로 처방될 수 있으며, 일부 건강보험 한약제제는 처방과 급여 기준에 따라 적용될 수 있습니다.',
    ],
  },
  {
    q: '초음파로 PMS 를 진단하나요?',
    a: [
      '초음파로 PMS 자체를 진단하는 것은 아닙니다.',
      '자궁근종이나 난소 병변 등 동반 질환의 가능성을 확인하기 위한 목적으로 활용할 수 있으며, 필요한 경우 산부인과 검사를 안내합니다.',
    ],
  },
  {
    q: '내원 전에 무엇을 기록해 가면 좋을까요?',
    a: [
      '하루의 증상보다 월경주기에 따른 반복적인 변화를 확인하는 것이 중요합니다. 가능하다면 최소 두 번의 월경주기 동안 기록해 주세요.',
      '증상 일지는 PMS 와 PMDD 의 평가뿐 아니라 다른 질환과 구분하고 치료 경과를 확인하는 데도 도움이 됩니다.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <p class="crumb"><a href="/menstrual-pain/">← 월경통 · PMS 진료 안내</a></p>

  <section class="hero">
    <p class="eyebrow">월경통 · 월경전증후군</p>
    <h1>생리 전마다 몸도 마음도 힘들다면 — 동탄 월경전증후군(PMS) 진료</h1>
    <p class="lead">
      월경주기에 따라 반복되는 신체적·정서적 증상이 일상생활에 불편을 주는
      상태입니다. 단순히 생리 전 예민해지는 문제가 아닙니다.
    </p>
    <p>
      생리 시작 며칠 전부터 유독 피곤하고 몸이 붓거나, 작은 일에도 예민해지는
      경험을 하시나요? 평소에는 괜찮다가 생리 전만 되면 잠을 설치고, 식욕이
      달라지고, 배가 더부룩해지기도 합니다. 어떤 분은 가슴이 아프고 두통이
      심해지며, 어떤 분은 이유 없이 우울하거나 불안해지기도 합니다.
    </p>
    <p class="statement">
      시호한의원에서는 이러한 변화를 월경통과 별개로 떼어놓기보다 월경주기,
      수면, 소화, 피로, 스트레스 상태를 함께 살펴봅니다.
    </p>
  </section>

  <section class="sec band">
    <h2>{title2}</h2>
    <p>두 증상은 함께 나타날 수 있지만, 발생 시기와 주요 증상에 차이가 있습니다.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">구분</span></th>
            <th scope="col">월경전증후군(PMS)</th>
            <th scope="col">월경통</th>
          </tr>
        </thead>
        <tbody>
          {compare.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.pms}</td>
              <td>{row.pain}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      PMS 는 일반적으로 배란 이후부터 월경 전까지 나타나며, 월경이 시작되면서
      증상이 완화되는 양상을 보입니다. 월경통은 주로 월경 시작 전후의 통증이
      중심이지만, PMS 는 통증뿐 아니라 전신 증상과 감정 변화까지 폭넓게 나타날 수
      있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>어떤 증상으로 내원하시나요?</h2>
    <h3>몸의 변화</h3>
    <ul class="cases">
      <li>생리 전마다 얼굴이나 손발이 붓고 몸이 무거워집니다</li>
      <li>유방이 붓거나 통증이 생깁니다</li>
      <li>아랫배가 더부룩하고 가스가 찹니다</li>
      <li>두통이나 허리 통증이 반복됩니다</li>
      <li>평소보다 피로감이 심하고 무기력해집니다</li>
      <li>식욕이 증가하거나 단 음식이 당깁니다</li>
    </ul>
    <h3>수면과 감정의 변화</h3>
    <ul class="cases">
      <li>생리 전이면 유독 예민하고 짜증이 늘어납니다</li>
      <li>이유 없이 우울하거나 불안한 기분이 듭니다</li>
      <li>잠들기 어렵거나 자주 깹니다</li>
      <li>집중하기 어렵고 일상적인 일이 버겁게 느껴집니다</li>
    </ul>
    <p class="statement">
      중요한 것은 증상이 한 번 나타났는지가 아니라 월경주기에 따라 반복되고,
      월경이 시작되면 호전되는 양상이 있는지입니다.
    </p>
  </section>

  <section class="sec band">
    <h2>시호한의원에서는 무엇을 확인하나요?</h2>
    <h3>월경주기와 증상의 관계</h3>
    <p>
      월경이 규칙적인지, 증상이 월경 며칠 전부터 시작되는지, 월경 후에는 얼마나
      호전되는지 확인합니다. 월경통이나 월경량 변화, 부정출혈 등 다른 부인과
      증상이 함께 있는지도 살펴봅니다.
    </p>
    <h3>수면과 피로 상태</h3>
    <p>
      평소 수면시간, 잠드는 데 걸리는 시간, 야간각성 여부와 아침 피로감을
      확인합니다. 특히 월경 전 수면의 질이 달라지는지 함께 살펴봅니다.
    </p>
    <h3>소화와 부종</h3>
    <p>
      복부팽만, 변비나 설사, 식욕 변화, 부종 등 월경 전 악화되는 증상을
      확인합니다.
    </p>
    <h3>스트레스와 감정 변화</h3>
    <p>
      평소 스트레스 정도와 월경 전 나타나는 불안, 우울감, 예민함, 집중력 저하
      등을 확인합니다. 증상이 학업이나 직장생활, 대인관계에 어느 정도 영향을
      미치는지도 중요하게 살펴봅니다.
    </p>
    <h3>필요한 경우 추가 검사</h3>
    <p>
      심한 월경통, 비정상적인 출혈, 골반통 등 다른 부인과 질환이 의심되는
      경우에는 초음파 등 필요한 평가를 검토합니다.
    </p>
    <p class="statement">
      다만 초음파로 PMS 자체를 진단하는 것은 아닙니다. 자궁근종이나 난소 병변 등
      동반 질환의 가능성을 확인하기 위한 목적으로 활용할 수 있으며, 필요한 경우
      산부인과 검사를 안내합니다.
    </p>
  </section>

  <section class="sec">
    <h2>같은 PMS 라도 치료 방향은 다를 수 있나요?</h2>
    <p>
      누군가는 생리 전 부종과 복부팽만이 가장 힘들고, 누군가는 두통과 피로가
      심합니다. 또 어떤 분은 수면장애나 감정 변화가 가장 큰 불편함일 수 있습니다.
    </p>
    <p>
      시호한의원에서는 PMS 라는 진단명만으로 모든 환자에게 같은 처방을 적용하지
      않습니다. 월경주기와 함께 수면, 소화, 피로, 스트레스 및 동반 증상을 살펴
      개인별 치료 방향을 검토합니다.
    </p>
    <h3>한약 치료</h3>
    <p>
      증상의 양상과 전반적인 건강 상태를 고려해 개별적인 한약 처방을 검토합니다.
      PMS 에 대한 한약 치료의 효과와 안전성 근거는 처방 및 연구에 따라 차이가
      있으며, 모든 환자에서 효과가 확립된 것은 아닙니다.
    </p>
    <h3>침 치료</h3>
    <p>
      동반되는 통증이나 불편 증상에 따라 침 치료를 고려할 수 있습니다. PMS 자체에
      대한 침 치료의 근거 역시 제한적이므로 증상과 환자 선호도를 고려해
      결정합니다.
    </p>
    <h3>생활습관 관리</h3>
    <p>
      수면시간, 식사 패턴, 운동, 카페인 섭취, 스트레스 관리 등 월경 전 증상에
      영향을 줄 수 있는 생활 요인도 함께 점검합니다. 증상이 심한 경우에는
      산부인과나 정신건강의학과의 근거 기반 치료를 함께 고려합니다.
    </p>
  </section>

  <section class="sec band">
    <h2>이런 경우에는 다른 진료가 먼저 필요할 수 있나요?</h2>
    <p>
      월경 전 나타나는 증상이라고 해서 모두 PMS 로 판단해서는 안 됩니다. 다음과
      같은 경우에는 다른 질환에 대한 평가가 우선될 수 있습니다.
    </p>
    <ul class="cases">
      <li>일상생활이 어려울 정도로 우울감이나 불안이 심한 경우</li>
      <li>월경주기와 관계없이 우울·불안 증상이 지속되는 경우</li>
      <li>갑자기 심한 골반통이나 비정상적인 출혈이 발생하는 경우</li>
      <li>월경이 끝난 뒤에도 증상이 거의 호전되지 않는 경우</li>
    </ul>
    <p>
      특히 심한 정서 증상이 월경 전에 반복되고 일상 기능을 크게 떨어뜨린다면{' '}
      <strong>월경전불쾌장애(PMDD)</strong> 가능성을 평가할 필요가 있습니다. PMDD
      는 PMS 보다 정서적 증상이 두드러지고 기능 저하가 심한 상태로, 정신건강의학과
      또는 산부인과의 평가와 치료가 중요합니다.
    </p>
  </section>

  <section class="sec">
    <h2>내원 전 무엇을 기록해 오면 좋을까요?</h2>
    <p>
      월경전증후군은 하루의 증상보다 월경주기에 따른 반복적인 변화를 확인하는
      것이 중요합니다. 가능하다면 최소 두 번의 월경주기 동안 다음 내용을 기록해
      주세요.
    </p>
    <ol class="steps">{record.map((t) => <li><strong>{t}</strong></li>)}</ol>
    <p>
      증상 일지는 PMS 와 PMDD 의 평가뿐 아니라 다른 질환과 구분하고 치료 경과를
      확인하는 데도 도움이 됩니다.
    </p>
  </section>

  <section class="sec">
    <h2>월경전증후군 자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band">
    <h2>함께 보시면 좋은 안내</h2>
    <ul class="plain">
