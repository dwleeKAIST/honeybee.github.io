---
import Base from '../layouts/Base.astro';
import { clinic } from '../data/clinic';
import { img, photos } from '../lib/img';
import { getCollection } from 'astro:content';
import PromoBanner from '../components/PromoBanner.astro';
const treatments = (await getCollection('treatments')).sort(
  (a, b) => a.data.order - b.data.order,
);

// 클리닉 카드. 순서는 원장이 주로 보는 진료 순입니다.
const heroPhoto = img(photos.together);

const clinics = [
  {
    href: '/pain/',
    t: '관절 · 근육 통증',
    d: '어깨, 목·허리, 무릎, 손목, 발. 초음파로 부위를 확인하고 침·약침·도침·추나로 진료합니다.',
  },
  {
    href: '/autonomic/',
    t: '자율신경 · 번아웃',
    d: '불면, 어지럼, 두근거림, 이명, 공황·불안. 검사에서 이상이 없는데 불편이 이어지는 경우.',
  },
  {
    href: '/digestion/',
    t: '속편안 클리닉',
    d: '기능성 소화불량, 역류 증상, 잘 체함, 과민한 장. 온열순환치료와 첩약 건강보험.',
  },
  {
    href: '/rhinitis/',
    t: '코편안 클리닉',
    d: '코막힘, 콧물, 알레르기비염, 코골이. 비내시경으로 코 안을 직접 확인합니다.',
  },
  {
    href: '/car-accident/',
    t: '교통사고 한방치료',
    d: '자동차보험 접수부터 진단서 발급까지. 평일 야간까지 통원하실 수 있습니다.',
  },
  {
    href: '/posture/',
    t: '체형교정',
    d: '거북목, 골반 불균형, 턱관절. 아이밸런스로 체형을 측정하고 추나로 접근합니다.',
  },
  {
    href: '/menstrual-pain/',
    t: '월경통 · PMS',
    d: '매달 반복되는 월경 통증과 월경 전 증후군. 첩약 건강보험이 적용됩니다.',
  },
  {
    href: '/menopause/',
    t: '갱년기 클리닉',
    d: '안면홍조, 불면, 감정 기복. 요실금 등 비뇨생식기 증상과 남성 갱년기도 함께.',
  },
  {
    href: '/student-care/',
    t: '수험생 클리닉',
    d: '비염, 소화, 수면과 체력, 통증. 공부를 방해하는 문제부터 살펴봅니다.',
  },
  {
    href: '/skin-care/',
    t: '피부미용',
    d: '리프팅, 색소 치료, 스킨부스터, 필링과 안면매선. 원내 장비를 정리해 두었습니다.',
  },
];
---

<Base title={clinic.slogan} description={clinic.metaDescription}>
  <PromoBanner />
  <section class={`hero home-hero${heroPhoto ? ' has-photo' : ''}`}>
    <div class="hero-text">
      <p class="eyebrow">경기 화성시 동탄구 목동 · 통증과 내과질환을 함께 보는 한의원</p>
      <h1>몸이 보내는 신호를 읽고,<br class="br-wide" />회복의 방향을 찾습니다.</h1>
      <p class="lead">
        한방내과 전문의를 포함한 두 한의사가 통증부터 자율신경, 비염과 소화
        문제까지 함께 살핍니다.
      </p>
      <p class="lead lead-soft">
        오늘의 불편을 덜어내는 것을 넘어,<br />더 건강한 일상으로 이어지는
        진료를 합니다.
      </p>
      <p class="cta-row">
        <a class="cta" href={clinic.links.naverBooking}>네이버 예약</a>
        <a class="cta ghost" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
      </p>
      <p class="cta-sub">
        <a href={clinic.links.kakaoChannel}>카카오톡 문의</a> · <a href="/contact/">오시는 길</a> · <a href="/doctors/">의료진 소개</a>
      </p>
    </div>
    {heroPhoto && (
      <img
        class="hero-photo"
        src={heroPhoto}
        alt="시호한의원 박종규 진료원장과 김은미 대표원장 — 한의사 2인 진료"
        loading="eager"
      />
    )}
  </section>

  <section class="sec">
    <h2>어떤 진료를 찾으시나요?</h2>
    <div class="cards home-cards">
      {clinics.map((c) => (
        <a class="card link-card" href={c.href}>
          <strong>{c.t}</strong>
          <span>{c.d}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sec band">
    <h2>진료시간은 어떻게 되나요?</h2>
    <ul class="hours">
      {clinic.hours.map((h) => (
        <li>
          <strong>{h.days}</strong>
          <span>
            {h.open}–{h.close}
            {h.lunch && ` · 점심 ${h.lunch}`}
            {h.note && ` · ${h.note}`}
          </span>
        </li>
      ))}
      <li><strong>일요일</strong><span>휴진</span></li>
    </ul>
    <p class="note">
      {clinic.closedDays}. {clinic.lastReception} 원장별 진료 요일은{' '}
      <a href="/doctors/#schedule">의료진 소개</a>에서 확인하실 수 있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>치료 항목은 무엇이 있나요?</h2>
    <ul class="plain">
      {treatments.map((t) => (
        <li>
          <a href={`/treatments/${t.id}/`}>{t.data.title}</a>
          <span class="summary">{t.data.summary}</span>
        </li>
      ))}
    </ul>
    <p class="note">
      건강보험이 적용되는 한약은 <a href="/insurance-herbs/">보험한약 안내</a>에,
      자주 받는 질문은 <a href="/faq/">자주 묻는 질문</a>에 정리해 두었습니다.
    </p>
  </section>

  <!-- 공진단은 클리닉 카드가 아니라 한약이라 별도 블록으로 둡니다.
       홈에서 전용 페이지로 가는 텍스트 링크 역할도 합니다. -->
  <section class="sec">
    <h2>기력이 떨어졌을 때 — 공진단</h2>
    <p>
      쉬어도 피로가 풀리지 않거나 과로 뒤 회복이 더딜 때 상담하는 한약입니다.
      시호한의원은 경기 화성시 동탄구 목동에서 <strong>사향원방공진단</strong>과
      녹용을 두 배로 담은 <strong>녹용두배공진단</strong>을 운영하며, 두 종류 모두
      원내에서 한의사가 직접 조제합니다. 완성품을 그대로 판매하지 않고 진찰을 통해
      지금 필요한 처방인지부터 확인합니다.
    </p>
    <p class="note">
      두 종류의 구성과 선택 기준, 복용법은{' '}
      <a href="/gongjindan/">동탄 목동 공진단 안내</a>에 정리해 두었습니다.
    </p>
  </section>

  <section class="sec band closing">
    <h2>예약과 문의</h2>
    <p>
      {clinic.address.full}에 있습니다. 예약 없이도 진료가 가능하지만, 초진 상담이나
      한약 상담은 시간이 조금 더 필요하니 미리 예약하고 오시는 편이 좋습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>네이버 예약</a>
      <a class="cta ghost" href={`tel:${clinic.phone}`}>전화 {clinic.phone}</a>
    </p>
    <p class="cta-sub">
      휴진 일정은 <a href={clinic.links.naverBooking}>네이버 예약창</a>에서 확인하실
      수 있습니다.
    </p>
  </section>

  <style>
    .home-hero { padding-bottom: 0.5rem; }
    .home-hero h1 { font-size: 2.15rem; }
    .home-hero .lead { max-width: 32rem; }
    /* 두 문단이 이어지므로 뒤 문단은 한 톤 낮춰 읽는 리듬을 만듭니다. */
    .home-hero .lead-soft { color: var(--ink-soft); }

    /* 2열로 갈라지는 폭에서는 글 칸이 좁아 제목이 네 줄로 흩어집니다.
       강제 줄바꿈을 풀고 글자를 한 단계 줄여 두 줄로 앉힙니다. */
    @media (max-width: 58rem) {
      .home-hero .br-wide { display: none; }
      .home-hero h1 { text-wrap: balance; }
    }
    @media (min-width: 46rem) and (max-width: 58rem) {
      .home-hero h1 { font-size: 1.8rem; }
    }

    /* 사진이 있으면 2열, 없으면 텍스트만 그대로 */
    .home-hero.has-photo { display: grid; gap: 1.75rem; align-items: center; }
    .hero-photo {
      display: block; width: 100%; height: auto;
      border-radius: 10px; background: var(--sunk);
    }
    @media (min-width: 46rem) {
      .home-hero.has-photo { grid-template-columns: 1.05fr 0.95fr; gap: 2.25rem; }
      .home-hero.has-photo .hero-text { padding-bottom: 0.5rem; }
    }

    /* 카드 전체를 링크로 */
    .link-card { display: block; text-decoration: none; }
    .link-card strong { text-decoration: none; }
    .link-card span { color: var(--ink-soft); }
    .link-card:hover strong { color: var(--accent-ink); }

    /* 진료시간 목록 — clinic.ts에서 생성 */
    .hours { list-style: none; margin: 1.25rem 0; padding: 0; max-width: var(--read); }
    .hours li {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.75rem;
      align-items: baseline;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .hours strong { min-width: 5rem; }
    .hours span { color: var(--ink-soft); font-size: 0.96rem; }

    @media (max-width: 34rem) {
      .home-hero h1 { font-size: 1.75rem; }
    }
  </style>
</Base>
