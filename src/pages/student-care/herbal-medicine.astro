---
import Base from '../../layouts/Base.astro';
import { clinic } from '../../data/clinic';

const title = '동탄 수험생 보약 | 총명탕·공진단 차이와 복용 시기';
// ⚠ 첫 문장이 /student-care/ 의 설명과 똑같았습니다(두 페이지가 검색결과에
// 같은 설명으로 나왔습니다). 이 페이지는 '보약'을, /student-care/ 는
// '수험생 클리닉 전반'을 맡도록 서로 다르게 씁니다.
const description =
  '동탄 시호한의원 수험생 보약 안내. 총명탕·공진단·맞춤 탕약의 차이와 복용 시기, 무엇을 기준으로 처방을 정하는지 정리했습니다.';

// 첫 화면 요약. AI가 페이지 주제를 한눈에 잡을 수 있도록 사실만 짧게 적습니다.
const summary = [
  '경기 화성시 동탄구 목동, 동탄리더스타워 2층',
  '정해진 하나의 수험생 보약을 일률적으로 처방하지 않습니다',
  '총명탕 · 공진단 · 맞춤 탕약 가운데 상태에 맞는 것을 선택',
  '수면 · 비염 · 소화 · 체력 · 목어깨 통증을 함께 확인한 뒤 처방',
  '맞춤 한약은 원내 탕전실에서 직접 조제합니다',
];

// 원장 검수 완료. 답변 내용은 원장이 직접 확인한 것입니다.
// 진료 안내 페이지의 FAQ는 진료 범위, 이 페이지는 한약 복용에 관한 것입니다.
const faqs = [
  {
    q: '수험생 보약은 꼭 먹여야 하나요?',
    a: [
      '모든 학생에게 한약이 필요한 것은 아닙니다. 필요하지 않다고 보이면 그렇게 말씀드립니다.',
      '보약이 꼭 필요하지 않은 경우에는 원하시는 부분에 맞춰 총명탕이나 녹용경옥고처럼 간단한 처방으로 보강하거나, 필요한 상비약만 처방해 드리기도 합니다.',
      '한약 대신 침 치료나 추나치료로 대체하는 경우도 있습니다. 무엇이 필요한지는 진찰을 통해 판단합니다.',
    ],
  },
  {
    q: '수능 몇 달 전부터 한약을 먹나요?',
    a: [
      '몇 달 전이라고 정해진 시기는 없습니다. 지금 학생을 가장 불편하게 하는 문제가 무엇인지에 따라 달라집니다.',
      '비염, 소화불량, 수면 문제처럼 증상이 있는 경우에는 그 증상이 나타나는 시기에 맞춰 시작하는 편이고, 체력 보충이 주된 목적이라면 학습량이 늘어나는 시기 이전에 상담하시는 경우가 많습니다.',
      '시험이 임박한 시기에 시작해도 됩니다. 다만 그때는 현재 컨디션을 유지하는 데 초점을 두게 됩니다. 복용 중 몸에 맞지 않는 점이 있을 때 조정할 시간이 필요하므로, 가능하면 시험 일정에 여유를 두고 상담해 주시기를 권해 드립니다.',
    ],
  },
  {
    q: '비염이나 수면, 소화 문제도 같이 봐주시나요?',
    a: [
      '네. 오히려 그런 문제가 있다면 채우는 것보다 그 문제를 먼저 다루는 편이 나을 수 있습니다.',
      '밤에 코가 막혀 자주 깨거나, 식후에 유난히 졸리고 더부룩하거나, 시험기간마다 복통·설사가 생기거나, 목·어깨·허리가 아파 오래 앉아 있기 힘든 경우가 여기에 해당합니다. 매달 월경통으로 공부의 흐름이 끊기는 경우도 마찬가지입니다.',
      '잠을 제대로 자지 못해 피곤한 학생과 소화가 좋지 않아 처지는 학생은 각각 필요한 방향이 다릅니다. 그래서 처방 이름을 먼저 정하지 않고, 진찰로 지금 상태를 확인한 뒤 필요한 처방을 정합니다.',
    ],
  },
  {
    q: '시험 직전에 시작해도 되나요?',
    a: [
      '가능합니다. 다만 시작 시점에 따라 진료의 목표를 다르게 잡습니다.',
      '시간에 여유가 있으면 불편한 증상을 먼저 다루고 체력을 보충하는 순서로 진행할 수 있지만, 시험이 임박한 시기에는 현재 컨디션을 유지하는 데 초점을 두는 편입니다.',
      '복용 중 몸에 맞지 않는 점이 있을 때 조정할 시간이 필요하므로, 가능하면 시험 일정에 여유를 두고 상담해 주시기를 권해 드립니다.',
    ],
  },
  {
    q: '총명탕과 맞춤 보약은 무엇이 다른가요?',
    a: [
      '총명탕은 한의학에서 오래 사용되어 온 처방의 이름이고, 맞춤 보약은 학생의 상태에 맞추어 약재 구성과 용량을 조절해 짜는 방식입니다.',
      '어느 쪽이 더 좋다고 말씀드리기는 어렵습니다. 잠을 제대로 자지 못해 피곤한 학생과 소화가 좋지 않아 처지는 학생, 비염 때문에 불편한 학생은 각각 필요한 방향이 다릅니다.',
      '그래서 처방 이름을 먼저 정하지 않고, 진찰로 지금 상태를 확인한 뒤 필요한 처방을 정합니다.',
    ],
  },
  {
    q: '공진단과 수험생 보약은 어떻게 다른가요?',
    a: [
      '공진단은 일정한 처방 구성을 환(丸)으로 만들어 복용하는 방식이고, 탕약은 개별 상태에 따라 약재 구성과 용량을 더 세밀하게 조절하는 방식입니다.',
      '공진단도 진찰 없이 정해지는 것은 아닙니다. 진찰 후 학생의 상태와 복용 목적을 고려해 어느 쪽이 적합한지 판단합니다. 두 가지를 함께 쓰는 경우도 있습니다.',
      '공진단의 약재 구성과 경옥고와의 차이는 공진단·경옥고 안내에 따로 정리해 두었습니다.',
    ],
  },
  {
    q: '목·어깨 통증도 함께 진료할 수 있나요?',
    a: [
      '네. 하루 대부분을 책상 앞에서 보내는 학생에게 목과 어깨의 불편은 수험생활 내내 반복되는 문제가 될 수 있습니다.',
      '침 치료와 추나치료를 함께 진행하고, 증상과 진찰 결과에 따라 초음파로 부위를 확인한 뒤 도침이나 초음파 유도하 약침치료를 고려하기도 합니다.',
      '한약과 함께 볼지, 통증부터 다룰지는 지금 무엇이 더 공부를 방해하고 있는지에 따라 정합니다.',
    ],
  },
  {
    q: '중학생이나 고등학생도 복용할 수 있나요?',
    a: [
      '네. 중·고등학생 모두 진료하며 학년이나 연령으로 제한을 두지 않습니다. 복용량과 제형은 학생의 나이와 몸무게, 지금 증상에 맞추어 조절합니다.',
      '아이가 한약을 잘 못 먹는 경우에도 용량을 농축하거나 제형을 바꾸는 등 조정할 방법이 있습니다. 상담할 때 미리 말씀해 주세요.',
    ],
  },
  {
    q: '한 번 처방받으면 얼마나 복용하나요?',
    a: [
      '학생의 상태와 목적에 따라 다릅니다. 특정 증상을 다루는 경우와 전반적인 컨디션을 보충하는 경우의 기간이 같지 않습니다.',
      '복용 기간은 진찰 후 정하며, 복용 중 경과를 확인해 조정합니다.',
    ],
  },
  {
    q: '학기 중에도 복용할 수 있나요?',
    a: [
      '네. 학기 중에 복용하는 학생이 많습니다. 기숙사 학교 중에는 한약을 보관할 냉장고를 따로 두는 곳도 있습니다.',
      '주말에 내원해 상담하거나, 전화로 증상을 확인한 뒤 처방받아 기숙사에서 복용하는 학생도 있습니다.',
      '시호한의원의 한약은 대부분 하루 두 번 아침과 저녁에 복용하며, 식사 여부와 관계없이 복용할 수 있습니다. 일정이 빠듯한 학기 중에도 복용을 이어가기 어렵지 않습니다.',
    ],
  },
  {
    q: '복용 중인 영양제나 다른 약이 있어도 괜찮나요?',
    a: [
      '비타민 등 건강기능식품이나 다른 약을 함께 드시는 경우, 병행해도 되는지 안내해 드립니다.',
      '예를 들어 한약 복용 중 감기로 항생제를 처방받으셨다면 처방전을 카카오톡 채널로 보내주세요. 확인 후 한약 복용을 잠시 멈출지 이어갈지 말씀드립니다.',
      '복용 중 궁금한 점이 생기면 언제든 문의하실 수 있습니다.',
    ],
  },
  {
    q: '아이가 한약을 잘 못 먹는데 방법이 있나요?',
    a: [
      '복용을 힘들어하는 학생을 위해 여러 방법으로 조정합니다. 용량을 농축해 한 번에 먹는 양을 줄이거나 제형을 바꿀 수 있습니다.',
      '처방을 구성할 때 약재의 향과 맛도 함께 고려합니다. 한약 전용 효소로 맛을 부드럽게 하거나 천연당을 더해 쓴맛이 덜 느껴지도록 조정하기도 합니다.',
      '비위가 약한 학생도 조정을 거치면 복용을 이어가는 경우가 대부분입니다. 시작 전이든 복용 중이든 어려워한다면 말씀해 주세요.',
    ],
  },
];

const faqLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={faqLd}>
  <section class="hero">
    <p class="eyebrow">수험생 클리닉 · 한약</p>
    <h1>동탄 수험생 보약, 공부를 방해하는 몸의 문제부터 살펴봅니다</h1>
    <p class="lead">
      무엇을 더 채울 것인가보다, 공부를 방해하는 것이 무엇인지 먼저 봅니다.
    </p>
    <p>
      잠을 충분히 자도 피곤한 학생, 비염 때문에 책상 앞에서 계속 코를 훌쩍이는
      학생, 긴장하면 배가 아프거나 소화가 잘 되지 않는 학생, 목과 어깨가 자주
      뻐근해 오래 앉아 있기 힘든 학생. 같은 ‘수험생 보약’을 찾더라도 필요한
      치료는 모두 같지 않습니다.
    </p>
    <p>
      시호한의원은 경기 화성시 동탄구 목동에서 학생의 상태를 먼저 살펴본 뒤,
      총명탕과 공진단, 맞춤 탕약 가운데 지금 필요한 것을 정합니다.
    </p>
    <ul class="hero-summary">{summary.map((x) => <li>{x}</li>)}</ul>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>수험생 한약 상담하기</a>
      <a class="cta ghost" href="/student-care/">수험생 클리닉 안내</a>
    </p>
  </section>

  <section class="sec">
    <h2>수험생 보약이란 무엇을 말하나요?</h2>
    <p>
      ‘보약’은 부족한 것을 채우는 방향의 한약을 가리키는 말로 널리 쓰입니다.
      체력이 떨어진 학생에게 필요한 치료인 것은 맞습니다.
    </p>
    <p>
      다만 수험생에게 필요한 것이 늘 채우는 쪽만은 아닙니다. 밤새 코가 막혀
      제대로 자지 못하는 학생, 식사할 때마다 속이 불편한 학생에게는 채우는 것보다
      그 문제를 먼저 다루는 편이 나은 경우가 있습니다.
    </p>
    <p class="statement">
      그래서 시호한의원에서는 ‘수험생 보약’이라는 이름보다 그 학생의 현재 몸 상태를
      먼저 봅니다.
    </p>
  </section>

  <section class="sec band">
    <h2>언제부터 먹이는 것이 좋을까요?</h2>
    <p>
      정해진 시기는 없습니다. 지금 학생을 가장 불편하게 하는 문제가 무엇인지에
      따라 달라집니다.
    </p>
    <p>
      비염, 소화불량, 수면 문제처럼 증상이 있는 경우에는 그 증상이 나타나는 시기에
      맞춰 진료를 시작하는 편입니다. 체력 보충이 주된 목적이라면 학습량이 늘어나는
      시기 이전에 상담하시는 경우가 많습니다.
    </p>
    <p>복용 기간과 시작 시점은 학생의 상태와 시험 일정을 함께 고려하여 정합니다.</p>

    <h2>시험이 임박했는데 지금 시작해도 될까요?</h2>
    <p>가능합니다. 다만 시작 시점에 따라 진료의 목표를 다르게 잡습니다.</p>
    <p>
      시간에 여유가 있으면 불편한 증상을 먼저 다루고 체력을 보충하는 순서로 진행할
      수 있지만, 시험이 임박한 시기에는 현재 컨디션을 유지하는 데 초점을 두는
      편입니다.
    </p>
    <p>
      복용 중 몸에 맞지 않는 점이 있을 때 조정할 시간이 필요하므로, 가능하면 시험
      일정에 여유를 두고 상담해 주시기를 권해 드립니다.
    </p>
  </section>

  <section class="sec">
    <h2>총명탕이면 되나요?</h2>
    <p>
      총명탕은 한의학에서 오래 사용되어 온 처방 중 하나입니다. 다만 모든 학생에게
      같은 처방이 필요한 것은 아닙니다.
    </p>
    <p>
      잠을 제대로 자지 못해 피곤한 학생과, 소화가 좋지 않아 처지는 학생, 비염 때문에
      불편한 학생은 각각 필요한 방향이 다릅니다.
    </p>
    <p>
      시호한의원에서는 처방 이름을 먼저 정하기보다, 진찰을 통해 학생의 현재 상태를
      확인한 뒤 필요한 처방을 결정합니다.
    </p>

    <h2>공진단과 탕약은 어떻게 다른가요?</h2>
    <p>
      공진단은 일정한 처방 구성을 바탕으로 제형화하여 복용하는 방식이고, 탕약은
      개별 상태에 따라 약재 구성과 용량을 보다 세밀하게 조절하는 방식입니다.
    </p>
    <p>
      공진단도 진찰 없이 정해지는 것은 아닙니다. 진찰 후 학생의 상태와 복용 목적
      등을 고려하여, 사향이 들어간 원방 공진단과 목향을 활용한 공진단 가운데 어느
      쪽이 적합한지 판단합니다.
    </p>
    <p>
      두 가지 모두 원내에서 직접 손으로 빚어 조제합니다. 목향 공진단은 사향이
      들어가지 않는 대신 녹용 함량을 두 배로 넣은 녹용두배공진단으로도 처방하고
      있습니다.
    </p>
    <p>
      공진단의 약재 구성과 경옥고와의 차이는{' '}
      <a href="/gongjindan/">공진단·경옥고 안내</a>에 따로 정리해 두었습니다.
    </p>

    <h2>한약을 먹으면 졸리지 않나요?</h2>
    <p>수험생 한약은 낮 시간의 학습을 방해하지 않도록 구성을 고려하여 처방합니다.</p>
    <p>
      수면을 돕는 방향의 처방이 필요한 경우에는 복용 시간을 저녁으로 조정하는 등
      복용 방법을 함께 안내해 드립니다. 복용 중 졸음이나 그 밖에 불편한 점이 있으면
      알려주세요. 확인 후 조정합니다.
    </p>
  </section>

  <section class="sec band">
    <h2>이런 경우에는 보약보다 먼저 살펴봅니다</h2>
    <p>
      아래에 해당한다면 채우는 것보다 그 문제를 먼저 다루는 편이 나을 수 있습니다.
    </p>
    <ul class="cases">
      <li>밤에 코가 막혀 자주 깨거나 아침에 개운하지 않다</li>
      <li>식후에 유난히 졸리고 더부룩하다</li>
      <li>시험기간만 되면 복통이나 설사가 생긴다</li>
      <li>목·어깨·허리가 아파 오래 앉아 있기 힘들다</li>
      <li>매달 월경통으로 공부의 흐름이 끊긴다</li>
    </ul>
    <p>
      각 문제를 어떻게 살펴보는지는{' '}
      <a href="/student-care/">수험생 클리닉 안내</a>에 정리해 두었습니다. 코
      증상은 <a href="/rhinitis/">비염 진료 안내</a>, 오래 앉아 있기 힘든 목·어깨
      문제는 <a href="/posture/">체형교정 안내</a>에 더 자세히 적어 두었습니다.
    </p>
  </section>

  <section class="sec">
    <h2>시호한의원은 이렇게 처방합니다</h2>
    <ol class="steps">
      <li>
        <strong>진찰</strong>
        <span
          >체질과 체력, 수면, 소화, 비염, 통증, 스트레스, 월경 상태를 함께
          살펴봅니다.</span
        >
      </li>
      <li>
        <strong>우선순위 판단</strong>
        <span
          >그중 지금 이 학생의 수험생활을 가장 많이 방해하고 있는 문제가 무엇인지
          정합니다.</span
        >
      </li>
      <li>
        <strong>처방</strong>
        <span
          >정해진 ‘수험생 보약’을 일률적으로 처방하기보다 현재 학생에게 필요한
          방향을 고려하여 개별적으로 처방합니다.</span
        >
      </li>
    </ol>
    <p>
      필요한 경우 비내시경으로 코 상태를 확인하거나 초음파로 통증 부위를 살펴본 뒤
      침·추나 치료를 함께 진행하기도 합니다. 맞춤 한약은 원내 탕전실에서 직접
      조제합니다.
    </p>
    <p class="note">
      건강보험이 적용되는 한약도 있습니다. 처방 목록은{' '}
      <a href="/insurance-herbs/">보험한약 안내</a>에, 약재를 개별로 구성해 달인
      맞춤 한약(첩약)에 건강보험이 적용되는 여섯 개 질환은{' '}
      <a href="/chuppyak/">첩약 건강보험 안내</a>에 정리해 두었습니다.
      알레르기비염과 월경통이 그중에 있어, 그 증상으로 오는 학생은 건강보험으로
      맞춤 한약을 처방받을 수 있습니다.
    </p>
  </section>

  <section class="sec">
    <h2>자주 묻는 질문</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer">{f.a.map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="sec band closing">
    <h2>상담과 예약</h2>
    <p>
      시호한의원은 경기 화성시 동탄구 목동, 동탄신리천로 407 동탄리더스타워 2층에 있습니다.
      학생의 상태를 먼저 살펴본 뒤 한약이 필요한지, 필요하다면 어떤 방향이 맞는지
      말씀드립니다. {clinic.firstVisitNote} 수요일은 21:00까지 야간진료를
      운영하여 학원 일정 뒤에도 내원하실 수 있습니다.
    </p>
    <p class="cta-row">
      <a class="cta" href={clinic.links.naverBooking}>수험생 한약 상담하기</a>
    </p>
    <p class="cta-sub">
      전화 <a href={`tel:${clinic.phone}`}>{clinic.phone}</a> · <a href={clinic.links.kakaoChannel}>카카오톡 문의</a>
    </p>
  </section>

  <style>
    /* 수험생 클리닉 페이지와 같은 토큰·리듬을 씁니다. */
    .hero,
    .sec {
      --surface: #fbfcfa;
      --sunk: #edf0e9;
    }
    .sec { margin-top: 3.5rem; }
    .sec > p { max-width: 34rem; margin: 0 0 1rem; }
    .sec > p:last-child { margin-bottom: 0; }
    .sec h2 + p { margin-top: 0; }

    .band {
      margin-inline: -1.25rem;
      padding: 2.25rem 1.25rem 2.5rem;
      background: var(--sunk);
    }
    .band > h2:first-child { margin-top: 0; }

    .hero { margin-bottom: 1rem; }
    .eyebrow {
      margin: 0 0 0.75rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--accent);
    }
    .hero .lead { margin: 0 0 1rem; }

    .cta-row { margin: 1.75rem 0 0.75rem; }
    .cta {
      display: inline-block;
      padding: 0.75rem 1.6rem;
      background: var(--accent);
      color: var(--paper);
      font-weight: 600;
      text-decoration: none;
      border-radius: 2px;
      transition: background-color 0.15s ease;
    }
    .cta:hover { background: #7d561a; color: var(--paper); }
    .cta-sub { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
    .cta-sub a { color: var(--ink-soft); }
    .cta-sub a:hover { color: var(--accent); }

    .statement {
      max-width: 34rem;
      margin: 1.75rem 0 0;
      padding-left: 1.1rem;
      border-left: 3px solid var(--accent);
      font-family: var(--serif);
      font-size: 1.12rem;
      line-height: 1.65;
    }

    .cases {
      list-style: none;
      margin: 1.25rem 0 1.5rem;
      padding: 0;
      max-width: 34rem;
    }
    .cases li {
      position: relative;
      padding: 0.7rem 0 0.7rem 1.2rem;
      border-bottom: 1px solid var(--line);
    }
    .cases li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.45rem;
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
    }

    .steps {
      list-style: none;
      counter-reset: step;
      margin: 1.5rem 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-width: 34rem;
    }
    .steps li {
      counter-increment: step;
      position: relative;
      padding: 1.1rem 1.15rem 1.1rem 3rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 2px;
    }
    .steps li::before {
      content: counter(step);
      position: absolute;
      left: 1.15rem;
      top: 1.05rem;
      font-family: var(--serif);
      font-weight: 700;
      color: var(--accent);
    }
    .steps strong {
      display: block;
      font-family: var(--serif);
      font-size: 1.05rem;
      margin-bottom: 0.2rem;
    }
    .steps span { color: var(--ink-soft); font-size: 0.96rem; }

    /* FAQ 아코디언 — JS 없이 details/summary */
    .faq { margin-top: 1.5rem; border-top: 1px solid var(--line); }
    .faq details { border-bottom: 1px solid var(--line); }
    .faq summary {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 1rem 0;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after {
      content: '+';
      flex: none;
      color: var(--accent);
      font-weight: 400;
      font-size: 1.2rem;
      line-height: 1;
    }
    .faq details[open] summary::after { content: '−'; }
    .faq summary:hover { color: var(--accent); }
    .faq .answer { padding: 0 0 1.1rem; max-width: 34rem; }
    .faq .answer p {
      margin: 0 0 0.7rem;
      font-size: 0.96rem;
      color: var(--ink-soft);
    }
    .faq .answer p:last-child { margin-bottom: 0; }

    .closing { margin-top: 4rem; }

    @media (max-width: 34rem) {
      .statement { font-size: 1.05rem; }
      .steps li { padding: 1rem 1rem 1rem 2.7rem; }
    }
  </style>
</Base>
