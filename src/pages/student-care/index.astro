---
import Base from '../../layouts/Base.astro';
import { clinic } from '../../data/clinic';
import { pages } from '../../data/links';
import { img, photos } from '../../lib/img';

// 그림이 있으면 해당 항목 아래에 표시합니다. 파일이 없으면 자리를 비웁니다.
const menstrualFigure = img(photos.menstrualMechanism);

// Base 레이아웃이 `{title} | 시호한의원`으로 조합하므로 뒤쪽 브랜드명은 넣지 않습니다.
const title = '동탄 수험생 한의원 | 비염·소화·수면·체력·통증 맞춤진료';
// 검색결과 표시를 고려해 80자 이내로 작성 (네이버 권고)
const description =
  '수험생 보약에 정해진 하나의 처방은 없습니다. 비염·소화·수면·통증을 먼저 살피는 동탄 시호한의원 수험생 클리닉.';

// 카드 → 같은 페이지 안의 상세 섹션 anchor. 상세 페이지는 아직 만들지 않습니다.
const problems = [
  { id: 'rhinitis', title: '비염·코막힘', desc: '코막힘 · 콧물 · 후비루' },
  { id: 'digestion', title: '소화불량', desc: '식후 졸림 · 더부룩함 · 가스' },
  { id: 'sleep', title: '수면·체력', desc: '피로 · 불면 · 아침 기상 어려움' },
  { id: 'pain', title: '목·허리 통증', desc: '목 · 어깨 · 허리 불편' },
  { id: 'menstrual', title: '월경통·PMS', desc: '생리 때마다 떨어지는 컨디션' },
  { id: 'skin', title: '여드름·피부', desc: '시험기간 심해지는 피부 트러블' },
];

// 상세 영역. body는 증상 설명, care는 시호한의원의 진료 방식.
const details = [
  {
    id: 'rhinitis',
    title: '비염·코막힘',
