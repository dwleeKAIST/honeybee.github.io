---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const treatments = (await getCollection('treatments')).sort((a, b) => a.data.order - b.data.order);
const desc = '시호한의원의 진료 항목 안내 — 추나, 도침, 약침, 매선, 맞춤 클리닉.';
---
<Base title="진료 안내" description={desc}>
  <h1>진료 안내</h1>
  <ul class="plain">
    {treatments.map((t) => (
      <li>
        <a href={`/treatments/${t.id}/`}>{t.data.title}</a>
        <span class="summary">{t.data.summary}</span>
      </li>
    ))}
  </ul>

  <h2>자율신경 관련 증상으로 오셨나요?</h2>
  <ul class="plain">
    <li>
      <a href="/autonomic/">자율신경 · 번아웃 진료 안내</a>
      <span class="summary">불면, 어지럼, 두근거림, 이명, 공황·불안, 기능성 소화불량. 원내 스트레스·혈압·혈액검사.</span>
    </li>
  </ul>

  <h2>체형교정 진료를 찾으시나요?</h2>
  <ul class="plain">
    <li>
      <a href="/posture/">체형교정 · 추나 진료 안내</a>
      <span class="summary">아이밸런스 체형 측정, 거북목·골반 불균형·턱관절, 운동과 생활 관리 안내.</span>
    </li>
  </ul>

  <h2>다이어트 진료를 찾으시나요?</h2>
  <ul class="plain">
    <li>
      <a href="/diet/">한방 다이어트 · 환과 캡슐 안내</a>
      <span class="summary">환·캡슐·다이어트 보약의 차이, 마황 유무에 따른 선택, 복용 방법과 처방가.</span>
    </li>
  </ul>

  <h2>피부미용 진료는 어떤 안내가 있나요?</h2>
  <ul class="plain">
    <li>
      <a href="/skin-care/">피부미용 · 시술과 장비 안내</a>
      <span class="summary">리프팅, 색소 치료, 스킨부스터, 필링과 원내 보유 장비.</span>
    </li>
    <li>
      <a href="/facial-maeseon/">안면매선</a>
      <span class="summary">팔자주름 부위를 비롯한 얼굴 매선의 시술 방식과 진행 과정.</span>
    </li>
  </ul>

  <h2>교통사고 진료를 찾으시나요?</h2>
  <ul class="plain">
    <li>
      <a href="/car-accident/">교통사고 한방치료 · 자동차보험 안내</a>
      <span class="summary">자동차보험 접수 절차, 진료 항목, 진단서 발급, 평일 야간 통원 진료.</span>
    </li>
  </ul>

  <h2>한약은 어떤 안내가 있나요?</h2>
  <ul class="plain">
    <li>
      <a href="/insurance-herbs/">보험한약 안내</a>
      <span class="summary">건강보험이 적용되는 한약제제 목록과 이용 방법.</span>
    </li>
    <li>
      <a href="/gongjindan/">공진단 · 경옥고 안내</a>
      <span class="summary">녹용두배공진단의 약재 구성, 복용 방법, 경옥고와의 차이.</span>
    </li>
    <li>
      <a href="/student-care/herbal-medicine/">수험생 보약 안내</a>
      <span class="summary">복용 시기와 총명탕·공진단·맞춤 탕약의 차이, 처방 기준.</span>
    </li>
  </ul>
</Base>
