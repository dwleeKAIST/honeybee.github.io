---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const treatments = (await getCollection('treatments')).sort((a, b) => a.data.order - b.data.order);
const desc = '시호한의원의 진료 항목 안내 — 추나, 도침, 약침, 매선, 맞춤 클리닉.';
---
<Base title="진료 안내" description={desc}>
  <h1>진료 안내</h1>
  <ul class="plain">
    {treatments.map((t) => (
      <li>
        <a href={`/treatments/${t.id}/`}>{t.data.title}</a>
        <span class="summary">{t.data.summary}</span>
      </li>
    ))}
  </ul>

  <h2>한약은 어떤 안내가 있나요?</h2>
  <ul class="plain">
    <li>
      <a href="/insurance-herbs/">보험한약 안내</a>
      <span class="summary">건강보험이 적용되는 한약제제 목록과 이용 방법.</span>
    </li>
    <li>
      <a href="/gongjindan/">공진단 · 경옥고 안내</a>
      <span class="summary">녹용두배공진단의 약재 구성, 복용 방법, 경옥고와의 차이.</span>
    </li>
    <li>
      <a href="/student-care/herbal-medicine/">수험생 보약 안내</a>
      <span class="summary">복용 시기와 총명탕·공진단·맞춤 탕약의 차이, 처방 기준.</span>
    </li>
  </ul>
</Base>
