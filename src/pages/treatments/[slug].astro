---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const treatments = await getCollection('treatments');
  return treatments.map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
  <hr class="rule" />
  <p><a href="/treatments/">← 진료 안내 목록</a> · <a href="/faq/">자주 묻는 질문</a></p>
</Base>
